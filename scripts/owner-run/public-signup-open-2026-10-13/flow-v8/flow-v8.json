{
 "version": "6.3",
 "data_api_version": "3.0",
 "routing_model": {
  "WELCOME": [
   "PROVISIONING",
   "ERROR"
  ],
  "PROVISIONING": [
   "ERROR"
  ],
  "ERROR": []
 },
 "screens": [
  {
   "id": "WELCOME",
   "title": "Your free number",
   "data": {
    "trial_line": {
     "type": "string",
     "__example__": "Free for 7 days - 60 minutes to Dominica"
    },
    "scope_text": {
     "type": "string",
     "__example__": "Outgoing calls to Dominica are free for your 7-day trial, up to 60 minutes. Incoming calls work too. Paid plans and top-ups aren't available yet."
    },
    "fine_print": {
     "type": "string",
     "__example__": "Voice calling only - no SMS or emergency calls. Tapping the button starts your free trial on this WhatsApp number."
    }
   },
   "layout": {
    "type": "SingleColumnLayout",
    "children": [
     {
      "type": "Image",
      "src": "",
      "width": 220,
      "height": 110,
      "aspect-ratio": 2,
      "scale-type": "contain",
      "alt-text": "Flag of Dominica"
     },
     {
      "type": "TextHeading",
      "text": "🇩🇲 Your free Dominica number"
     },
     {
      "type": "TextSubheading",
      "text": "${data.trial_line}"
     },
     {
      "type": "TextBody",
      "markdown": true,
      "text": "✅ A real **+1 767** number\n\n✅ Calls to Dominica - **free**\n\n✅ Set up in about a minute\n\n✅ Uses the free **Cloud Softphone** app"
     },
     {
      "type": "TextBody",
      "text": "${data.scope_text}"
     },
     {
      "type": "TextInput",
      "name": "first_name",
      "label": "Your first name",
      "helper-text": "Optional",
      "required": false,
      "input-type": "text"
     },
     {
      "type": "TextCaption",
      "text": "${data.fine_print}"
     },
     {
      "type": "Footer",
      "label": "Get my free number",
      "on-click-action": {
       "name": "data_exchange",
       "payload": {
        "first_name": "${form.first_name}",
        "confirm": "yes"
       }
      }
     }
    ]
   }
  },
  {
   "id": "PROVISIONING",
   "title": "Creating your number",
   "data": {
    "provisioning_text": {
     "type": "string",
     "__example__": "Almost there - this takes a few seconds. Tap Check again."
    }
   },
   "layout": {
    "type": "SingleColumnLayout",
    "children": [
     {
      "type": "Image",
      "src": "",
      "width": 220,
      "height": 110,
      "aspect-ratio": 2,
      "scale-type": "contain",
      "alt-text": "Flag of Dominica"
     },
     {
      "type": "TextHeading",
      "text": "⏳ Creating your number…"
     },
     {
      "type": "TextBody",
      "text": "${data.provisioning_text}"
     },
     {
      "type": "Footer",
      "label": "Check again",
      "on-click-action": {
       "name": "data_exchange",
       "payload": {
        "step": "check"
       }
      }
     }
    ]
   }
  },
  {
   "id": "ERROR",
   "title": "Something went wrong",
   "terminal": true,
   "success": false,
   "data": {
    "error_text": {
     "type": "string",
     "__example__": "We could not set up your line right now. Please reply in the chat and a person will help."
    }
   },
   "layout": {
    "type": "SingleColumnLayout",
    "children": [
     {
      "type": "TextHeading",
      "text": "😕 We hit a snag"
     },
     {
      "type": "TextBody",
      "text": "${data.error_text}"
     },
     {
      "type": "Footer",
      "label": "Close",
      "on-click-action": {
       "name": "complete",
       "payload": {
        "status": "error"
       }
      }
     }
    ]
   }
  }
 ]
}