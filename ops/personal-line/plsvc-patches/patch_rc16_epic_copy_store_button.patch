+// ── Personal Line: Cloud Softphone store button (rc16) ────────────────────────
+// A documented interactive Call-to-Action URL button message ("Interactive Call-to-Action URL Button Messages",
+// developers.facebook.com/documentation/business-messaging/whatsapp/messages/interactive-cta-url-messages):
+//   interactive.type 'cta_url'; header optional (text <= 60 chars); body.text required (<= 1024); footer.text optional (<= 60);
+//   action.name 'cta_url'; action.parameters.display_text required (<= 20 chars); action.parameters.url required.
+// A Flow cannot open a URL from a button, so the real store button is this separate message, sent beside the INSTALL_STORE screen.
+export const PL_STORE_FALLBACK_URLS = {
+  ios: 'https://apps.apple.com/us/app/cloud-softphone/id567475545',
+  android: 'https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone',
+} as const
+/** Only an https URL on the official store host is put behind the button; anything else falls back to the official listing. */
+export function plStoreUrl(os: 'ios' | 'android', candidate?: unknown): string {
+  const host = os === 'ios' ? 'apps.apple.com' : 'play.google.com'
+  if (typeof candidate === 'string') {
+    try { const u = new URL(candidate); if (u.protocol === 'https:' && u.hostname === host) return u.toString() } catch { /* fall back */ }
+  }
+  return PL_STORE_FALLBACK_URLS[os]
+}
+export function buildPlStoreButtonPayload(toPhone: string, os: 'ios' | 'android', url?: unknown): Record<string, any> {
+  const ios = os === 'ios'
+  const store = ios ? 'the App Store' : 'Google Play'
+  const back = 'After installing, come back to this chat and tap the setup form above to continue - on iPhone tap ◀ WhatsApp at the top left, on Android press Back.'
+  return {
+    messaging_product: 'whatsapp',
+    recipient_type: 'individual',
+    to: toPhone,
+    type: 'interactive',
+    interactive: {
+      type: 'cta_url',
+      header: { type: 'text', text: 'Install Cloud Softphone (free)'.slice(0, 60) },
+      body: { text: `Tap the button below to open ${store} and install Cloud Softphone - the free app you make calls from with your EPIC line.\n\n${back}`.slice(0, 1024) },
+      footer: { text: 'EPIC Personal Line'.slice(0, 60) },
+      action: { name: 'cta_url', parameters: { display_text: (ios ? 'Open App Store' : 'Open Google Play').slice(0, 20), url: plStoreUrl(os, url) } },
+    },
+  }
+}
+/**
+ * Same gate/dispatch as sendPlSignupFlow, same sender rule: PL_FLOW_SENDER_PHONE_ID with NO fallback (never 3742). The caller supplies
+ * the provenance (userId + the signed Flow session) and does the per-sender/per-OS/24 h de-duplication (storeButtonForFlow).
+ */
+export async function sendPlStoreButton(toPhone: string, os: 'ios' | 'android', url: unknown, ctx: Partial<WaSendContext>): Promise<GateDecision> {
+  const phoneId = process.env.PL_FLOW_SENDER_PHONE_ID || ''
+  if (!phoneId) throw new Error('PL_FLOW_SENDER_PHONE_ID not configured')
+  const sendCtx: WaSendContext = {
+    purpose: ctx.purpose ?? 'lite_onboarding',
+    senderPath: ctx.senderPath ?? 'pl:flows/store-button',
+    kind: 'interactive',
+    recipientPhone: toPhone,
+    userId: ctx.userId,
+    agentId: ctx.agentId,
+    sourceEventType: ctx.sourceEventType,
+    sourceEventId: ctx.sourceEventId,
+    sourceMessageId: ctx.sourceMessageId,
+  }
+  const decision = await dispatchToMeta(buildPlStoreButtonPayload(toPhone, os, url), phoneId, sendCtx)
+  if (!decision.code.startsWith('allow_')) console.warn(`[whatsapp][gate] ${decision.code} - sendPlStoreButton suppressed: ${decision.reason}`)
+  else if (decision.duplicate) console.log('[whatsapp] PL store button: duplicate (idempotency key) - not re-sent')
+  else if (decision.dispatchFailed) console.error('[whatsapp] sendPlStoreButton dispatch failed')
+  else console.log('[whatsapp] PL store button sent via', phoneId)
+  return decision
+}
