+// rc16: the real Cloud Softphone store button for a Flow session at the INSTALL -> store step (signup-flow.ts fireStoreButton).
+// At most ONE per verified sender per OS per 24 h: an atomic claim row in pl_concierge_audit (endpoint 'flows/store-button', op = os)
+// decides, so Flow re-taps, Meta endpoint retries and new Flow sessions inside the window send nothing. A send that is refused or fails
+// is re-coded store_button_failed (not counted), so a later tap can try again. Identity = the wa_id inside the SERVER-signed flow_token
+// (the same identity every Flow step uses); the gate's PL verified-inbound carve-out applies because the token is only minted by
+// flows/launch in reply to a relay-verified inbound and lives 1 h, inside that inbound's 24 h service window. The send goes through
+// dispatchToMeta (wa-send-gate: suppression/STOP, audit, idempotency key userId:...:flow:<n>:...:store-button:<os>).
+export const STORE_BUTTON_WINDOW_S = 24 * 3600          // DE-DUPLICATION window only: one store button per sender per OS per 24 h
+export const STORE_BUTTON_TOKEN_MAX_AGE_S = 3600 + 60   // the signed flow_token's life (1 h) + clock skew: the proof must be this fresh
+export const SERVICE_WINDOW_S = 24 * 3600 - 300         // WhatsApp customer-service window (24 h from the customer's last inbound), 5 min margin
+// TWO INDEPENDENT CONDITIONS, BOTH REQUIRED (PM rule 2026-10-11): (1) ELIGIBILITY - proof fresh, line bound, customer's 24 h service window
+// open, no STOP; (2) DE-DUPLICATION - no claim in the last 24 h. Passing one never bypasses the other. Eligibility is checked BEFORE the
+// claim, so a refusal for window/STOP/proof never consumes the once-per-24h allowance; every refusal is audited under its own code
+// (store_button_window_closed / _window_unknown / _stopped / _proof_stale / _deduped / store_button_failed) so they are distinguishable.
+// rc16g (owner decision 2026-10-11, "route via adapter first"): human ownership of the Chatwoot conversation, the adapter's own STOP
+// preference, consent and the REAL 24 h window (Chatwoot's last incoming message) live in the PL adapter, which sits next to Chatwoot.
+// After the local checks above and BEFORE the claim, this service asks the adapter (eligibility.ts, POST /v1/eligibility, signed) and
+// sends only on eligible=true. Any other answer - human_owned / stopped / window_closed, or anything that cannot be established
+// (window_unknown, consent_unknown, no_conversation, unavailable, timeout, not configured) - refuses under its own audit code and does
+// NOT spend the claim. The local checks stay as defence in depth; the adapter answer can only remove eligibility, never add it.
+export type StoreButtonCode = 'store_button_sent' | 'store_button_deduped' | 'store_button_window_closed' | 'store_button_window_unknown' | 'store_button_stopped' | 'store_button_human_owned' | 'store_button_eligibility_unavailable' | 'store_button_proof_stale' | 'store_button_failed' | 'service_disabled' | 'invalid_body'
+export interface StoreButtonResult { code: StoreButtonCode; detail?: string }
+export async function storeButtonForFlow(args: { waId: string; rid: string; flowNonce: string; iat: number; os: 'ios' | 'android'; url: string }): Promise<StoreButtonResult> {
+  const t0 = Date.now()
+  if (args.os !== 'ios' && args.os !== 'android') return { code: 'invalid_body' }
+  const cfg = readConfig(process.env)
+  const hashKey = auditHashKey(cfg)
+  if (cfg.misconfig.length > 0 || !hashKey) return { code: 'service_disabled' }
+  const waIdHash = store.idHash(hashKey, args.waId)
+  const mid = `flow:${args.flowNonce}`
+  const refuse = async (code: StoreButtonCode, detail: string): Promise<StoreButtonResult> => {
+    // a distinguishable audit row, in a code OUTSIDE the claim's countCodes (a refusal never counts as a send or a claim)
+    await store.writeAudit({ endpoint: 'flows/store-button', op: args.os, httpStatus: 200, code, detail: detail.slice(0, 200), kid: 'flow', pnid: null, rid: args.rid, mid, waIdHash, waLast4: args.waId.slice(-4), latencyMs: Date.now() - t0 })
+      .catch((e: any) => console.error(`[pl-concierge] store-button refusal audit failed: ${e?.message}`))
+    return { code, detail }
+  }
+  // (1a) proof: the server-signed flow_token was verified by the Flow endpoint (signature, purpose, expiry); re-assert its age here.
+  const nowS = Math.floor(Date.now() / 1000)
+  if (!Number.isFinite(args.iat) || args.iat <= 0 || nowS - args.iat > STORE_BUTTON_TOKEN_MAX_AGE_S || args.iat - nowS > 60) return await refuse('store_button_proof_stale', 'flow_token_age')
+  // (1b) the customer's WhatsApp service window, from THEIR last relay-verified inbound. A token minted in an earlier reply is NOT a substitute.
+  let lastIn: Date | null
+  try { lastIn = await store.lastVerifiedInboundAt(waIdHash) } catch (e: any) { return await refuse('store_button_window_unknown', `read_error:${String(e?.name ?? 'error').slice(0, 40)}`) }
+  if (!lastIn || !Number.isFinite(lastIn.getTime())) return await refuse('store_button_window_unknown', 'no_inbound_on_record')
+  if (Date.now() - lastIn.getTime() > SERVICE_WINDOW_S * 1000) return await refuse('store_button_window_closed', 'last_inbound_older_than_24h')
+  // (1c) the line binding and the estate STOP stores (the gate re-checks STOP at send time; checking here keeps the claim unspent).
+  let userId: string
+  try {
+    const b: any = await resolveExistingBinding(args.waId)
+    if (b?.kind !== 'existing' || !b.userId) return await refuse('store_button_failed', 'no_line_binding')
+    userId = b.userId
+    const phones = [args.waId, `+${args.waId}`]
+    const [dnc, revoked] = await Promise.all([
+      prisma.contact.findFirst({ where: { userId, phone: { in: phones }, doNotContact: true }, select: { id: true } }),
+      prisma.whatsappOptIn.findFirst({ where: { userId, phone: { in: phones }, status: 'revoked' }, select: { id: true } }),
+    ])
+    if (dnc || revoked) return await refuse('store_button_stopped', 'estate_suppressed')
+  } catch (e: any) {
+    return await refuse('store_button_failed', `eligibility_unreadable:${String(e?.name ?? 'error').slice(0, 40)}`)   // unreadable -> fail closed
+  }
+  // (1d) the authoritative adapter consult (ownership, adapter STOP, real window, consent), fail closed, short timeout, no retry.
+  const el = await askAdapterEligibility({ waId: args.waId, ref: args.rid })
+  if (!el.eligible) {
+    const detail = `adapter:${el.reason}${el.detail ? `:${el.detail}` : ''}`
+    if (el.reason === 'human_owned') return await refuse('store_button_human_owned', detail)
+    if (el.reason === 'stopped') return await refuse('store_button_stopped', detail)
+    if (el.reason === 'window_closed') return await refuse('store_button_window_closed', detail)
+    return await refuse('store_button_eligibility_unavailable', detail)   // window_unknown / consent_unknown / no_conversation / unavailable / not_configured / adapter_error
+  }
+  // (2) de-duplication: atomic claim. Only reached when every eligibility condition holds.
+  const claimId = await store.claimOncePerWindow({
+    endpoint: 'flows/store-button', op: args.os, waIdHash, windowS: STORE_BUTTON_WINDOW_S,
+    claimCode: 'store_button_claimed', countCodes: ['store_button_claimed', 'store_button_sent'], rid: args.rid, mid, waLast4: args.waId.slice(-4),
+  })
+  if (!claimId) return await refuse('store_button_deduped', 'already sent or in flight for this sender + os within 24 h')
+  const fail = async (detail: string): Promise<StoreButtonResult> => {
+    await store.finishClaim(claimId, 'store_button_failed', 'failed', detail.slice(0, 200), Date.now() - t0).catch((e: any) => console.error(`[pl-concierge] store-button finish failed: ${e?.message}`))
+    return { code: 'store_button_failed', detail }
+  }
+  try {
+    const { sendPlStoreButton } = await import('@/app/lib/whatsapp')
+    const d: any = await sendPlStoreButton(args.waId, args.os, args.url, {
+      userId, senderPath: 'pl:flows/store-button', sourceEventType: 'pl_verified_inbound', sourceEventId: mid, sourceMessageId: `store-button:${args.os}`,
+    })
+    const code = String(d?.code ?? 'no_decision')
+    if (!code.startsWith('allow_') || d?.duplicate || d?.dispatchFailed) return await fail(`${code}${d?.duplicate ? ':duplicate' : ''}${d?.dispatchFailed ? `:dispatch_failed:${d?.errorCode ?? ''}` : ''}`)
+    await store.finishClaim(claimId, 'store_button_sent', 'done', code, Date.now() - t0)
+    return { code: 'store_button_sent', detail: code }
+  } catch (e: any) {
+    return await fail(`error:${String(e?.message ?? e).replace(/\s+/g, ' ').trim().slice(0, 160)}`)
+  }
+}
