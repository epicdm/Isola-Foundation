+/**
+ * rc16e gate review: what the 'pl_verified_inbound' carve-out in wa-send-gate.ts lets through for the store-button path, tested
+ * against the REAL evaluateWaSend (only prisma is mocked). Every refusal has its positive twin in the same harness (CLAUDE.md 2.19).
+ *
+ * Also the proof side: a forged / expired / wrong-purpose flow_token is refused by verifyFlowToken (the Flow endpoint calls it before
+ * anything else), and the recipient of the store button is the token's own wa, never a request field.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const S = vi.hoisted(() => ({ rows: [] as any[], stopped: false }))
+vi.mock('@/app/lib/runtime-flags', () => ({ getRuntimeFlag: () => false, getRuntimeNumber: (_k: string, d: number) => d, getRuntimeList: (_k: string, d: string[]) => d }))
+vi.mock('@/app/lib/prisma', () => ({
+  prisma: {
+    waSendAudit: {
+      create: vi.fn(async ({ data }: any) => { const row = { id: `a${S.rows.length + 1}`, ...data }; S.rows.push(row); return row }),
+      findUnique: vi.fn(async ({ where }: any) => S.rows.find(r => r.idempotencyKey === where.idempotencyKey) ?? null),
+      update: vi.fn(async () => ({})), count: vi.fn(async () => 0),
+    },
+    liteAccount: { findUnique: vi.fn(async () => ({ ownerPhone: null })) },
+    contact: { findFirst: vi.fn(async () => (S.stopped ? { id: 'c1' } : null)) },
+    whatsappOptIn: { findFirst: vi.fn(async () => null) },
+    waTemplateRecord: { findFirst: vi.fn(async () => null), findUnique: vi.fn(async () => null) },
+  },
+}))
+
+import { evaluateWaSend, isPlVerifiedInboundReply } from '@/app/lib/wa-send-gate'
+import { mintFlowToken, verifyFlowToken } from '@/app/lib/pl-concierge/flow-token'
+
+const good = (over: Record<string, unknown> = {}) => ({
+  purpose: 'lite_onboarding', senderPath: 'pl:flows/store-button', kind: 'interactive', recipientPhone: '17675550101', userId: 'u1',
+  sourceEventType: 'pl_verified_inbound', sourceEventId: 'flow:n1', sourceMessageId: 'store-button:ios', fromPhoneId: '111111111111111', ...over,
+}) as any
+
+beforeEach(() => { S.rows = []; S.stopped = false })
+
+describe('gate: the exact store-button shape is exempt; nothing else on that path is', () => {
+  it('TWIN: the exact shape (tenant, interactive, lite_onboarding, flow:<n>, store-button:<os>) is allowed and audited', async () => {
+    const d = await evaluateWaSend(good())
+    expect(d.code).toBe('allow_service_message')
+    expect(S.rows.at(-1)).toMatchObject({ decision: 'allow_service_message', senderPath: 'pl:flows/store-button', sourceEventType: 'pl_verified_inbound' })
+    expect(isPlVerifiedInboundReply(good())).toBe(true)
+  })
+  it.each([
+    ['arbitrary message ref', { sourceMessageId: 'anything' }],
+    ['missing message ref', { sourceMessageId: undefined }],
+    ['unknown os in the ref', { sourceMessageId: 'store-button:windows' }],
+    ['event id not a Flow session', { sourceEventId: 'wamid.HBg' }],
+    ['no tenant', { userId: undefined }],
+    ['freeform text instead of the interactive button', { kind: 'freeform' }],
+    ['a template send', { kind: 'template', templateName: 't' }],
+    ['a Flow send', { kind: 'flow' }],
+    ['another purpose', { purpose: 'support_reply' }],
+    ['a proactive purpose', { purpose: 'campaign' }],
+  ])('refused (not exempt): %s', async (_n, over) => {
+    expect(isPlVerifiedInboundReply(good(over))).toBe(false)
+    const d = await evaluateWaSend(good(over))
+    expect(d.code.startsWith('allow_')).toBe(false)
+  })
+  it('a different senderPath / sourceEventType cannot reach the exemption with this payload shape', async () => {
+    for (const over of [{ senderPath: 'app:other' }, { senderPath: 'whatsapp:x' }, { sourceEventType: 'wa_inbound_fake' }, { sourceEventType: 'pl_verified' }, { sourceEventType: undefined }]) {
+      expect(isPlVerifiedInboundReply(good(over))).toBe(false)
+      expect((await evaluateWaSend(good(over))).code.startsWith('allow_')).toBe(false)
+    }
+  })
+  it('CONTROL: other pl: paths are exactly as before (launch Flow send still exempt) - the gate is unchanged for them', async () => {
+    expect(isPlVerifiedInboundReply(good({ senderPath: 'pl:flows/launch', kind: 'flow', sourceEventId: 'wamid.X', sourceMessageId: undefined }))).toBe(true)
+    expect((await evaluateWaSend(good({ senderPath: 'pl:flows/launch', kind: 'flow', sourceEventId: 'wamid.X', sourceMessageId: undefined }))).code).toBe('allow_service_message')
+  })
+  it('STOP outranks the exemption: doNotContact -> suppress; TWIN: not stopped -> allowed', async () => {
+    S.stopped = true
+    expect((await evaluateWaSend(good())).code).toBe('suppress')
+    S.stopped = false; S.rows = []
+    expect((await evaluateWaSend(good())).code).toBe('allow_service_message')
+  })
+  it('replay: the same Flow session + os is deduped by the gate idempotency key (second evaluation is duplicate, same decision, no new row)', async () => {
+    const first = await evaluateWaSend(good())
+    const again = await evaluateWaSend(good())
+    expect(first.duplicate).toBeUndefined(); expect(again.duplicate).toBe(true); expect(S.rows).toHaveLength(1)
+    const other = await evaluateWaSend(good({ sourceEventId: 'flow:n2' }))     // TWIN: a different session is a fresh evaluation
+    expect(other.duplicate).toBeUndefined(); expect(S.rows).toHaveLength(2)
+  })
+})
+
+describe('proof: the signed flow_token', () => {
+  const KEY = 'k'.repeat(48)
+  beforeEach(() => { process.env.PL_ASSERTION_HMAC_KEY = KEY })
+  it('TWIN: a freshly minted signup token verifies and carries the wa it was minted for', () => {
+    const t = mintFlowToken({ purpose: 'signup', waId: '17675550101', rid: 'r1' })
+    const v = verifyFlowToken(t, 'signup'); expect(v.ok).toBe(true)
+    if (v.ok) expect(v.claims.wa).toBe('17675550101')
+  })
+  it('FORGED (signed with another key) -> bad_signature', () => {
+    const t = mintFlowToken({ purpose: 'signup', waId: '17675550101', rid: 'r1' })
+    process.env.PL_ASSERTION_HMAC_KEY = 'z'.repeat(48)
+    expect(verifyFlowToken(t, 'signup')).toMatchObject({ ok: false, why: 'bad_signature' })
+  })
+  it('TAMPERED payload (wa swapped to another number, signature kept) -> bad_signature', () => {
+    const t = mintFlowToken({ purpose: 'signup', waId: '17675550101', rid: 'r1' })
+    const [pre, P, S2] = t.split('.')
+    const claims = JSON.parse(Buffer.from(P, 'base64url').toString()); claims.wa = '17675550199'
+    const forged = `${pre}.${Buffer.from(JSON.stringify(claims)).toString('base64url')}.${S2}`
+    expect(verifyFlowToken(forged, 'signup')).toMatchObject({ ok: false, why: 'bad_signature' })
+  })
+  it('EXPIRED (minted 2 h ago, ttl 1 h) -> expired; TWIN: minted 30 min ago verifies', () => {
+    const now = Date.now()
+    expect(verifyFlowToken(mintFlowToken({ purpose: 'signup', waId: '17675550101', rid: 'r1', now: now - 2 * 3600 * 1000 }), 'signup', now)).toMatchObject({ ok: false, why: 'expired' })
+    expect(verifyFlowToken(mintFlowToken({ purpose: 'signup', waId: '17675550101', rid: 'r1', now: now - 1800 * 1000 }), 'signup', now).ok).toBe(true)
+  })
+  it('WRONG PURPOSE (a topup token) -> wrong_purpose; malformed / bare phone -> refused', () => {
+    expect(verifyFlowToken(mintFlowToken({ purpose: 'topup', waId: '17675550101', rid: 'r1' }), 'signup')).toMatchObject({ ok: false, why: 'wrong_purpose' })
+    expect(verifyFlowToken('+17675550101', 'signup').ok).toBe(false)
+    expect(verifyFlowToken('pls1.abc', 'signup').ok).toBe(false)
+  })
+})
