@@ -0,0 +1,70 @@
+/**
+ * rc16: store.claimOncePerWindow against a REAL Postgres through the REAL Prisma client (+ @prisma/adapter-pg): the advisory lock,
+ * the count and the insert happen in one interactive transaction, so concurrent claimers (Flow re-taps, Meta endpoint retries) get
+ * exactly one claim. Positive twins in the same run: a different op, another sender, a failed claim and an expired window each DO claim.
+ *
+ * Runs only when LOCK_TEST_PG_URL points at a THROWAWAY local database (127.0.0.1/localhost, db name lockvoid*); anything else is
+ * refused (same guard as pl-concierge.realpg.test.ts). The table comes from the REVIEWED migration file itself.
+ */
+import { describe, it, expect, vi, beforeAll } from 'vitest'
+import { readFileSync } from 'node:fs'
+import path from 'node:path'
+
+const URL_ = vi.hoisted(() => {
+  const u = process.env.LOCK_TEST_PG_URL || ''
+  let ok = false
+  try { const x = new URL(u); ok = /^(127\.0\.0\.1|localhost)$/.test(x.hostname) && /^\/lockvoid/.test(x.pathname) } catch { ok = false }
+  if (u && !ok) throw new Error('LOCK_TEST_PG_URL must be a THROWAWAY local database (127.0.0.1/localhost, db name lockvoid*) - refusing')
+  if (ok) { process.env.DATABASE_URL = u; process.env.POSTGRES_PRISMA_URL = u }
+  return ok ? u : ''
+})
+vi.unmock('@/app/lib/prisma')
+
+import { prisma } from '../app/lib/prisma'
+import { claimOncePerWindow, finishClaim } from '../app/lib/pl-concierge/store'
+
+const run = Date.now().toString(36)
+const base = { endpoint: 'flows/store-button', windowS: 86400, claimCode: 'store_button_claimed', countCodes: ['store_button_claimed', 'store_button_sent'] }
+
+describe.skipIf(!URL_)('REAL Postgres: store-button claim (one per sender per OS per window)', () => {
+  beforeAll(async () => {
+    const db = ((await prisma.$queryRawUnsafe('SELECT current_database() AS d')) as any[])[0].d
+    if (!/^lockvoid/.test(db)) throw new Error(`refusing: connected to ${db}`)
+    const exists = ((await prisma.$queryRawUnsafe(`SELECT to_regclass('public.pl_concierge_audit')::text AS t`)) as any[])[0].t
+    if (!exists) {
+      const sql = readFileSync(path.join(__dirname, '..', 'prisma', 'migrations', '20261001020000_add_pl_concierge_service_tables', 'migration.sql'), 'utf8')
+      for (const stmt of sql.split(/;\s*\n/).map(s => s.replace(/--.*$/gm, '').trim()).filter(Boolean)) await prisma.$executeRawUnsafe(stmt)
+    }
+  })
+
+  it('20 concurrent claims for one sender + os -> exactly one claim row', async () => {
+    const h = `h_conc_${run}`
+    const ids = await Promise.all(Array.from({ length: 20 }, () => claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })))
+    expect(ids.filter(Boolean)).toHaveLength(1)
+    const n = ((await prisma.$queryRawUnsafe(`SELECT count(*)::int AS n FROM "pl_concierge_audit" WHERE "wa_id_hash" = $1`, h)) as any[])[0].n
+    expect(n).toBe(1)
+  })
+  it('a second claim inside the window is refused; CONTROL: other os / other sender claim', async () => {
+    const h = `h_seq_${run}`
+    expect(await claimOncePerWindow({ ...base, op: 'android', waIdHash: h })).toBeTruthy()
+    expect(await claimOncePerWindow({ ...base, op: 'android', waIdHash: h })).toBeNull()
+    expect(await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })).toBeTruthy()
+    expect(await claimOncePerWindow({ ...base, op: 'android', waIdHash: `${h}_other` })).toBeTruthy()
+  })
+  it('a claim finished as sent still blocks; one finished as failed does not', async () => {
+    const h = `h_fin_${run}`
+    const id1 = await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })
+    await finishClaim(id1!, 'store_button_sent', 'done', 'allow_service_message', 5)
+    expect(await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })).toBeNull()
+    const h2 = `h_fail_${run}`
+    const id2 = await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h2 })
+    await finishClaim(id2!, 'store_button_failed', 'failed', 'dispatch_failed', 5)
+    expect(await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h2 })).toBeTruthy()
+  })
+  it('after the window the same sender + os claims again', async () => {
+    const h = `h_win_${run}`
+    const id = await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })
+    await prisma.$executeRawUnsafe(`UPDATE "pl_concierge_audit" SET "created_at" = NOW() - INTERVAL '25 hours' WHERE "id" = $1`, id)
+    expect(await claimOncePerWindow({ ...base, op: 'ios', waIdHash: h })).toBeTruthy()
+  })
+})
