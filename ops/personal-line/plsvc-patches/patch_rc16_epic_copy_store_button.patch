+ */
+export async function sendPlStoreButton(toPhone: string, os: 'ios' | 'android', url: unknown, ctx: Partial<WaSendContext>): Promise<GateDecision> {
+  const phoneId = process.env.PL_FLOW_SENDER_PHONE_ID || ''
+  if (!phoneId) throw new Error('PL_FLOW_SENDER_PHONE_ID not configured')
+  const sendCtx: WaSendContext = {
+    purpose: ctx.purpose ?? 'lite_onboarding',
+    senderPath: ctx.senderPath ?? 'pl:flows/store-button',
+    kind: 'interactive',
+    recipientPhone: toPhone,
+    userId: ctx.userId,
+    agentId: ctx.agentId,
+    sourceEventType: ctx.sourceEventType,
+    sourceEventId: ctx.sourceEventId,
+    sourceMessageId: ctx.sourceMessageId,
+  }
+  const decision = await dispatchToMeta(buildPlStoreButtonPayload(toPhone, os, url), phoneId, sendCtx)
