+    const t0 = Date.now(); const r = await storeTap('ios'); const ms = Date.now() - t0
+    expect(r.screen).toBe('INSTALL_STORE'); expect(ms).toBeLessThan(1000); await flush(); expect(S.sends).toHaveLength(1)
+  })
+  it('CONTROL: other INSTALL actions (already have it) never start a send', async () => {
+    await handleSignupFlow({ action: 'data_exchange', screen: 'INSTALL', data: { step: 'installed' }, claims }); await flush()
+    expect(S.sends).toHaveLength(0)
+  })
+})
+
+describe('install_md is true for Flow v7.1 ("I\'ve installed it") and v8 ("Continue setup")', () => {
+  it('names no footer label, keeps the three steps', () => {
+    for (const os of ['ios', 'android'] as const) {
+      const md = storeScreen(os).data.install_md
+      expect(md).not.toMatch(/I've installed it|Continue setup/)
+      expect(md).toContain('**3.** Come back to WhatsApp and continue your setup')
+      expect(md).toContain('Install **Cloud Softphone**')
+    }
+  })
+})
+
+describe('endpoint-generated copy is EPIC-branded', () => {
+  const texts = (o: any) => JSON.stringify(o?.data ?? {})
+  it('holder WELCOME, CONFIRM, LINE_READY (existing + created), PROVISIONING, CONNECTED: no "Isola", says EPIC', async () => {
+    const out: any[] = []
+    out.push(await handleSignupFlow({ action: 'INIT', claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'WELCOME', data: { first_name: 'Ann' }, claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'CONFIRM', data: { confirm: 'yes' }, claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'PROVISIONING', data: {}, claims }))
+    S.stage = 'first_call_done'; out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'LINE_READY', data: {}, claims }))
+    S.did = null
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'WELCOME', data: { first_name: 'Ann' }, claims }))
+    const all = out.map(texts).join('\n')
+    expect(out.map(o => o.screen)).toEqual(['WELCOME', 'CONFIRM', 'LINE_READY', 'LINE_READY', 'CONNECTED', 'CONFIRM'])
+    expect(all).not.toMatch(/isola/i)
+    expect(all).toContain('Your EPIC line +1 (767) 818-5001')
+    expect(all).toContain('You already have this EPIC line')
+    expect(all).toContain('Your EPIC line has been created')
+    expect(all).toContain('welcome to EPIC!')
+    expect(all).toContain('set up your free EPIC line')
+  })
+  it('CONTROL: the scan would catch the old brand (signup-flow source no longer carries a customer-facing "Isola" string)', async () => {
+    const { readFileSync } = await import('node:fs')
+    const src = readFileSync(new URL('../app/lib/pl-concierge/signup-flow.ts', import.meta.url), 'utf8')
+    // strip comments, then look only inside string/template literals
+    const code = src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1')
+    const literals: string[] = code.match(/(['"`])(?:\\.|(?!\1)[^\\])*\1/g) ?? []
+    const offenders = literals.filter(l => /isola/i.test(l) && !l.startsWith("'@/") && !/^['"`]\[/.test(l))
+    expect(offenders).toEqual([])
+    expect(['"welcome to Isola"'].filter(l => /isola/i.test(l))).toHaveLength(1)   // the filter itself fires on a known positive
+  })
+})
diff --git a/test/pl-store-button-claim.realpg.test.ts b/test/pl-store-button-claim.realpg.test.ts
