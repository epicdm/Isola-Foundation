+/**
+ * rc16: storeButtonForFlow - at most ONE store-button message per verified sender per OS per 24 h.
+ * The store's claim is faked here with the SAME semantics as store.claimOncePerWindow (rows keyed by endpoint + op + waIdHash,
+ * counted codes, window); the SQL itself (advisory lock + count + insert) is proven against a real Postgres in
+ * pl-store-button-claim.realpg.test.ts. Every "nothing was sent" assertion has a positive twin that DOES send in this harness.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const S = vi.hoisted(() => ({ rows: [] as any[], clock: Date.now(), sends: [] as any[], sendImpl: null as null | ((...a: any[]) => Promise<any>), bindings: {} as Record<string, string> }))
+
+vi.mock('@/app/lib/runtime-flags', () => ({ getRuntimeFlag: () => false, getRuntimeNumber: (_k: string, d: number) => d, getRuntimeList: (_k: string, d: string[]) => d }))
+vi.mock('@/app/lib/prisma', () => ({ prisma: {} }))
+vi.mock('@/app/lib/pl-concierge/store', async (orig) => {
+  const real: any = await orig()
+  return {
+    idHash: real.idHash,
+    writeAudit: vi.fn(async () => 'x'),
+    claimOncePerWindow: vi.fn(async (a: any) => {
+      const since = S.clock - a.windowS * 1000
+      const n = S.rows.filter(r => r.waIdHash === a.waIdHash && r.endpoint === a.endpoint && r.op === a.op && r.at >= since && a.countCodes.includes(r.code)).length
+      if (n > 0) return null
+      const id = `c${S.rows.length + 1}`
+      S.rows.push({ id, endpoint: a.endpoint, op: a.op, waIdHash: a.waIdHash, code: a.claimCode, at: S.clock, mid: a.mid })
+      return id
+    }),
+    finishClaim: vi.fn(async (id: string, code: string, outcome: string, detail?: string) => { const r = S.rows.find(x => x.id === id); if (r) Object.assign(r, { code, outcome, detail }) }),
+  }
+})
+vi.mock('@/app/lib/lite-signup-identity', () => ({
+  resolveExistingBinding: vi.fn(async (wa: string) => (S.bindings[wa] ? { kind: 'existing', userId: S.bindings[wa], accountId: 'acc', reason: 'sole_holder' } : { kind: 'none' })),
+  resolveSignupIdentity: vi.fn(), notifyAmbiguousRefusal: vi.fn(),
+}))
+vi.mock('@/app/lib/whatsapp', () => ({
+  sendPlStoreButton: vi.fn(async (...a: any[]) => { S.sends.push(a); return S.sendImpl ? S.sendImpl(...a) : { code: 'allow_service_message', auditId: 'w1' } }),
+  sendPlSignupFlow: vi.fn(),
+}))
+vi.mock('@/app/lib/lite-provision-identity', () => ({ provisionUserIdFor: vi.fn() }))
+vi.mock('@/app/lib/lite-provision', () => ({ provisionLine: vi.fn() }))
+vi.mock('@/app/lib/lite-line-balance', () => ({ getLineMinutesBalance: vi.fn(), isKnownLow: vi.fn(), formatBalanceDate: vi.fn() }))
+vi.mock('@/app/lib/lite-registration-watch', () => ({ REGISTERED: new Set(['registered']), readPeerRegistration: vi.fn() }))
+vi.mock('@/app/lib/lite-post-provision', () => ({ activationStatusForUser: vi.fn() }))
+vi.mock('@/app/lib/lite-first-call-status', () => ({ getFirstCallStatus: vi.fn(), recordInstallSelfReport: vi.fn() }))
+vi.mock('@/app/lib/lite-offer-copy', () => ({ inboundReachable: () => false, missedCallAlertsLive: () => false }))
+vi.mock('@/app/lib/lite-softphone-activation', () => ({ mintSoftphoneActivation: vi.fn(), IOS_URL: 'https://apps.apple.com/x', ANDROID_URL: 'https://play.google.com/x' }))
+vi.mock('@/app/lib/lite-activation', () => ({ activationEnabledFor: vi.fn() }))
+vi.mock('@/app/lib/lite-reply-guard', () => ({ appLinkGateEnabled: () => true, onboardingGates: () => ({}) }))
+vi.mock('@/app/lib/wa-signin-token', () => ({ buildAppSigninLinkCapped: vi.fn() }))
+vi.mock('@/app/lib/magnus', () => ({ getMagnusUserById: vi.fn(), getMagnusUserCallsStrict: vi.fn(), getMagnusOfferIncludedMinutes: vi.fn(), requirePlPlusPlanId: () => '19' }))
+
+import { storeButtonForFlow, STORE_BUTTON_WINDOW_S } from '@/app/lib/pl-concierge/service'
+
+const A = '17675550101', B = '17675550102'
+const IOS = 'https://apps.apple.com/us/app/cloud-softphone/id567475545'
+const AND = 'https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone'
+const tap = (wa: string, os: 'ios' | 'android', n = 'n1') => storeButtonForFlow({ waId: wa, rid: 'rid1', flowNonce: n, os, url: os === 'ios' ? IOS : AND })
+
+beforeEach(() => {
+  S.rows = []; S.sends = []; S.sendImpl = null; S.clock = Date.now()
+  S.bindings = { [A]: 'userA', [B]: 'userB' }
+  process.env.PL_ASSERTION_KID = 'k1'
+  process.env.PL_ASSERTION_HMAC_KEY = 'k'.repeat(48)   // test-only fixture; length is all readConfig checks
+  process.env.PL_CONCIERGE_PNID_ALLOWLIST = '100000000000001'
+})
+
+describe('one store button per sender per OS per 24 h', () => {
+  it('first store tap sends exactly one message, with the documented provenance', async () => {
+    const r = await tap(A, 'ios')
+    expect(r.code).toBe('store_button_sent')
+    expect(S.sends).toHaveLength(1)
+    const [to, os, url, ctx] = S.sends[0]
+    expect([to, os, url]).toEqual([A, 'ios', IOS])
+    expect(ctx).toMatchObject({ userId: 'userA', senderPath: 'pl:flows/store-button', sourceEventType: 'pl_verified_inbound', sourceEventId: 'flow:n1', sourceMessageId: 'store-button:ios' })
+    expect(S.rows.map(x => x.code)).toEqual(['store_button_sent'])
+  })
+  it('a second tap (same Flow session) within the window sends nothing', async () => {
+    await tap(A, 'ios'); const r = await tap(A, 'ios')
+    expect(r.code).toBe('store_button_duplicate'); expect(S.sends).toHaveLength(1)
+  })
+  it('a NEW Flow session within the window also sends nothing (dedupe is per sender, not per token)', async () => {
+    await tap(A, 'ios', 'n1'); S.clock += 23 * 3600 * 1000; const r = await tap(A, 'ios', 'n2')
+    expect(r.code).toBe('store_button_duplicate'); expect(S.sends).toHaveLength(1)
+  })
+  it('CONTROL: a different OS within the window DOES send', async () => {
+    await tap(A, 'ios'); const r = await tap(A, 'android')
+    expect(r.code).toBe('store_button_sent'); expect(S.sends).toHaveLength(2); expect(S.sends[1][1]).toBe('android')
+  })
+  it('CONTROL: the same OS after the 24 h window DOES send', async () => {
+    await tap(A, 'ios'); S.clock += STORE_BUTTON_WINDOW_S * 1000 + 1000; const r = await tap(A, 'ios', 'n9')
+    expect(r.code).toBe('store_button_sent'); expect(S.sends).toHaveLength(2)
+  })
+  it('CONTROL: another sender is independent', async () => {
+    await tap(A, 'ios'); const r = await tap(B, 'ios')
+    expect(r.code).toBe('store_button_sent'); expect(S.sends).toHaveLength(2); expect(S.sends[1][0]).toBe(B)
+  })
+  it('concurrent retries of the same tap (Meta endpoint retry) send once', async () => {
+    const rs = await Promise.all([tap(A, 'android'), tap(A, 'android'), tap(A, 'android')])
+    expect(rs.filter(r => r.code === 'store_button_sent')).toHaveLength(1)
+    expect(S.sends).toHaveLength(1)
+  })
+})
+
+describe('failures never count as a send, and never throw', () => {
+  it('a Meta dispatch failure is recorded as failed (not counted) and returns, no throw', async () => {
+    S.sendImpl = async () => ({ code: 'allow_service_message', dispatchFailed: true, errorCode: '400', auditId: 'w' })
+    const r = await tap(A, 'ios')
+    expect(r.code).toBe('store_button_failed'); expect(S.rows[0].code).toBe('store_button_failed')
+    S.sendImpl = null
+    const r2 = await tap(A, 'ios', 'n2')                      // CONTROL: the failed attempt does not block a later one
+    expect(r2.code).toBe('store_button_sent'); expect(S.sends).toHaveLength(2)
+  })
+  it('a gate refusal (e.g. STOP on file) is failed, not sent', async () => {
+    S.sendImpl = async () => ({ code: 'suppress', auditId: 'w' })
+    const r = await tap(A, 'ios'); expect(r.code).toBe('store_button_failed'); expect(r.detail).toContain('suppress')
+  })
+  it('a thrown sender error is caught and recorded', async () => {
+    S.sendImpl = async () => { throw new Error('PL_FLOW_SENDER_PHONE_ID not configured') }
+    const r = await tap(A, 'ios'); expect(r.code).toBe('store_button_failed'); expect(r.detail).toMatch(/PL_FLOW_SENDER_PHONE_ID/)
+  })
+  it('no line binding -> nothing sent', async () => {
+    S.bindings = {}
+    const r = await tap(A, 'ios'); expect(r.code).toBe('store_button_failed'); expect(S.sends).toHaveLength(0)
+  })
+  it('service misconfigured -> service_disabled, nothing claimed or sent', async () => {
+    delete process.env.PL_ASSERTION_HMAC_KEY
+    const r = await tap(A, 'ios'); expect(r.code).toBe('service_disabled'); expect(S.rows).toHaveLength(0); expect(S.sends).toHaveLength(0)
+  })
+})
