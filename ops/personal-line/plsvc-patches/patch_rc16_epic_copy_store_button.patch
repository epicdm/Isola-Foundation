+/**
+ * rc16: the signup Flow endpoint's INSTALL -> store step, through the real handleSignupFlow.
+ *  - the Flow answer (INSTALL_STORE) is unchanged by the store-button send: identical on success, failure, rejection or a hung send;
+ *  - the send is started only when the engine READ the install stage (never for a completed line holder or an unread stage);
+ *  - endpoint-generated copy says EPIC, never "Isola"; install_md no longer names a footer label (true for Flow v7.1 and v8).
+ * Every negative has a positive twin in this file.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const S = vi.hoisted(() => ({
+  stage: 'install' as string | null, nextCode: 'next_step', sendImpl: null as null | (() => Promise<any>), sends: [] as any[],
+  storeLinks: {} as Record<string, string>, did: '17678185001' as string | null,
+}))
+vi.mock('@/app/lib/prisma', () => ({ prisma: { liteAccount: { findUnique: vi.fn(async () => (S.did ? { did: S.did } : null)) } } }))
+vi.mock('@/app/lib/lite-signup-identity', () => ({
+  resolveExistingBinding: vi.fn(async () => (S.did ? { kind: 'existing', userId: 'userA' } : { kind: 'none' })),
+  resolveSignupIdentity: vi.fn(async () => ({ kind: 'existing', userId: 'userA' })),
+  notifyAmbiguousRefusal: vi.fn(async () => true),
+}))
+vi.mock('@/app/lib/lite-provision', () => ({ provisionLine: vi.fn(async () => ({ status: 200, did: '17678185001' })) }))
+vi.mock('@/app/lib/lite-offer-text', () => ({ PL_OVERAGE_TEXT: 'Overage text.', VOICE_ONLY_DISCLOSURE: 'Voice only.' }))
+vi.mock('@/app/lib/pl-concierge/service', () => ({
+  nextStepForFlow: vi.fn(async () => (S.nextCode === 'throw' ? Promise.reject(new Error('engine down')) : { code: S.nextCode, data: { stage: S.stage, store_links: S.storeLinks, facts: { did_pretty: '+1 (767) 818-5001' } } })),
+  storeButtonForFlow: vi.fn(async (a: any) => { S.sends.push(a); return S.sendImpl ? S.sendImpl() : { code: 'store_button_sent' } }),
+  lineStatusForFlow: vi.fn(async () => ({ code: 'line_status', data: { registration: 'unknown', softphone_activated: false } })),
+  balanceForFlow: vi.fn(async () => ({ code: 'balance', data: { known: true, kind: 'included', minutes_remaining: 50, minutes_included: 60, expires_date_pretty: 'Oct 20', plan_name: 'Trial', wallet_xcd: '0.00' } })),
+  buildOffer: vi.fn(async () => ({ code: 'offer', data: { trial_days: 7, trial_minutes: 60, trial_price_xcd: '0' } })),
+}))
+
+import { handleSignupFlow, storeScreen } from '@/app/lib/pl-concierge/signup-flow'
+
+const claims = { v: 1, p: 'signup', wa: '17675550101', cw: 'rid1', iat: 0, exp: 9e9, n: 'nonce1' } as any
+const storeTap = (os: 'ios' | 'android') => handleSignupFlow({ action: 'data_exchange', screen: 'INSTALL', data: { step: 'store', os }, claims })
+const flush = () => new Promise(r => setTimeout(r, 20))
+
+beforeEach(() => { S.stage = 'install'; S.nextCode = 'next_step'; S.sendImpl = null; S.sends = []; S.storeLinks = {}; S.did = '17678185001' })
+
+describe('INSTALL -> store: the Flow answer is the store screen, the send is a side effect', () => {
+  it('install stage: answers INSTALL_STORE and starts exactly one store-button send with the screen\'s own store URL', async () => {
+    S.storeLinks = { ios: 'https://apps.apple.com/dm/app/cloud-softphone/id567475545' }
+    const r = await storeTap('ios'); await flush()
+    expect(r.screen).toBe('INSTALL_STORE')
+    expect(S.sends).toEqual([{ waId: '17675550101', rid: 'rid1', flowNonce: 'nonce1', os: 'ios', url: 'https://apps.apple.com/dm/app/cloud-softphone/id567475545' }])
+    expect(r.data.store_url).toBe('https://apps.apple.com/dm/app/cloud-softphone/id567475545')
+  })
+  it('a completed line holder (stage connected) gets the screen but NO send', async () => {
+    S.stage = 'connected'
+    const r = await storeTap('android'); await flush()
+    expect(r.screen).toBe('INSTALL_STORE'); expect(S.sends).toHaveLength(0)
+  })
+  it('an unread stage (engine error / not next_step) sends nothing - fail closed', async () => {
+    S.nextCode = 'throw'; let r = await storeTap('ios'); await flush()
+    expect(r.screen).toBe('INSTALL_STORE'); expect(S.sends).toHaveLength(0)
+    S.nextCode = 'rate_limited'; r = await storeTap('ios'); await flush()
+    expect(S.sends).toHaveLength(0)
+  })
+  it('send failure / rejection does not change the Flow screen response (byte-identical to the success case)', async () => {
+    const ok = await storeTap('android'); await flush()
+    S.sendImpl = async () => ({ code: 'store_button_failed', detail: 'dispatch_failed' })
+    const failed = await storeTap('android'); await flush()
+    S.sendImpl = async () => { throw new Error('boom') }
+    const rejected = await storeTap('android'); await flush()
+    expect(JSON.stringify(failed)).toBe(JSON.stringify(ok))
+    expect(JSON.stringify(rejected)).toBe(JSON.stringify(ok))
+    expect(S.sends).toHaveLength(3)   // CONTROL: the send really was attempted each time
+  })
+  it('a send that never finishes does not hold the Flow answer (answers in well under 1 s)', async () => {
+    S.sendImpl = () => new Promise(() => { /* never settles */ })
+    const t0 = Date.now(); const r = await storeTap('ios'); const ms = Date.now() - t0
+    expect(r.screen).toBe('INSTALL_STORE'); expect(ms).toBeLessThan(1000); await flush(); expect(S.sends).toHaveLength(1)
+  })
+  it('CONTROL: other INSTALL actions (already have it) never start a send', async () => {
+    await handleSignupFlow({ action: 'data_exchange', screen: 'INSTALL', data: { step: 'installed' }, claims }); await flush()
+    expect(S.sends).toHaveLength(0)
+  })
+})
+
+describe('install_md is true for Flow v7.1 ("I\'ve installed it") and v8 ("Continue setup")', () => {
+  it('names no footer label, keeps the three steps', () => {
+    for (const os of ['ios', 'android'] as const) {
+      const md = storeScreen(os).data.install_md
+      expect(md).not.toMatch(/I've installed it|Continue setup/)
+      expect(md).toContain('**3.** Come back to WhatsApp and continue your setup')
+      expect(md).toContain('Install **Cloud Softphone**')
+    }
+  })
+})
+
+describe('endpoint-generated copy is EPIC-branded', () => {
+  const texts = (o: any) => JSON.stringify(o?.data ?? {})
+  it('holder WELCOME, CONFIRM, LINE_READY (existing + created), PROVISIONING, CONNECTED: no "Isola", says EPIC', async () => {
+    const out: any[] = []
+    out.push(await handleSignupFlow({ action: 'INIT', claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'WELCOME', data: { first_name: 'Ann' }, claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'CONFIRM', data: { confirm: 'yes' }, claims }))
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'PROVISIONING', data: {}, claims }))
+    S.stage = 'first_call_done'; out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'LINE_READY', data: {}, claims }))
+    S.did = null
+    out.push(await handleSignupFlow({ action: 'data_exchange', screen: 'WELCOME', data: { first_name: 'Ann' }, claims }))
+    const all = out.map(texts).join('\n')
+    expect(out.map(o => o.screen)).toEqual(['WELCOME', 'CONFIRM', 'LINE_READY', 'LINE_READY', 'CONNECTED', 'CONFIRM'])
+    expect(all).not.toMatch(/isola/i)
+    expect(all).toContain('Your EPIC line +1 (767) 818-5001')
+    expect(all).toContain('You already have this EPIC line')
+    expect(all).toContain('Your EPIC line has been created')
+    expect(all).toContain('welcome to EPIC!')
+    expect(all).toContain('set up your free EPIC line')
+  })
+  it('CONTROL: the scan would catch the old brand (signup-flow source no longer carries a customer-facing "Isola" string)', async () => {
+    const { readFileSync } = await import('node:fs')
+    const src = readFileSync(new URL('../app/lib/pl-concierge/signup-flow.ts', import.meta.url), 'utf8')
+    // strip comments, then look only inside string/template literals
+    const code = src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1')
+    const literals: string[] = code.match(/(['"`])(?:\\.|(?!\1)[^\\])*\1/g) ?? []
+    const offenders = literals.filter(l => /isola/i.test(l) && !l.startsWith("'@/") && !/^['"`]\[/.test(l))
+    expect(offenders).toEqual([])
+    expect(['"welcome to Isola"'].filter(l => /isola/i.test(l))).toHaveLength(1)   // the filter itself fires on a known positive
+  })
+})
