+    SELECT max("created_at") AS t FROM "pl_concierge_audit"
+    WHERE "wa_id_hash" = ${waIdHash} AND "kid" IS NOT NULL AND "kid" <> 'flow' AND "http_status" = 200
+      AND ("rid" IS NULL OR "rid" NOT LIKE 'elig-%')`
+  return rows[0]?.t ? new Date(rows[0].t) : null
+}
+
