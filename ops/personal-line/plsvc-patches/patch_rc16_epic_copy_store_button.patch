+/**
+ * rc16: the Personal Line store button is a DOCUMENTED interactive Call-to-Action URL button message.
+ * Source of the schema (read 2026-10-11, page "Updated: Nov 3, 2025"):
+ *   https://developers.facebook.com/documentation/business-messaging/whatsapp/messages/interactive-cta-url-messages
+ *   interactive.type 'cta_url'; header (text) <= 60; body.text required <= 1024; footer.text <= 60;
+ *   action.name 'cta_url'; action.parameters.display_text required <= 20; action.parameters.url required.
+ * The send goes through the gate (gateAndDispatch) FROM PL_FLOW_SENDER_PHONE_ID only - never the default/3742 fallback.
+ * Every refusal has a positive twin in the same file.
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+
+const G = vi.hoisted(() => {
+  // whatsapp.ts reads its bearer at module load; a dummy so the stubbed fetch is reached (never a real credential, fetch is stubbed).
+  if (!process.env.WHATSAPP_TOKEN && !process.env.META_WA_TOKEN) process.env.WHATSAPP_TOKEN = `dummy-${Math.random().toString(36).slice(2)}`
+  return { ctxs: [] as any[], bodies: [] as any[], urls: [] as string[], decision: 'allow_service_message' as string }
+})
+vi.mock('@/app/lib/prisma', () => ({ prisma: {} }))
+vi.mock('@/app/lib/paperclip', () => ({ paperclipMirrorOutbound: vi.fn() }))
+vi.mock('@/app/lib/wa-send-gate', () => ({
+  evaluateWaSend: vi.fn(),
+  gateAndDispatch: vi.fn(async (ctx: any, send: () => Promise<Response>) => {
+    G.ctxs.push(ctx)
+    if (!G.decision.startsWith('allow_')) return { code: G.decision, reason: 'test', auditId: 'a0' }
+    await send()
+    return { code: G.decision, reason: 'test', auditId: 'a1' }
+  }),
+}))
+
+import { buildPlStoreButtonPayload, plStoreUrl, sendPlStoreButton, sendPlSignupFlow, PL_STORE_FALLBACK_URLS } from '@/app/lib/whatsapp'
+
+const realFetch = globalThis.fetch
+beforeEach(() => {
+  G.ctxs = []; G.bodies = []; G.urls = []; G.decision = 'allow_service_message'
+  globalThis.fetch = vi.fn(async (url: any, init: any) => { G.urls.push(String(url)); G.bodies.push(JSON.parse(String(init?.body ?? '{}'))); return new Response('{"messages":[{"id":"wamid.X"}]}', { status: 200 }) }) as any
+  process.env.PL_FLOW_SENDER_PHONE_ID = '111111111111111'
+  process.env.PL_SIGNUP_FLOW_ID = '222222222222222'
+})
+afterEach(() => { globalThis.fetch = realFetch })
+
+function assertDocumentedCtaUrl(p: any) {
+  expect(p.messaging_product).toBe('whatsapp')
+  expect(p.type).toBe('interactive')
+  expect(p.interactive.type).toBe('cta_url')
+  expect(p.interactive.action.name).toBe('cta_url')
+  const prm = p.interactive.action.parameters
+  expect(Object.keys(prm).sort()).toEqual(['display_text', 'url'])
+  expect(typeof prm.display_text).toBe('string')
+  expect(prm.display_text.length).toBeGreaterThan(0)
+  expect(prm.display_text.length).toBeLessThanOrEqual(20)
+  expect(new URL(prm.url).protocol).toBe('https:')
+  expect(p.interactive.body.text.length).toBeGreaterThan(0)
+  expect(p.interactive.body.text.length).toBeLessThanOrEqual(1024)
+  expect(p.interactive.header).toMatchObject({ type: 'text' })
+  expect(p.interactive.header.text.length).toBeLessThanOrEqual(60)
+  expect(p.interactive.footer.text.length).toBeLessThanOrEqual(60)
+  // only documented top-level interactive keys
+  expect(Object.keys(p.interactive).sort()).toEqual(['action', 'body', 'footer', 'header', 'type'])
+}
+
+describe('payload matches the documented cta_url schema', () => {
+  it('iPhone: App Store button, documented shape, honest return guidance, no "Isola"', () => {
+    const p = buildPlStoreButtonPayload('17675550101', 'ios', 'https://apps.apple.com/us/app/cloud-softphone/id567475545')
+    assertDocumentedCtaUrl(p)
+    expect(p.to).toBe('17675550101')
+    expect(p.interactive.action.parameters).toEqual({ display_text: 'Open App Store', url: 'https://apps.apple.com/us/app/cloud-softphone/id567475545' })
+    expect(p.interactive.header.text).toBe('Install Cloud Softphone (free)')
+    expect(p.interactive.body.text).toContain('After installing, come back to this chat and tap the setup form above to continue - on iPhone tap ◀ WhatsApp at the top left, on Android press Back.')
+    expect(JSON.stringify(p)).not.toMatch(/isola/i)
+    expect(JSON.stringify(p)).toContain('EPIC')
+  })
+  it('Android: Google Play button, documented shape, no "Isola"', () => {
+    const p = buildPlStoreButtonPayload('17675550101', 'android', 'https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone')
+    assertDocumentedCtaUrl(p)
+    expect(p.interactive.action.parameters.display_text).toBe('Open Google Play')
+    expect(p.interactive.action.parameters.url).toBe('https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone')
+    expect(JSON.stringify(p)).not.toMatch(/isola/i)
+  })
+  it('a non-https or foreign-host URL never goes behind the button (falls back to the official listing)', () => {
+    expect(plStoreUrl('ios', 'http://apps.apple.com/x')).toBe(PL_STORE_FALLBACK_URLS.ios)
+    expect(plStoreUrl('ios', 'https://evil.example/apps.apple.com')).toBe(PL_STORE_FALLBACK_URLS.ios)
+    expect(plStoreUrl('android', 'https://apps.apple.com/us/app/x')).toBe(PL_STORE_FALLBACK_URLS.android)
+    expect(plStoreUrl('android', undefined)).toBe(PL_STORE_FALLBACK_URLS.android)
+    expect(plStoreUrl('ios', 'not a url')).toBe(PL_STORE_FALLBACK_URLS.ios)
+  })
+  it('CONTROL: an https URL on the right store host is kept as given', () => {
+    expect(plStoreUrl('ios', 'https://apps.apple.com/dm/app/cloud-softphone/id567475545')).toBe('https://apps.apple.com/dm/app/cloud-softphone/id567475545')
+    expect(plStoreUrl('android', 'https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone&hl=en')).toBe('https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone&hl=en')
+  })
+})
+
+describe('sendPlStoreButton goes through the gate from the PL sender only', () => {
+  it('dispatches via gateAndDispatch from PL_FLOW_SENDER_PHONE_ID with a pl: interactive context', async () => {
+    const d = await sendPlStoreButton('17675550101', 'ios', 'https://apps.apple.com/us/app/cloud-softphone/id567475545', { userId: 'u1', sourceEventType: 'pl_verified_inbound', sourceEventId: 'flow:n1', sourceMessageId: 'store-button:ios' })
+    expect(d.code).toBe('allow_service_message')
+    expect(G.ctxs).toHaveLength(1)
+    expect(G.ctxs[0]).toMatchObject({ kind: 'interactive', purpose: 'lite_onboarding', senderPath: 'pl:flows/store-button', recipientPhone: '17675550101', userId: 'u1', fromPhoneId: '111111111111111', sourceEventType: 'pl_verified_inbound', sourceEventId: 'flow:n1', sourceMessageId: 'store-button:ios' })
+    expect(G.urls).toEqual(['https://graph.facebook.com/v25.0/111111111111111/messages'])
+    assertDocumentedCtaUrl(G.bodies[0])
+  })
+  it('no PL_FLOW_SENDER_PHONE_ID -> throws, nothing reaches the gate or Meta (never the 3742/default fallback)', async () => {
+    delete process.env.PL_FLOW_SENDER_PHONE_ID
+    await expect(sendPlStoreButton('17675550101', 'ios', '', { userId: 'u1' })).rejects.toThrow(/PL_FLOW_SENDER_PHONE_ID/)
+    expect(G.ctxs).toHaveLength(0); expect(G.urls).toHaveLength(0)
+  })
+  it('a gate refusal sends nothing to Meta', async () => {
+    G.decision = 'suppress'
+    const d = await sendPlStoreButton('17675550101', 'android', '', { userId: 'u1' })
+    expect(d.code).toBe('suppress'); expect(G.ctxs).toHaveLength(1); expect(G.urls).toHaveLength(0)
+  })
+})
+
+describe('EPIC branding on the PL signup Flow message footer', () => {
+  it('footer reads "EPIC Personal Line" (no "Isola" in the sent payload)', async () => {
+    await sendPlSignupFlow('17675550101', 'pls1.x.y', 'body', { userId: 'u1' })
+    expect(G.bodies).toHaveLength(1)
+    expect(G.bodies[0].interactive.footer).toEqual({ text: 'EPIC Personal Line' })
+    expect(JSON.stringify(G.bodies[0])).not.toMatch(/isola/i)
+  })
+})
