+  it('proof: a future-dated / missing iat is refused; TWIN: a 59-minute-old proof is accepted', async () => {
+    expect((await tap(A, 'ios', 'n1', Math.floor(Date.now() / 1000) + 600)).code).toBe('store_button_proof_stale')
+    expect((await tap(A, 'ios', 'n2', 0)).code).toBe('store_button_proof_stale')
