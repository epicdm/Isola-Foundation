@@ -0,0 +1,37 @@
+/**
+ * rc16b: launch scope is OUTBOUND calling only. No customer-facing Personal Line copy may claim or imply that the customer can
+ * RECEIVE calls on their number (readiness record pl-launch-readiness-for-sales-marketing-2026-10-10: "never claim or imply").
+ * Found in production rc15: the new-customer flows/launch body said "Calls are made and received in the free Cloud Softphone app".
+ * Line-based scan of the customer-copy sources (comment lines excluded); the same scan function runs on a positive control.
+ */
+import { describe, it, expect } from 'vitest'
+import { readFileSync } from 'node:fs'
+
+const SOURCES = ['../app/lib/pl-concierge/service.ts', '../app/lib/pl-concierge/signup-flow.ts']
+const RECEIVE_CLAIM = /(made and received|receive (your )?calls (in|on|from)|calls? (are|is) received)/i
+// the only allowed mention: the inbound-enabled branch in signup-flow.ts, gated on f.inbound_enabled (false at launch)
+const ALLOWED = /rings in Cloud Softphone now/
+
+const codeLines = (text: string) => text.split('\n').filter(l => !/^\s*(\/\/|\*|\/\*)/.test(l))
+const offenders = (text: string) => codeLines(text).filter(l => RECEIVE_CLAIM.test(l) && !ALLOWED.test(l))
+const read = (rel: string) => readFileSync(new URL(rel, import.meta.url), 'utf8')
+
+describe('outbound-only launch scope: no receive-calls claim in customer copy', () => {
+  it('new-customer flows/launch body states outbound calling and that receiving is not available', () => {
+    const line = codeLines(read(SOURCES[0])).find(l => l.includes('Free trial: ${o.trial_days}'))
+    expect(line).toBeDefined()
+    expect(line).toContain('You make calls from the free Cloud Softphone app')
+    expect(line).toContain('receiving calls on your number is not available yet')
+  })
+  it('no code line in the customer-copy sources claims calls are received', () => {
+    for (const s of SOURCES) expect({ s, hits: offenders(read(s)) }).toEqual({ s, hits: [] })
+  })
+  it('CONTROL: the same scan fires on the old production line and not on the new one or on a comment', () => {
+    const old = "    : `Free trial: ${o.trial_days} days. Calls are made and received in the free Cloud Softphone app. ${X}`"
+    const fixed = "    : `Free trial: ${o.trial_days} days. You make calls from the free Cloud Softphone app; receiving calls on your number is not available yet.`"
+    const comment = '  // Calls are made and received - old copy'
+    expect(offenders(old)).toHaveLength(1)
+    expect(offenders(fixed)).toHaveLength(0)
+    expect(offenders(comment)).toHaveLength(0)
+  })
+})
