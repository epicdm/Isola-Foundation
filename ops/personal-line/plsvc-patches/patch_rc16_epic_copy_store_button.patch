+/**
+ * rc16: ATOMIC "at most once per window" claim, recorded as an audit row (endpoint + op), in the existing audit table - no new table.
+ * Inside one transaction a per-(endpoint, waIdHash, op) advisory lock serialises concurrent claimers (Flow re-taps, Meta endpoint
+ * retries), then a row with one of `countCodes` inside the window means "already claimed" (returns null); otherwise the claim row is
+ * written with `claimCode` and its id returned. A claim whose work then fails is re-coded by the caller (finishClaim) to a code outside
+ * `countCodes`, so a failed send does not block a later one.
+ */
+export async function claimOncePerWindow(args: { endpoint: string; op: string; waIdHash: string; windowS: number; claimCode: string; countCodes: string[]; rid?: string | null; mid?: string | null; waLast4?: string | null }): Promise<string | null> {
+  // ':' separators - a NUL byte cannot travel in a Postgres text parameter (measured on staging: the claim threw before this fix)
+  const lockKey = `pl-claim:${args.endpoint}:${args.waIdHash}:${args.op}`
+  const since = new Date(Date.now() - args.windowS * 1000)
+  return prisma.$transaction(async (tx) => {
+    await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtextextended(${lockKey}, 0))`
+    const rows = await tx.$queryRaw<Array<{ n: number }>>`
+      SELECT count(*)::int AS n FROM "pl_concierge_audit"
+      WHERE "wa_id_hash" = ${args.waIdHash} AND "endpoint" = ${args.endpoint} AND "op" = ${args.op}
+        AND "created_at" >= ${since} AND "code" = ANY(${args.countCodes}::text[])`
+    if (Number(rows[0]?.n ?? 0) > 0) return null
+    const id = randomUUID()
+    await tx.$executeRaw`
+      INSERT INTO "pl_concierge_audit" ("id", "endpoint", "op", "http_status", "code", "kid", "rid", "mid", "wa_id_hash", "wa_last4", "outcome")
+      VALUES (${id}, ${args.endpoint}, ${args.op}, 200, ${args.claimCode}, 'flow', ${args.rid ?? null}, ${args.mid ?? null}, ${args.waIdHash}, ${args.waLast4 ?? null}, 'started')`
+    return id
+  })
+}
+
+/** rc16: record how a claim ended (code + outcome + short detail). */
+export async function finishClaim(id: string, code: string, outcome: 'done' | 'failed', detail?: string | null, latencyMs?: number | null): Promise<void> {
+  await prisma.$executeRaw`
+    UPDATE "pl_concierge_audit" SET "code" = ${code}, "outcome" = ${outcome}, "detail" = ${detail ?? null},
+      "latency_ms" = ${latencyMs ?? null}, "updated_at" = NOW()
+    WHERE "id" = ${id}`
+}
