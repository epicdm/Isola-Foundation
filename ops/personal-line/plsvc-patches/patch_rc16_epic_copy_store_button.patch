@@ -0,0 +1,52 @@
+/**
+ * rc16e: launch scope wording (PM 2026-10-11, reconciled with ev-owner-confirms-incoming-call-5099-2026-10-11).
+ * The offer covers OUTGOING calling. Customer-facing launch copy must (a) say exactly that, (b) never CLAIM that calls are
+ * received, and (c) never make the unsupported BLANKET assertion that incoming calls are unavailable (one incoming ring was owner-
+ * confirmed on a test line; incoming is simply not part of this offer and is not renewed-investigated here).
+ * Production rc15 said "Calls are made and received..." (over-claim) and, elsewhere, "Incoming calls ... are not available yet".
+ * Line-based scan of the launch-path copy sources (comment lines excluded); the same scan runs on positive controls.
+ */
+import { describe, it, expect } from 'vitest'
+import { readFileSync } from 'node:fs'
+
+const SOURCES = ['../app/lib/pl-concierge/service.ts', '../app/lib/pl-concierge/signup-flow.ts']
+const SENTENCE = 'Make calls from the free Cloud Softphone app. This launch offer covers outgoing calling.'
+const RECEIVE_CLAIM = /(made and received|receive (your )?calls (in|on|from)|calls? (are|is) received)/i
+const BLANKET_UNAVAILABLE = /incoming calls[^.`'"]*(are )?not available|receiving calls[^.`'"]*not available/i
+// the only allowed mention: the inbound-enabled branch in signup-flow.ts, gated on f.inbound_enabled
+const ALLOWED = /rings in Cloud Softphone now/
+
+const codeLines = (text: string) => text.split('\n').filter(l => !/^\s*(\/\/|\*|\/\*)/.test(l))
+const offenders = (text: string, re: RegExp) => codeLines(text).filter(l => re.test(l) && !ALLOWED.test(l))
+const read = (rel: string) => readFileSync(new URL(rel, import.meta.url), 'utf8')
+
+describe('launch-scope wording: outgoing calling offer, no receive claim, no blanket "incoming unavailable"', () => {
+  it('flows/launch body (new customer) and the Flow WELCOME offer use the approved sentence', () => {
+    const body = codeLines(read(SOURCES[0])).find(l => l.includes('Free trial: ${o.trial_days}'))
+    const welcome = codeLines(read(SOURCES[1])).find(l => l.includes("screen: 'WELCOME'") && l.includes('Free trial: ${o.trial_days}'))
+    expect(body).toContain(SENTENCE)
+    expect(welcome).toContain(SENTENCE)
+  })
+  it('no launch-path code line claims calls are received or asserts incoming is unavailable', () => {
+    for (const s of SOURCES) {
+      expect({ s, claims: offenders(read(s), RECEIVE_CLAIM) }).toEqual({ s, claims: [] })
+      expect({ s, blanket: offenders(read(s), BLANKET_UNAVAILABLE) }).toEqual({ s, blanket: [] })
+    }
+  })
+  it('CONNECTED copy (outbound, inbound flag off) says the offer covers outgoing calling', () => {
+    const line = codeLines(read(SOURCES[1])).find(l => l.includes('Cloud Softphone is connected. You can make calls now'))
+    expect(line).toBeDefined()
+    expect(line).toContain('This launch offer covers outgoing calling.')
+  })
+  it('CONTROL: both scans fire on the old production lines and ignore comments / the new copy', () => {
+    const oldClaim = "    : `Free trial: ${o.trial_days} days. Calls are made and received in the free Cloud Softphone app. ${X}`"
+    const oldBlanket = "        : `Cloud Softphone is connected. Incoming calls to your number${did} are not available yet - we'll message you when they are.`"
+    const fixed = "    : `Free trial. Make calls from the free Cloud Softphone app. This launch offer covers outgoing calling. ${X}`"
+    const comment = '  // Incoming calls are not available yet - old copy'
+    expect(offenders(oldClaim, RECEIVE_CLAIM)).toHaveLength(1)
+    expect(offenders(oldBlanket, BLANKET_UNAVAILABLE)).toHaveLength(1)
+    expect(offenders(fixed, RECEIVE_CLAIM)).toHaveLength(0)
+    expect(offenders(fixed, BLANKET_UNAVAILABLE)).toHaveLength(0)
+    expect(offenders(comment, BLANKET_UNAVAILABLE)).toHaveLength(0)
+  })
+})
