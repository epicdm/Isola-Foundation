+/**
+ * pl-concierge/eligibility.ts - ask the PL action adapter whether a customer-facing WhatsApp message may be put in front of a
+ * verified wa_id RIGHT NOW (rc16g; owner decision 2026-10-11 "route via adapter first").
+ *
+ * Why the adapter: it sits next to Chatwoot and owns the three facts this service cannot read - whether a person holds the
+ * conversation (status pending vs open), the adapter's own STOP preference, and the customer's real last inbound message (the 24 h
+ * service window). It answers {eligible, reason} and sends NOTHING. Same signing pattern as proactive.ts: the PL concierge key both
+ * services already hold, an HMAC under its OWN purpose label ('pl-eligibility-v1'), iat +-120 s and a single-use nonce - no new
+ * credential. The conversation is NOT supplied by us: the adapter finds it from the exact numeric wa_id (never trusting a caller's
+ * conversation id); `ref` (the Flow token's `cw` rid) is correlation only.
+ *
+ * FAIL CLOSED: not configured, timeout, transport error, non-200, malformed answer, an unknown reason - all are `eligible:false`.
+ * There is NO retry (a retry would be a new request with a new nonce, and the caller's Flow answer must not wait on it). Never throws.
+ */
+import { createHmac, randomBytes } from 'crypto'
+import { readConfig } from '@/app/lib/pl-concierge/config'
+
+export const ELIGIBILITY_PURPOSE = 'pl-eligibility-v1'
+export const ELIGIBILITY_TIMEOUT_MS = 1500
+export type EligibilityReason = 'ok' | 'human_owned' | 'stopped' | 'window_closed' | 'window_unknown' | 'consent_unknown' | 'no_conversation' | 'unavailable' | 'not_configured' | 'adapter_error'
+export interface EligibilityResult { eligible: boolean; reason: EligibilityReason; detail?: string; conversationId?: string }
+
+const KNOWN: EligibilityReason[] = ['ok', 'human_owned', 'stopped', 'window_closed', 'window_unknown', 'consent_unknown', 'no_conversation', 'unavailable']
+
+export function signEligibility(key: string, body: string): string {
+  return createHmac('sha256', Buffer.from(key, 'utf8')).update(`${ELIGIBILITY_PURPOSE}.${body}`, 'utf8').digest('base64url')
+}
+
+export async function askAdapterEligibility(args: { waId: string; ref?: string }, env: NodeJS.ProcessEnv = process.env, f: typeof fetch = fetch, timeoutMs = ELIGIBILITY_TIMEOUT_MS): Promise<EligibilityResult> {
+  const base = (env.PL_ADAPTER_URL ?? '').replace(/\/+$/, '')
+  const cfg = readConfig(env)
+  const kid = cfg.currentKid
+  if (!base || !kid || !cfg.keys[kid]) return { eligible: false, reason: 'not_configured', detail: !base ? 'PL_ADAPTER_URL' : 'pl_key' }
+  const waId = String(args.waId).replace(/\D/g, '')
+  if (!/^[1-9][0-9]{6,15}$/.test(waId)) return { eligible: false, reason: 'adapter_error', detail: 'bad_wa_id' }
+  const ref = typeof args.ref === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(args.ref) ? args.ref : undefined
+  const body = JSON.stringify({ kid, wa_id: waId, ...(ref ? { ref } : {}), iat: Math.floor(Date.now() / 1000), nonce: randomBytes(16).toString('base64url') })
+  try {
+    const r = await f(`${base}/v1/eligibility`, {
+      method: 'POST', headers: { 'content-type': 'application/json', 'x-pl-eligibility-signature': signEligibility(cfg.keys[kid], body) },
+      body, signal: AbortSignal.timeout(timeoutMs),
+    })
+    const j: any = await r.json().catch(() => null)
+    if (!r.ok || typeof j?.eligible !== 'boolean' || typeof j?.reason !== 'string') return { eligible: false, reason: 'adapter_error', detail: `http_${r.status}` }
+    const reason = (KNOWN as string[]).includes(j.reason) ? (j.reason as EligibilityReason) : 'adapter_error'
+    // eligible only when the adapter says so AND says it plainly: {eligible:true} with any other reason is not trusted.
+    const eligible = j.eligible === true && reason === 'ok'
+    return { eligible, reason: eligible ? 'ok' : reason === 'ok' ? 'adapter_error' : reason, detail: typeof j.detail === 'string' ? j.detail.slice(0, 80) : undefined, conversationId: typeof j.conversation_id === 'string' ? j.conversation_id.slice(0, 20) : undefined }
+  } catch (e: any) {
+    return { eligible: false, reason: 'unavailable', detail: `transport:${String(e?.name ?? 'error').slice(0, 40)}` }
+  }
+}
