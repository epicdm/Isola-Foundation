+  })
+  it('every adapter refusal leaves its own distinguishable audit row, never a claim or a send', async () => {
+    WINDOW_OK()
+    adapterSays(false, 'human_owned'); await tap(A, 'ios', 'a'); adapterSays(false, 'stopped'); await tap(A, 'ios', 'b'); adapterSays(false, 'window_closed'); await tap(A, 'ios', 'c')
+    S.adapter = 'throw'; await tap(A, 'ios', 'd')
+    expect(S.audits.map(x => x.code)).toEqual(['store_button_human_owned', 'store_button_stopped', 'store_button_window_closed', 'store_button_eligibility_unavailable'])
