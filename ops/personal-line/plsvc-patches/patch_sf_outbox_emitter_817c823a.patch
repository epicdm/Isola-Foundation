@@ -0,0 +1,50 @@
+/**
+ * /api/cron/sf-outbox — the Personal Line -> SeldonFrame outbox deliverer + its operator commands.
+ *
+ *   GET  /api/cron/sf-outbox            one tick: sweep for first calls, then claim + deliver due rows (lock-guarded)
+ *   GET  /api/cron/sf-outbox?counts=1   counters only (pending / delivered / dead); runs nothing
+ *   POST /api/cron/sf-outbox            JSON {"op":"backfill","account":"<id>","limit":25,"dryRun":true|false,"liveReads":true|false}
+ *                                       or   {"op":"requeue","account":"<id>?"}  (dead rows -> pending)
+ *
+ * Auth: x-cron-secret header (CRON_SECRET), the same helper as every cron under app/api/cron/*. Fails closed. No scheduler is
+ * pointed at this route by this change; on production it stays dark until the owner enables the outbox
+ * (PL_SF_OUTBOX_ENABLED=true) AND points a scheduler at it. Backfill is a DRY RUN unless dryRun is explicitly false.
+ */
+import { NextResponse } from 'next/server'
+import { cronAuthorized } from '@/app/lib/cron-auth'
+import { sfOutboxEnabled } from '@/app/lib/pl-concierge/sf-outbox'
+import { outboxCounts, requeueDead, runSfOutboxTick } from '@/app/lib/pl-concierge/sf-outbox-deliver'
+import { backfillAccounts, sweepFirstCalls } from '@/app/lib/pl-concierge/sf-emit'
+
+export const dynamic = 'force-dynamic'
+
+export async function GET(req: Request) {
+  if (!cronAuthorized(req)) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+  if (new URL(req.url).searchParams.get('counts')) {
+    if (!sfOutboxEnabled()) return NextResponse.json({ enabled: false })
+    return NextResponse.json({ enabled: true, ...(await outboxCounts()) })
+  }
+  const sweep = sfOutboxEnabled() && process.env.PL_SF_FIRST_CALL_SWEEP !== 'false'
+    ? await sweepFirstCalls().catch((e: any) => ({ error: String(e?.message ?? e).slice(0, 120) }))
+    : null
+  const tick = await runSfOutboxTick()
+  return NextResponse.json({ sweep, tick })
+}
+
+export async function POST(req: Request) {
+  if (!cronAuthorized(req)) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+  if (!sfOutboxEnabled()) return NextResponse.json({ error: 'outbox_disabled' }, { status: 409 })
+  const b: any = await req.json().catch(() => null)
+  if (!b || typeof b !== 'object') return NextResponse.json({ error: 'bad_body' }, { status: 400 })
+  if (b.op === 'backfill') {
+    const r = await backfillAccounts({
+      accountId: typeof b.account === 'string' ? b.account : undefined,
+      limit: typeof b.limit === 'number' ? b.limit : undefined,
+      dryRun: b.dryRun === false ? false : true,
+      liveReads: b.liveReads === false ? false : true,
+    })
+    return NextResponse.json(r)
+  }
+  if (b.op === 'requeue') return NextResponse.json({ requeued: await requeueDead(undefined, typeof b.account === 'string' ? b.account : undefined) })
+  return NextResponse.json({ error: 'unknown_op' }, { status: 400 })
+}
