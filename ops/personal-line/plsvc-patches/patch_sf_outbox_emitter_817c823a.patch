index 49f48a64..3a4ef161 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -2373,3 +2373,30 @@ model PlConciergeAudit {
   @@index([createdAt])
   @@map("pl_concierge_audit")
 }
+
+/// Personal Line -> SeldonFrame journey-event outbox (slice 2a item 4). One row per outbound lifecycle event, enqueued in the
+/// SAME transaction as the engine change that causes it (app/lib/pl-concierge/sf-outbox.ts). Delivered by a lock-guarded tick
+/// (sf-outbox-deliver.ts). `version` is monotonic per account (assigned under a per-account advisory lock). Written and claimed
+/// with raw SQL (INSERT ... ON CONFLICT DO NOTHING; UPDATE ... FOR UPDATE SKIP LOCKED RETURNING), so the model exists for
+/// migration/diff and for reads. Migration: 20261011230000_add_sf_event_outbox.
+model SfEventOutbox {
+  eventId       String    @id @map("event_id") @db.Uuid
+  dedupeKey     String    @unique @map("dedupe_key")
+  type          String
+  plAccountId   String    @map("pl_account_id")
+  version       Int
+  occurredAt    DateTime  @map("occurred_at")
+  payload       Json
+  attempts      Int       @default(0)
+  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
+  deliveredAt   DateTime? @map("delivered_at")
+  deadAt        DateTime? @map("dead_at")
+  lastStatus    Int?      @map("last_status")
+  lastError     String?   @map("last_error")
+  createdAt     DateTime  @default(now()) @map("created_at")
+
+  @@unique([plAccountId, version])
+  @@index([deliveredAt, deadAt, nextAttemptAt])
+  @@index([type, createdAt])
+  @@map("sf_event_outbox")
+}
