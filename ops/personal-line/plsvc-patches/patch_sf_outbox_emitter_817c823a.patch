+  it('HMAC-SHA256 over "<ts>.<raw body>", base64url — independently recomputed here', () => {
+    const want = createHmac('sha256', Buffer.from(KEY, 'utf8')).update(`1800000000.${body}`, 'utf8').digest('base64url')
+    expect(signIngress(KEY, 1_800_000_000, body)).toBe(want)
+    expect(want).toMatch(/^[A-Za-z0-9_-]{43}$/)
+  })
+  it('CROSS-REPO VECTOR (value produced by the receiver\'s own signIngress on deepseek, see Port evidence)', () => {
