+vi.mock('@/app/lib/lite-odoo-partner', () => ({ ensureOdooPartnerForLine: async () => ({ outcome: 'skipped_test_identity' }) }))
+vi.mock('@/app/lib/lite-callback-trial', () => ({ grantCallbackTrial: async () => ({ ok: false, alreadyGranted: false, error: 'grants_paused' }) }))
+vi.mock('@/app/lib/lite-seat-bind', () => ({ bindPersonalLineSeatWithRetry: async () => ({ ok: true, attempts: 1 }), recordSeatBindOutcome: async () => {} }))
+vi.mock('@/app/lib/lite-signup-trial', () => ({ grantSignupTrial: async () => ({ outcome: 'skipped', reason: 'realpg-smoke' }), readConfirmedSignupTrial: async () => null }))
