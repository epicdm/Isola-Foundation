+vi.mock('@/app/lib/lite-registration-followups', () => ({ deliverRegistrationFollowup: async () => ({ ok: true }), deliverFirstCallFollowup: async () => ({ ok: true }) }))
+
+import { PrismaClient } from '@prisma/client'
