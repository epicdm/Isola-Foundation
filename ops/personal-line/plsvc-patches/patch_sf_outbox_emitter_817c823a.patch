+/**
+ * pl-concierge/sf-outbox.ts — the Personal Line -> SeldonFrame journey-event OUTBOX: types, pure helpers, signing and the
+ * transactional ENQUEUE (slice 2a item 4; contract: Isola-Foundation ops/personal-line/specs/pl-journey-events-contract-v1.md;
+ * receiver: epicdm/isola-seldonframe lib/personal-line/events.ts + signing.ts — this file matches them exactly).
+ *
+ * SHAPE OF THE GUARANTEE
+ *   - An event row is written IN THE SAME TRANSACTION as the engine change that causes it (`enqueueSfEvent(tx, …)` takes the
+ *     caller's interactive-transaction client). A rolled-back engine change leaves no outbox row; a committed one always has it.
+ *   - ENQUEUE NEVER BLOCKS THE ENGINE: `enqueueSfEventSafe` runs under a SAVEPOINT, so a failing insert (table missing, bad
+ *     fact) is rolled back to the savepoint and logged loudly — the engine change still commits and the backfill repairs the gap.
+ *   - IDEMPOTENT: `dedupe_key` is the logical identity of an event; `event_id` is a pure function of it, so the same logical
+ *     event is the same uuid forever and the receiver's inbox (org, provider, event_id) dedupes a redelivery.
+ *   - VERSION is monotonic per account: MAX(version)+1 under a per-account advisory lock taken in the enqueueing transaction.
+ *   - OFF BY DEFAULT: nothing is written unless PL_SF_OUTBOX_ENABLED=true, so shipping this code before the migration is
+ *     applied cannot break provisioning.
+ *
+ * TYPES. The contract's receiver accepts exactly: pl.line_created, pl.app_activated, pl.registration_changed, pl.first_call,
+ * pl.plan_purchased. The wider list (signup_started, trial_ending, trial_expired) is DEFINED here because the PM list names it,
+ * but the receiver answers 422 for them (a lead is the native intake form; a trial is a plan fact carried by line_created /
+ * backfill) and NOTHING emits them. pl.plan_purchased is defined and has no emitter (no payment provider: Fiserv is blocked).
+ */
+import { createHash, createHmac } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { MIN_KEY_BYTES } from '@/app/lib/pl-concierge/assertion'
+
+export const SF_EVENT_TYPES = [
+  'pl.signup_started', 'pl.line_created', 'pl.app_activated', 'pl.registration_changed',
+  'pl.first_call', 'pl.trial_ending', 'pl.trial_expired', 'pl.plan_purchased',
+] as const
+export type SfEventType = (typeof SF_EVENT_TYPES)[number]
+/** What this service may enqueue. Every one has exactly one authoritative source (see sf-emit.ts). */
+export const SF_EMITTABLE_TYPES = ['pl.line_created', 'pl.app_activated', 'pl.registration_changed', 'pl.first_call'] as const
+export type SfEmittableType = (typeof SF_EMITTABLE_TYPES)[number]
+/** What the SeldonFrame receiver accepts today (events.ts PL_EVENT_TYPES). */
+export const SF_RECEIVER_TYPES: readonly string[] = ['pl.line_created', 'pl.app_activated', 'pl.registration_changed', 'pl.first_call', 'pl.plan_purchased']
+
+export type SfRegistrationNow = 'registered' | 'not_registered' | 'unknown'
+export interface SfFacts {
+  plan?: string
+  trial_end?: string
+  registration_now?: SfRegistrationNow
+  activated_at?: string
+  first_call_at?: string
+  did_masked?: string
+}
+const FACT_KEYS = ['plan', 'trial_end', 'registration_now', 'activated_at', 'first_call_at', 'did_masked'] as const
+
+const isIso = (v: unknown) => typeof v === 'string' && v.length <= 40 && Number.isFinite(Date.parse(v))
+const ACCOUNT_RE = /^[A-Za-z0-9_-]{1,64}$/
+
+export function sfOutboxEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  return (env.PL_SF_OUTBOX_ENABLED ?? '').trim().toLowerCase() === 'true'
+}
+
+/** Pure: the same logical event is the same uuid. (Not an RFC 4122 v5 — a sha256-derived value with the version/variant bits set.) */
+export function eventIdFor(dedupeKey: string): string {
+  const h = createHash('sha256').update(`pl-sf-event-v1:${dedupeKey}`, 'utf8').digest()
+  h[6] = (h[6] & 0x0f) | 0x50
+  h[8] = (h[8] & 0x3f) | 0x80
+  const x = h.subarray(0, 16).toString('hex')
+  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20, 32)}`
+}
+
+/** `+1767…5099` -> `+1 767 *** 5099` shaped for the receiver's did_masked pattern (^[+0-9 *]{4,24}$). Never the full number. */
+export function maskDid(did: string | null | undefined): string | undefined {
+  const d = String(did ?? '').replace(/\D/g, '')
+  if (d.length < 8) return undefined
+  return `+${d.slice(0, d.length - 7)} *** ${d.slice(-4)}`
+}
+
+/** Pure: facts as the contract allows — only known keys, typed; returns the cleaned object or the reason it is invalid. */
+export function cleanFacts(type: SfEventType, raw: Record<string, unknown>): { ok: true; facts: SfFacts } | { ok: false; why: string } {
+  const f: Record<string, unknown> = {}
+  for (const k of FACT_KEYS) if (raw[k] !== undefined && raw[k] !== null) f[k] = raw[k]
+  if (f.plan !== undefined && (typeof f.plan !== 'string' || !/^[a-z0-9_]{1,32}$/.test(f.plan))) return { ok: false, why: 'bad_plan' }
+  for (const k of ['trial_end', 'activated_at', 'first_call_at'] as const) if (f[k] !== undefined && !isIso(f[k])) return { ok: false, why: `bad_${k}` }
+  if (f.registration_now !== undefined && !['registered', 'not_registered', 'unknown'].includes(f.registration_now as string)) return { ok: false, why: 'bad_registration_now' }
+  if (f.did_masked !== undefined && (typeof f.did_masked !== 'string' || !/^[+0-9 *]{4,24}$/.test(f.did_masked))) return { ok: false, why: 'bad_did_masked' }
+  // Each type must carry the proof fact its single source establishes (the receiver refuses it otherwise).
+  if (type === 'pl.app_activated' && (f.registration_now !== 'registered' || !isIso(f.activated_at))) return { ok: false, why: 'app_activated_needs_registered_and_activated_at' }
+  if (type === 'pl.registration_changed' && f.registration_now === undefined) return { ok: false, why: 'registration_changed_needs_registration_now' }
+  if (type === 'pl.first_call' && !isIso(f.first_call_at)) return { ok: false, why: 'first_call_needs_first_call_at' }
+  return { ok: true, facts: f as SfFacts }
+}
+
+// ── signing + body (exactly the receiver's signing.ts / events.ts) ────────────────────────────────────────────────────────
+export function signIngress(key: string, ts: number, rawBody: string): string {
+  return createHmac('sha256', Buffer.from(key, 'utf8')).update(`${ts}.${rawBody}`, 'utf8').digest('base64url')
+}
+
+export interface SfEventRow {
+  eventId: string
+  type: string
+  plAccountId: string
+  version: number
+  occurredAt: Date
+  facts: Record<string, unknown>
+}
+
+/** The exact JSON the receiver parses (strict keys; <= 4096 bytes). Returns null when it cannot be a valid body. */
+export function buildIngressBody(row: SfEventRow, waId: string): string | null {
+  if (!/^[1-9][0-9]{6,15}$/.test(waId)) return null
+  if (!ACCOUNT_RE.test(row.plAccountId)) return null
+  const facts: Record<string, unknown> = {}
+  for (const k of FACT_KEYS) if (row.facts[k] !== undefined && row.facts[k] !== null) facts[k] = row.facts[k]
+  const body = JSON.stringify({
+    event_id: row.eventId, type: row.type, occurred_at: row.occurredAt.toISOString(), version: row.version,
+    pl_account_id: row.plAccountId, wa_id: waId, facts,
+  })
+  return Buffer.byteLength(body, 'utf8') <= 4096 ? body : null
+}
+
+export function ingressHeaders(kid: string, key: string, ts: number, rawBody: string): Record<string, string> {
+  return { 'content-type': 'application/json', 'x-pl-sf-kid': kid, 'x-pl-sf-ts': String(ts), 'x-pl-sf-sig': signIngress(key, ts, rawBody) }
+}
+
+// ── delivery config (names only; the key is a Swarm secret FILE, never printed) ──────────────────────────────────────────
+export interface SfEventsConfig { url: string | null; kid: string; key: string | null; misconfig: string[] }
+
+/**
+ * PL_SF_EVENTS_URL       full webhook URL incl. the workspace id: https://<fork>/api/webhooks/personal-line/<workspaceId>
+ * PL_SF_EVENTS_KID       key id (default "sf1"); must equal the kid the workspace's integration was saved with
+ * PL_SF_EVENTS_KEY(_FILE) the workspace's "personal-line-events" secret (>= 32 bytes); the FILE form is the Swarm-secret pattern
+ */
+export function readSfEventsConfig(env: NodeJS.ProcessEnv = process.env, readFile: (p: string) => string = p => readFileSync(p, 'utf8')): SfEventsConfig {
+  const kid = (env.PL_SF_EVENTS_KID ?? 'sf1').trim()
+  let key = env.PL_SF_EVENTS_KEY ?? ''
+  if (!key && env.PL_SF_EVENTS_KEY_FILE) {
+    try { key = readFile(env.PL_SF_EVENTS_KEY_FILE).trim() } catch { key = '' }
+  }
+  const misconfig: string[] = []
+  let url: string | null = null
+  try {
+    const u = new URL(env.PL_SF_EVENTS_URL ?? '')
+    if (u.protocol === 'https:' || u.protocol === 'http:') url = u.toString()
+    else misconfig.push('PL_SF_EVENTS_URL')
+  } catch { misconfig.push('PL_SF_EVENTS_URL') }
+  if (!/^[a-z0-9]{1,16}$/.test(kid)) misconfig.push('PL_SF_EVENTS_KID')
+  if (Buffer.byteLength(key, 'utf8') < MIN_KEY_BYTES) misconfig.push('PL_SF_EVENTS_KEY')
+  return { url: misconfig.length === 0 ? url : null, kid, key: misconfig.length === 0 ? key : null, misconfig }
+}
+
+// ── retry policy ──────────────────────────────────────────────────────────────────────────────────────────────────────────
+export const SF_BASE_BACKOFF_MS = 30_000
+export const SF_MAX_BACKOFF_MS = 6 * 3_600_000
+export const SF_MAX_ATTEMPTS = 15
+
+/** Pure: exponential from 30 s, capped at 6 h, with jitter in [0.5, 1.0] of the step. `attempts` = tries made so far (>= 1). */
+export function backoffMs(attempts: number, rand: number): number {
+  const step = Math.min(SF_MAX_BACKOFF_MS, SF_BASE_BACKOFF_MS * 2 ** Math.max(0, attempts - 1))
+  return Math.round(step * (0.5 + 0.5 * Math.min(1, Math.max(0, rand))))
+}
+
+export type Verdict = { kind: 'delivered'; note: string } | { kind: 'retry'; error: string } | { kind: 'dead'; error: string }
+
+/**
+ * Pure: what an HTTP outcome means. A 2xx is delivered — a duplicate-event 200 included (the receiver answers 200 {status:'duplicate'}
+ * and an older version 200 with factsApplied=false: both are the receiver having the event). Timeouts, network errors, 408/425/429 and
+ * 5xx (the receiver's 503 "not configured" included) are retried. Every other 4xx is a permanent refusal: dead-lettered, visible.
+ */
+export function classifyHttp(status: number | null, bodyText: string | null, netError?: string): Verdict {
+  if (status === null) return { kind: 'retry', error: netError ?? 'network_error' }
+  if (status >= 200 && status < 300) {
+    let note = 'delivered'
+    try { const j = JSON.parse(bodyText ?? '{}'); if (j?.status === 'duplicate') note = 'duplicate'; else if (j?.factsApplied === false) note = 'stale_kept' } catch { /* body is informational */ }
+    return { kind: 'delivered', note }
+  }
+  let code = ''
+  try { const j = JSON.parse(bodyText ?? '{}'); if (typeof j?.error === 'string' && /^[a-z_]{1,48}$/.test(j.error)) code = `:${j.error}` } catch { /* ignore */ }
+  const err = `http_${status}${code}`
+  if (status === 408 || status === 425 || status === 429 || status >= 500) return { kind: 'retry', error: err }
+  return { kind: 'dead', error: err }
+}
+
+// ── transactional enqueue ─────────────────────────────────────────────────────────────────────────────────────────────────
+/** The slice of a Prisma interactive-transaction client this module needs (raw tagged templates only). */
+export interface SfTx {
+  $executeRaw(strings: TemplateStringsArray, ...values: unknown[]): Promise<number>
+  $queryRaw<T = unknown>(strings: TemplateStringsArray, ...values: unknown[]): Promise<T>
+}
+
+export interface EnqueueInput {
+  type: SfEmittableType
+  plAccountId: string
+  /** The logical identity of this event; the same key is the same event forever. */
+  dedupeKey: string
+  occurredAt: Date
+  facts: Record<string, unknown>
+}
+export type EnqueueResult = { enqueued: true; eventId: string; version: number } | { enqueued: false; eventId: string; reason: 'duplicate' | 'disabled' | 'invalid' | 'error'; detail?: string }
+
+export async function enqueueSfEvent(tx: SfTx, input: EnqueueInput, env: NodeJS.ProcessEnv = process.env): Promise<EnqueueResult> {
+  const eventId = eventIdFor(input.dedupeKey)
+  if (!sfOutboxEnabled(env)) return { enqueued: false, eventId, reason: 'disabled' }
+  if (!(SF_EMITTABLE_TYPES as readonly string[]).includes(input.type)) return { enqueued: false, eventId, reason: 'invalid', detail: 'type_not_emittable' }
+  if (!ACCOUNT_RE.test(input.plAccountId) || !input.dedupeKey || input.dedupeKey.length > 200) return { enqueued: false, eventId, reason: 'invalid', detail: 'bad_identity' }
+  const c = cleanFacts(input.type, input.facts)
+  if (c.ok === false) return { enqueued: false, eventId, reason: 'invalid', detail: (c as { ok: false; why: string }).why }
+  const occurredIso = input.occurredAt.toISOString()
+  const payload = JSON.stringify((c as { ok: true; facts: SfFacts }).facts)
+  // Serialise version assignment per account for the rest of THIS transaction (xact-scoped: released on commit/rollback).
+  await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtextextended(${'sf-outbox:' + input.plAccountId}, 0))`
+  const rows = await tx.$queryRaw<Array<{ event_id: string; version: number }>>`
+    INSERT INTO sf_event_outbox (event_id, dedupe_key, type, pl_account_id, version, occurred_at, payload)
+    SELECT ${eventId}::uuid, ${input.dedupeKey}, ${input.type}, ${input.plAccountId}, COALESCE(MAX(version), 0) + 1,
+           (${occurredIso}::timestamptz AT TIME ZONE 'UTC'), ${payload}::jsonb
+      FROM sf_event_outbox WHERE pl_account_id = ${input.plAccountId}
+    ON CONFLICT (dedupe_key) DO NOTHING
+    RETURNING event_id, version`
+  if (rows.length === 1) return { enqueued: true, eventId, version: Number(rows[0].version) }
+  return { enqueued: false, eventId, reason: 'duplicate' }
+}
+
+/**
+ * Enqueue under a SAVEPOINT: if the insert fails for any reason (the table is not there yet, a constraint, a driver error) the
+ * transaction is rolled back to the savepoint — the caller's engine change is untouched and still commits — and the failure is
+ * logged loudly (no secret, no phone). The outbox is repaired by the backfill; it must never cost a customer their line.
+ */
+export async function enqueueSfEventSafe(tx: SfTx, input: EnqueueInput, env: NodeJS.ProcessEnv = process.env): Promise<EnqueueResult> {
+  if (!sfOutboxEnabled(env)) return { enqueued: false, eventId: eventIdFor(input.dedupeKey), reason: 'disabled' }
+  await tx.$executeRaw`SAVEPOINT sf_outbox_sp`
+  try {
+    const r = await enqueueSfEvent(tx, input, env)
+    await tx.$executeRaw`RELEASE SAVEPOINT sf_outbox_sp`
+    return r
+  } catch (e: any) {
+    await tx.$executeRaw`ROLLBACK TO SAVEPOINT sf_outbox_sp`.catch(() => 0)
+    console.error(`[sf-outbox] ENQUEUE FAILED type=${input.type} account=${input.plAccountId}: ${String(e?.message ?? e).slice(0, 160)} — engine change kept; run the backfill to repair`)
+    return { enqueued: false, eventId: eventIdFor(input.dedupeKey), reason: 'error', detail: String(e?.message ?? e).slice(0, 160) }
+  }
+}
