+/**
+ * /api/cron/sf-outbox auth + command routing. Every refusal runs the SAME harness as its positive twin and proves the work was NOT
+ * done (Laws 19/28). The tick, sweep and backfill are mocked at the module boundary; their behaviour is proven elsewhere.
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+
+const T = vi.hoisted(() => ({
+  tick: vi.fn(async () => ({ ran: true, delivered: 1 })), sweep: vi.fn(async () => ({ checked: 0, found: 0 })),
+  backfill: vi.fn(async (o: any) => ({ dryRun: o.dryRun, accounts: [] })), requeue: vi.fn(async () => 2), counts: vi.fn(async () => ({ pending: 1, delivered: 2, dead: 0 })),
+}))
+vi.mock('@/app/lib/pl-concierge/sf-outbox-deliver', () => ({ runSfOutboxTick: T.tick, requeueDead: T.requeue, outboxCounts: T.counts }))
+vi.mock('@/app/lib/pl-concierge/sf-emit', () => ({ sweepFirstCalls: T.sweep, backfillAccounts: T.backfill }))
+
+const SECRET = ['unit', 'cron', 'secret', '0123456789abcdef'].join('-')
+const U = 'http://127.0.0.1:3005/api/cron/sf-outbox'
+const req = (method: string, headers: Record<string, string> = {}, body?: unknown, qs = '') =>
+  new Request(U + qs, { method, headers: { ...(body ? { 'content-type': 'application/json' } : {}), ...headers }, body: body ? JSON.stringify(body) : undefined })
+
+beforeEach(() => { vi.clearAllMocks(); vi.stubEnv('CRON_SECRET', SECRET); vi.stubEnv('PL_SF_OUTBOX_ENABLED', 'true') })
+afterEach(() => { vi.unstubAllEnvs() })
+
+describe('sf-outbox cron route', () => {
+  it('POSITIVE: the x-cron-secret header runs sweep + tick (200)', async () => {
+    const { GET } = await import('@/app/api/cron/sf-outbox/route')
+    const res = await GET(req('GET', { 'x-cron-secret': SECRET }))
+    expect(res.status).toBe(200); expect(T.tick).toHaveBeenCalledTimes(1); expect(T.sweep).toHaveBeenCalledTimes(1)
+  })
+  it('refused, nothing run: no credential / wrong header — GET and POST', async () => {
+    const { GET, POST } = await import('@/app/api/cron/sf-outbox/route')
+    for (const h of [{}, { 'x-cron-secret': 'nope' }]) {
+      expect((await GET(req('GET', h))).status).toBe(401)
+      expect((await POST(req('POST', h, { op: 'backfill' }))).status).toBe(401)
+    }
+    expect(T.tick).not.toHaveBeenCalled(); expect(T.backfill).not.toHaveBeenCalled(); expect(T.requeue).not.toHaveBeenCalled()
+  })
+  it('counts=1 runs nothing (control: the tick ran in the first test)', async () => {
+    const { GET } = await import('@/app/api/cron/sf-outbox/route')
+    const res = await GET(req('GET', { 'x-cron-secret': SECRET }, undefined, '?counts=1'))
+    expect(await res.json()).toEqual({ enabled: true, pending: 1, delivered: 2, dead: 0 }); expect(T.tick).not.toHaveBeenCalled()
+  })
+  it('backfill is a DRY RUN unless dryRun is exactly false', async () => {
+    const { POST } = await import('@/app/api/cron/sf-outbox/route')
+    await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'backfill', account: 'accA' }))
+    expect(T.backfill).toHaveBeenLastCalledWith(expect.objectContaining({ accountId: 'accA', dryRun: true }))
+    await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'backfill', account: 'accA', dryRun: 'false' }))
+    expect(T.backfill).toHaveBeenLastCalledWith(expect.objectContaining({ dryRun: true }))
+    await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'backfill', account: 'accA', dryRun: false }))
+    expect(T.backfill).toHaveBeenLastCalledWith(expect.objectContaining({ dryRun: false }))
+  })
+  it('requeue works; unknown op 400; disabled outbox 409 and nothing runs', async () => {
+    const { POST } = await import('@/app/api/cron/sf-outbox/route')
+    expect(await (await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'requeue' }))).json()).toEqual({ requeued: 2 })
+    expect((await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'wat' }))).status).toBe(400)
+    vi.stubEnv('PL_SF_OUTBOX_ENABLED', 'false')
+    T.requeue.mockClear()
+    expect((await POST(req('POST', { 'x-cron-secret': SECRET }, { op: 'requeue' }))).status).toBe(409); expect(T.requeue).not.toHaveBeenCalled()
+  })
+})
