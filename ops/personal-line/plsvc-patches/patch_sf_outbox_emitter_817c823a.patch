+// ── the deliverer ────────────────────────────────────────────────────────────────────────────────────────────────────────
+type Row = ClaimedRow & { delivered?: Date; dead?: string; retryAt?: Date; lastError?: string; lastStatus?: number | null }
+function memStore(rows: Row[], phones: Record<string, string | null> = {}, held = { locked: false }): OutboxStore & { rows: Row[] } {
+  return {
+    rows,
+    async claim(now, limit) {
+      if (held.locked) return null
+      const due = rows.filter(r => !r.delivered && !r.dead && (!r.retryAt || r.retryAt <= now)).slice(0, limit)
+      for (const r of due) { r.attempts++; r.retryAt = new Date(now.getTime() + 90_000) }
+      return due.map(r => ({ ...r }))
+    },
+    async markDelivered(id, status, now) { const r = rows.find(x => x.eventId === id)!; r.delivered = now; r.lastStatus = status; r.lastError = undefined },
+    async markRetry(id, status, error, nextAt) { const r = rows.find(x => x.eventId === id)!; r.retryAt = nextAt; r.lastStatus = status; r.lastError = error },
+    async markDead(id, status, error, now) { const r = rows.find(x => x.eventId === id)!; r.dead = error; r.lastStatus = status; r.lastError = error; void now },
+    async resolveWaId(acct) { return acct in phones ? phones[acct] : '17675550101' },
+  }
+}
+const mkRow = (n: number, type = 'pl.line_created', acct = 'accA', over: Partial<ClaimedRow> = {}): Row => ({
+  eventId: eventIdFor(`k${n}`), type, plAccountId: acct, version: n, occurredAt: new Date('2026-10-11T12:00:00Z'), attempts: 0,
+  payload: type === 'pl.first_call' ? { first_call_at: '2026-10-11T12:00:00.000Z' } : { did_masked: '+1 767 *** 5001' }, ...over,
+})
+function deps(store: OutboxStore, fetchImpl: any, over: Partial<TickDeps> = {}): TickDeps {
+  let t = 1_800_000_000_000
+  return { store, fetchImpl, config: { url: 'http://fork.invalid/api/webhooks/personal-line/11111111-1111-4111-8111-111111111111', kid: 'sf1', key: KEY, misconfig: [] }, now: () => (t += 10), random: () => 1, ...over }
+}
