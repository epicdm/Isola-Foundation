+const run = Date.now().toString(36)
+const KEY = 'realpg-events-key-0123456789abcdef-012345'
+const ON = { PL_SF_OUTBOX_ENABLED: 'true' } as unknown as NodeJS.ProcessEnv
+const iso = (n = 0) => new Date(Date.UTC(2026, 9, 11, 12, 0, n))
+const rows = async (acct: string) => (await prisma.$queryRawUnsafe(`SELECT type, version, dedupe_key, delivered_at, dead_at, attempts, payload FROM sf_event_outbox WHERE pl_account_id = $1 ORDER BY version`, acct)) as any[]
+
+describe.skipIf(!URL_)('REAL Postgres: the SeldonFrame lifecycle outbox', () => {
+  let a: PrismaClient, b: PrismaClient
+  const peerServer = createServer((req, res) => { if (PEER.httpCode !== 200) { res.writeHead(PEER.httpCode); return res.end('x') } res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify({ status: PEER.status, listenerConnected: true, at: new Date().toISOString(), address: '203.0.113.7:5060', source: 'event' })) })
+  beforeAll(async () => {
+    const db = ((await prisma.$queryRawUnsafe('SELECT current_database() AS d')) as any[])[0].d
+    if (!/^lockvoid/.test(db)) throw new Error(`refusing: connected to ${db}`)
+    // the table comes from the REVIEWED MIGRATION FILE (drop first: the schema-built copy is replaced by the file under test)
+    await prisma.$executeRawUnsafe('DROP TABLE IF EXISTS sf_event_outbox')
+    const sql = readFileSync(path.join(__dirname, '..', 'prisma', 'migrations', '20261011230000_add_sf_event_outbox', 'migration.sql'), 'utf8')
+    for (const stmt of sql.split(/;\s*\n/).map(s => s.replace(/--.*$/gm, '').trim()).filter(Boolean)) await prisma.$executeRawUnsafe(stmt)
+    await prisma.$executeRawUnsafe('CREATE TABLE IF NOT EXISTS zz_engine_probe (id text PRIMARY KEY)')
+    process.env.PL_SF_OUTBOX_ENABLED = 'true'   // the emitters read the real env; individual tests flip it where they need the OFF control
+    await new Promise<void>(r => peerServer.listen(39017, '127.0.0.1', () => r()))
+    a = new PrismaClient({ adapter: new PrismaPg({ connectionString: URL_, max: 4 }) })
+    b = new PrismaClient({ adapter: new PrismaPg({ connectionString: URL_, max: 4 }) })
+  })
+  afterAll(async () => { await a?.$disconnect(); await b?.$disconnect(); peerServer.close() })
+
+  it('the migration file applies and the table starts empty with the unique constraints', async () => {
+    const r = (await prisma.$queryRawUnsafe(`SELECT count(*)::int AS n FROM sf_event_outbox`)) as any[]
+    expect(r[0].n).toBe(0)
+    const idx = ((await prisma.$queryRawUnsafe(`SELECT indexname FROM pg_indexes WHERE tablename='sf_event_outbox'`)) as any[]).map(x => x.indexname)
+    expect(idx).toEqual(expect.arrayContaining(['sf_event_outbox_pkey', 'sf_event_outbox_dedupe_key_key', 'sf_event_outbox_pl_account_id_version_key']))
+  })
+
+  it('ATOMICITY: a ROLLED-BACK engine change leaves NO outbox row; the committed twin leaves both (same harness)', async () => {
+    const acct = `atom-${run}`
+    await expect(prisma.$transaction(async (tx: any) => {
+      await tx.$executeRaw`INSERT INTO zz_engine_probe (id) VALUES (${acct + '-rb'})`
+      const r = await enqueueSfEvent(tx, { type: 'pl.line_created', plAccountId: acct, dedupeKey: `line_created:${acct}-rb`, occurredAt: iso(), facts: { did_masked: '+1767 *** 5001' } }, ON)
+      expect(r.enqueued).toBe(true)         // it WAS written inside the transaction...
+      throw new Error('engine change fails after the enqueue')
+    })).rejects.toThrow('engine change fails')
+    expect(await rows(acct)).toHaveLength(0)                                                              // ...and is gone with the rollback
+    expect(((await prisma.$queryRawUnsafe(`SELECT count(*)::int n FROM zz_engine_probe WHERE id=$1`, acct + '-rb')) as any[])[0].n).toBe(0)
+    await prisma.$transaction(async (tx: any) => {
+      await tx.$executeRaw`INSERT INTO zz_engine_probe (id) VALUES (${acct + '-ok'})`
+      await enqueueSfEvent(tx, { type: 'pl.line_created', plAccountId: acct, dedupeKey: `line_created:${acct}`, occurredAt: iso(), facts: { did_masked: '+1767 *** 5001' } }, ON)
+    })
