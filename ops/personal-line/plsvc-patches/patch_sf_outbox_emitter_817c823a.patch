diff --git a/app/lib/pl-concierge/sf-emit.ts b/app/lib/pl-concierge/sf-emit.ts
new file mode 100644
index 00000000..69372602
--- /dev/null
+++ b/app/lib/pl-concierge/sf-emit.ts
@@ -0,0 +1,180 @@
+/**
+ * pl-concierge/sf-emit.ts — WHERE the outbox events come from. Every emitter here has exactly one AUTHORITATIVE source; none
+ * infers one fact from another (an activation link opened is NOT activation; chat is never a source).
+ *
+ *   pl.line_created          provisionLine() committed the liteAccount row after the provider confirmed the line
+ *                            (hook: app/lib/lite-provision.ts, in the SAME transaction as liteAccount.create)
+ *   pl.app_activated         the first LIVE registration read that says registered (hook: lite-registration-watch.ts stamp(),
+ *                            same transaction as the account's registration stamp). Never from a link click.
+ *   pl.registration_changed  a later live read that differs from the last registration fact we told SeldonFrame
+ *                            (same hook). A failed read ('unknown') emits NOTHING — an outage is not "unregistered".
+ *   pl.first_call            an ANSWERED call with duration > 0 in the Magnus CDR (hook: lite-first-call-status.ts, where that
+ *                            CDR read already happens, plus sweepFirstCalls() for lines nobody asked about)
+ *
+ * NOT emitted: pl.signup_started / pl.trial_ending / pl.trial_expired (the receiver rejects them: a lead is the native intake
+ * form; trial facts ride on the backfill's line_created), pl.plan_purchased (no payment provider yet — Fiserv is blocked).
+ */
+import { prisma } from '@/app/lib/prisma'
+import {
+  enqueueSfEvent, enqueueSfEventSafe, maskDid, sfOutboxEnabled, type EnqueueResult, type SfTx,
+} from '@/app/lib/pl-concierge/sf-outbox'
+
+type RegDecision = { state: string; registeredAt: Date | null }
+
+/** Transaction-scoped: called from inside the caller's `prisma.$transaction`. Returns void; never throws (savepoint). */
+export async function emitLineCreated(tx: SfTx, a: { id: string; did: string | null; createdAt: Date }): Promise<EnqueueResult> {
+  return enqueueSfEventSafe(tx, {
+    type: 'pl.line_created', plAccountId: a.id, dedupeKey: `line_created:${a.id}`, occurredAt: a.createdAt,
+    facts: { did_masked: maskDid(a.did) },
+  })
+}
+
+/** The last registration fact already queued/sent for the account (what SeldonFrame currently believes). */
+async function lastRegistrationFact(tx: SfTx, acct: string): Promise<{ hasActivated: boolean; last: 'registered' | 'not_registered' | 'unknown' | null }> {
+  const rows = await tx.$queryRaw<Array<{ type: string; rn: string | null }>>`
+    SELECT type, payload->>'registration_now' AS rn FROM sf_event_outbox
+     WHERE pl_account_id = ${acct} AND type IN ('pl.app_activated', 'pl.registration_changed') ORDER BY version DESC`
+  const last = rows.length ? (rows[0].rn as 'registered' | 'not_registered' | 'unknown') : null
+  return { hasActivated: rows.some(r => r.type === 'pl.app_activated'), last }
+}
+
+/**
+ * Called from stamp() with the decision of a LIVE read. `unknown` (the read failed) and the funnel stalls that never read the
+ * peer (handoffAt null) must not reach here — the caller passes only decisions backed by a successful read.
+ */
+export async function emitRegistrationFromRead(tx: SfTx, acct: string, d: RegDecision, checkedAt: Date): Promise<EnqueueResult | null> {
+  if (d.state === 'unknown') return null
+  const now: 'registered' | 'not_registered' = d.state === 'activated' ? 'registered' : 'not_registered'
+  const { hasActivated, last } = await lastRegistrationFact(tx, acct)
+  if (now === 'registered') {
+    if (last === 'registered') return null
+    const at = d.registeredAt ?? checkedAt
+    if (!hasActivated) {
+      return enqueueSfEventSafe(tx, { type: 'pl.app_activated', plAccountId: acct, dedupeKey: `app_activated:${acct}`, occurredAt: at, facts: { registration_now: 'registered', activated_at: at.toISOString() } })
+    }
+    return enqueueSfEventSafe(tx, { type: 'pl.registration_changed', plAccountId: acct, dedupeKey: `reg:${acct}:registered:${at.getTime()}`, occurredAt: at, facts: { registration_now: 'registered' } })
+  }
+  // not registered: only a CHANGE from a registered belief is a fact worth sending (pending/never-registered is the default state)
+  if (last !== 'registered') return null
+  return enqueueSfEventSafe(tx, { type: 'pl.registration_changed', plAccountId: acct, dedupeKey: `reg:${acct}:not_registered:${checkedAt.getTime()}`, occurredAt: checkedAt, facts: { registration_now: 'not_registered' } })
+}
+
+/**
+ * A LIVE registration read for an account whose registration stamp is already final (the watch tick leaves activated accounts alone).
+ * Enqueues registration_changed only when the read differs from the last registration fact SeldonFrame was told. A failed read
+ * ('unknown') enqueues nothing. Own transaction; the caller swallows errors.
+ */
+export async function observeRegistrationForOutbox(plAccountId: string, sipUsername: string, nowMs: number, db: any = prisma): Promise<EnqueueResult | null> {
+  if (!sfOutboxEnabled()) return null
+  const { readPeerRegistration, REGISTERED } = await import('@/app/lib/lite-registration-watch')
+  const read: any = await readPeerRegistration(sipUsername)
+  if (!read?.ok) return null
+  const now = new Date(nowMs)
+  const d = REGISTERED.has(read.status) ? { state: 'activated', registeredAt: (read.at as Date | null) ?? now } : { state: 'stalled', registeredAt: null }
+  return db.$transaction((tx: any) => emitRegistrationFromRead(tx, plAccountId, d, now), { timeout: 10_000 })
+}
+
+/** The first answered call was observed live in the CDR. Idempotent (one per account, ever). Fail-soft: own transaction. */
+export async function recordFirstCallObserved(plAccountId: string, firstCallAtIso: string, db: any = prisma): Promise<EnqueueResult | null> {
+  if (!sfOutboxEnabled()) return null
+  try {
+    return await db.$transaction((tx: any) => enqueueSfEventSafe(tx, {
+      type: 'pl.first_call', plAccountId, dedupeKey: `first_call:${plAccountId}`, occurredAt: new Date(firstCallAtIso), facts: { first_call_at: new Date(firstCallAtIso).toISOString() },
+    }), { timeout: 10_000 })
+  } catch (e: any) {
+    console.error(`[sf-outbox] first_call enqueue failed account=${plAccountId}: ${String(e?.message ?? e).slice(0, 120)}`)
+    return null
+  }
+}
+
+/**
+ * Lines that have a line_created event, no first_call yet, created in the last 7 days: ask the CDR (via getFirstCallStatus, which
+ * itself calls recordFirstCallObserved). Bounded per tick; one Magnus read each. Returns how many were checked.
+ */
+export async function sweepFirstCalls(limit = 10, db: any = prisma): Promise<{ checked: number; found: number }> {
+  if (!sfOutboxEnabled()) return { checked: 0, found: 0 }
+  const rows: Array<{ pl_account_id: string }> = await db.$queryRaw`
+    SELECT o.pl_account_id FROM sf_event_outbox o
+     WHERE o.type = 'pl.line_created' AND o.created_at > now() - interval '7 days'
+       AND NOT EXISTS (SELECT 1 FROM sf_event_outbox f WHERE f.pl_account_id = o.pl_account_id AND f.type = 'pl.first_call')
+     ORDER BY o.created_at DESC LIMIT ${limit}`
+  const { getFirstCallStatus } = await import('@/app/lib/lite-first-call-status')
+  let found = 0
+  for (const r of rows) {
+    const a = await db.liteAccount.findUnique({ where: { id: r.pl_account_id }, select: { userId: true } }).catch(() => null)
+    if (!a) continue
+    const fc: any = await getFirstCallStatus(a.userId, { emit: false }).catch(() => null)
+    if (fc?.firstCallSucceeded) found++
+  }
+  return { checked: rows.length, found }
+}
+
+// ── BACKFILL: replay CURRENT state as events (also how lines that pre-date the integration get linked) ──────────────────
+export interface BackfillOptions { accountId?: string; limit?: number; dryRun?: boolean; liveReads?: boolean }
+export interface BackfillAccountResult { accountId: string; planned: string[]; enqueued: string[]; already: string[]; error?: string }
+
+/**
+ * Versions are consistent by construction: every event for an account is appended at MAX(version)+1 under the same per-account
+ * lock the live emitters use, and the dedupe keys are the LIVE emitters' keys — so a logical event that already went out is
+ * `already`, never re-sent, and nothing a backfill adds can carry a lower version than a fact SeldonFrame already holds.
+ * Registration: only emitted when the current live read differs from the last registration fact already queued/sent.
+ * DRY RUN by default. Reads (Magnus CDR, peer registration) are live and bounded by `limit`.
+ */
+export async function backfillAccounts(opts: BackfillOptions = {}, db: any = prisma): Promise<{ dryRun: boolean; accounts: BackfillAccountResult[] }> {
+  const dryRun = opts.dryRun !== false
+  const limit = Math.min(Math.max(opts.limit ?? 25, 1), 200)
+  const accts: Array<{ id: string; userId: string; did: string | null; sipUsername: string; createdAt: Date; registeredAt: Date | null }> = await db.liteAccount.findMany({
+    where: { ...(opts.accountId ? { id: opts.accountId } : {}), did: { not: null } },
+    orderBy: { createdAt: 'asc' }, take: limit,
+    select: { id: true, userId: true, did: true, sipUsername: true, createdAt: true, registeredAt: true },
+  })
+  const live = opts.liveReads !== false
+  const out: BackfillAccountResult[] = []
+  for (const a of accts) {
+    const res: BackfillAccountResult = { accountId: a.id, planned: [], enqueued: [], already: [] }
+    try {
+      type Plan = { type: any; key: string; at: Date; facts: Record<string, unknown>; tag: string }
+      const plan: Plan[] = [{ type: 'pl.line_created', key: `line_created:${a.id}`, at: a.createdAt, facts: { did_masked: maskDid(a.did) }, tag: 'line_created' }]
+      let regNow: 'registered' | 'not_registered' | null = null
+      let activatedAt: Date | null = a.registeredAt
+      if (live) {
+        const { readPeerRegistration, REGISTERED } = await import('@/app/lib/lite-registration-watch')
+        const read: any = await readPeerRegistration(a.sipUsername, { fresh: true }).catch(() => null)
+        if (read?.ok) {
+          regNow = REGISTERED.has(read.status) ? 'registered' : 'not_registered'
+          if (regNow === 'registered' && !activatedAt) activatedAt = read.at ?? new Date()
+        }
+      }
+      if (activatedAt) plan.push({ type: 'pl.app_activated', key: `app_activated:${a.id}`, at: activatedAt, facts: { registration_now: 'registered', activated_at: activatedAt.toISOString() }, tag: 'app_activated' })
+      if (live) {
+        const { getFirstCallStatus } = await import('@/app/lib/lite-first-call-status')
+        const fc: any = await getFirstCallStatus(a.userId, { emit: false }).catch(() => null)
+        if (fc?.firstCallSucceeded && fc.firstCallAt) plan.push({ type: 'pl.first_call', key: `first_call:${a.id}`, at: new Date(fc.firstCallAt), facts: { first_call_at: fc.firstCallAt }, tag: 'first_call' })
+      }
+      res.planned = plan.map(p => p.tag)
+      if (!dryRun) {
+        await db.$transaction(async (tx: any) => {
+          for (const p of plan) {
+            const r = await enqueueSfEvent(tx, { type: p.type, plAccountId: a.id, dedupeKey: p.key, occurredAt: p.at, facts: p.facts })
+            if (r.enqueued) res.enqueued.push(p.tag)
+            else if ((r as { reason?: string }).reason === 'duplicate') res.already.push(p.tag)
+            else throw new Error(`${p.tag}:${(r as { reason?: string }).reason}${(r as { detail?: string }).detail ? ':' + (r as { detail?: string }).detail : ''}`)
+          }
+          // current registration, only when it differs from what SeldonFrame was already told
+          if (regNow) {
+            const { last } = await lastRegistrationFact(tx, a.id)
+            if (regNow !== (last ?? 'not_registered')) {
+              const at = new Date()
+              const r = await enqueueSfEvent(tx, { type: 'pl.registration_changed', plAccountId: a.id, dedupeKey: `reg:${a.id}:${regNow}:bf:${at.getTime()}`, occurredAt: at, facts: { registration_now: regNow } })
+              if (r.enqueued) { res.planned.push('registration_changed'); res.enqueued.push('registration_changed') }
+            }
+          }
+        }, { timeout: 20_000 })
+      }
+    } catch (e: any) {
+      res.error = String(e?.message ?? e).slice(0, 160)
+    }
+    out.push(res)
+  }
+  return { dryRun, accounts: out }
+}
diff --git a/app/lib/pl-concierge/sf-outbox-deliver.ts b/app/lib/pl-concierge/sf-outbox-deliver.ts
new file mode 100644
index 00000000..8db8a52b
--- /dev/null
+++ b/app/lib/pl-concierge/sf-outbox-deliver.ts
@@ -0,0 +1,200 @@
+/**
+ * pl-concierge/sf-outbox-deliver.ts — the DELIVERER: a lock-guarded tick that signs each due outbox row and POSTs it to the
+ * SeldonFrame personal-line webhook (config: readSfEventsConfig). It never runs inside the engine's request path.
+ *
+ * Properties (each proven in test/pl-sf-outbox*.test.ts):
+ *   - LOCK + LEASE: the claim step runs in a short transaction behind pg_try_advisory_xact_lock and leases the rows it takes
+ *     (next_attempt_at pushed out, attempts+1) with FOR UPDATE SKIP LOCKED. Two replicas / overlapping ticks cannot claim the
+ *     same row, so nothing is sent twice by the sender; the receiver's event_id inbox is the second line of defence.
+ *   - ORDER: a row is not claimed while an EARLIER version of the same account is still undelivered and not dead — events of
+ *     one account go out in version order. (A dead row stops blocking; a later fact is not held hostage by a permanent refusal.)
+ *   - 2xx (duplicate-event 200 included) => delivered_at. 5xx / 408 / 425 / 429 / timeout / network => pending, exponential
+ *     backoff with jitter (backoffMs). Other 4xx => dead_at + last_error, visible; `requeueDead` puts them back.
+ *   - FRESH SIGNATURE per attempt (a retry that reuses an expired timestamp would walk into a 401 — CLAUDE.md law 10).
+ *   - wa_id is resolved at delivery from the account (the contract needs it; the outbox does not copy it).
+ */
+import { prisma } from '@/app/lib/prisma'
+import {
+  backoffMs, buildIngressBody, classifyHttp, ingressHeaders, readSfEventsConfig, sfOutboxEnabled,
+  SF_MAX_ATTEMPTS, type SfEventsConfig, type Verdict,
+} from '@/app/lib/pl-concierge/sf-outbox'
+
+export const SF_TICK_NAME = 'sf-outbox'
+const TICK_LOCK_KEY = 'pl-sf-outbox-tick'
+const LEASE_MS = 90_000
+const REQUEST_TIMEOUT_MS = 5_000
+const BATCH = 10
+const MAX_ROUNDS = 6
+const TICK_BUDGET_MS = 25_000
+
+export interface ClaimedRow {
+  eventId: string
+  type: string
+  plAccountId: string
+  version: number
+  occurredAt: Date
+  payload: Record<string, unknown>
+  attempts: number
+}
+
+export interface OutboxStore {
+  /** null = another tick holds the lock. */
+  claim(now: Date, limit: number, leaseMs: number): Promise<ClaimedRow[] | null>
+  markDelivered(eventId: string, status: number, now: Date): Promise<void>
+  markRetry(eventId: string, status: number | null, error: string, nextAt: Date): Promise<void>
+  markDead(eventId: string, status: number | null, error: string, now: Date): Promise<void>
+  resolveWaId(plAccountId: string): Promise<string | null>
+}
+
+export interface TickDeps {
+  store: OutboxStore
+  fetchImpl: typeof fetch
+  config: SfEventsConfig
+  now: () => number
+  random: () => number
+}
+
+export interface TickResult {
+  ran: boolean
+  skipped?: 'disabled' | 'not_configured' | 'locked'
+  misconfig?: string[]
+  claimed: number
+  delivered: number
+  duplicates: number
+  staleKept: number
+  retried: number
+  dead: number
+  deadErrors: string[]
+}
+
+const emptyResult = (): TickResult => ({ ran: true, claimed: 0, delivered: 0, duplicates: 0, staleKept: 0, retried: 0, dead: 0, deadErrors: [] })
+
+export async function deliverOne(row: ClaimedRow, d: TickDeps, out: TickResult): Promise<void> {
+  const { store, config } = d
+  const nowMs = d.now()
+  const waId = await store.resolveWaId(row.plAccountId).catch(() => null)
+  if (!waId) { out.dead++; out.deadErrors.push('no_wa_id'); await store.markDead(row.eventId, null, 'no_wa_id', new Date(nowMs)); return }
+  const body = buildIngressBody({ eventId: row.eventId, type: row.type, plAccountId: row.plAccountId, version: row.version, occurredAt: row.occurredAt, facts: row.payload }, waId)
+  if (!body) { out.dead++; out.deadErrors.push('unbuildable_body'); await store.markDead(row.eventId, null, 'unbuildable_body', new Date(nowMs)); return }
+  let verdict: Verdict
+  let status: number | null = null
+  try {
+    const res = await d.fetchImpl(config.url!, {
+      method: 'POST',
+      headers: ingressHeaders(config.kid, config.key!, Math.floor(nowMs / 1000), body),
+      body,
+      cache: 'no-store',
+      redirect: 'manual',
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    })
+    status = res.status
+    const text = await res.text().catch(() => '')
+    verdict = classifyHttp(res.status, text.slice(0, 2000))
+  } catch (e: any) {
+    verdict = classifyHttp(null, null, e?.name === 'TimeoutError' || e?.name === 'AbortError' ? 'timeout' : 'network_error')
+  }
+  if (verdict.kind === 'delivered') {
+    out.delivered++
+    if (verdict.note === 'duplicate') out.duplicates++
+    if (verdict.note === 'stale_kept') out.staleKept++
+    await store.markDelivered(row.eventId, status ?? 200, new Date(d.now()))
+  } else if (verdict.kind === 'retry' && row.attempts < SF_MAX_ATTEMPTS) {
+    out.retried++
+    await store.markRetry(row.eventId, status, verdict.error, new Date(d.now() + backoffMs(row.attempts, d.random())))
+  } else {
+    const err = verdict.kind === 'retry' ? `max_attempts_exceeded:${verdict.error}` : verdict.error
+    out.dead++; out.deadErrors.push(err)
+    await store.markDead(row.eventId, status, err, new Date(d.now()))
+  }
+}
+
+/** One tick: claim -> deliver -> claim again (an account's later versions unblock as earlier ones land) within a time budget. */
+export async function runSfOutboxTickWith(d: TickDeps, env: NodeJS.ProcessEnv = process.env): Promise<TickResult> {
+  if (!sfOutboxEnabled(env)) return { ...emptyResult(), ran: false, skipped: 'disabled' }
+  if (!d.config.url || !d.config.key) return { ...emptyResult(), ran: false, skipped: 'not_configured', misconfig: d.config.misconfig }
+  const out = emptyResult()
+  const started = d.now()
+  for (let round = 0; round < MAX_ROUNDS && d.now() - started < TICK_BUDGET_MS; round++) {
+    const rows = await d.store.claim(new Date(d.now()), BATCH, LEASE_MS)
+    if (rows === null) { if (round === 0) return { ...out, ran: false, skipped: 'locked' }; break }
+    if (rows.length === 0) break
+    out.claimed += rows.length
+    for (const r of rows) await deliverOne(r, d, out)
+  }
+  return out
+}
+
+// ── the Postgres store (raw SQL; zero reliance on the generated model for writes) ─────────────────────────────────────────
+export function prismaOutboxStore(db: any = prisma): OutboxStore {
+  return {
+    async claim(now, limit, leaseMs) {
+      const leaseUntil = new Date(now.getTime() + leaseMs)
+      return db.$transaction(async (tx: any) => {
+        const got: Array<{ got: boolean }> = await tx.$queryRaw`SELECT pg_try_advisory_xact_lock(hashtextextended(${TICK_LOCK_KEY}, 0)) AS got`
+        if (!got[0]?.got) return null
+        const rows: Array<any> = await tx.$queryRaw`
+          WITH due AS (
+            SELECT o.event_id FROM sf_event_outbox o
+             WHERE o.delivered_at IS NULL AND o.dead_at IS NULL AND o.next_attempt_at <= ${now.toISOString()}::timestamptz AT TIME ZONE 'UTC'
+               AND NOT EXISTS (SELECT 1 FROM sf_event_outbox p
+                                WHERE p.pl_account_id = o.pl_account_id AND p.version < o.version
+                                  AND p.delivered_at IS NULL AND p.dead_at IS NULL)
+             ORDER BY o.pl_account_id, o.version
+             LIMIT ${limit} FOR UPDATE SKIP LOCKED)
+          UPDATE sf_event_outbox t SET attempts = t.attempts + 1, next_attempt_at = ${leaseUntil.toISOString()}::timestamptz AT TIME ZONE 'UTC'
+            FROM due WHERE t.event_id = due.event_id
+          RETURNING t.event_id::text AS event_id, t.type, t.pl_account_id, t.version, t.occurred_at, t.payload, t.attempts`
+        return rows.map(r => ({
+          eventId: String(r.event_id), type: String(r.type), plAccountId: String(r.pl_account_id), version: Number(r.version),
+          // occurred_at is timestamp WITHOUT tz holding UTC: re-read it as UTC whatever the driver's local zone is.
+          occurredAt: new Date(r.occurred_at instanceof Date ? r.occurred_at.getTime() : Date.parse(String(r.occurred_at) + 'Z')),
+          payload: (r.payload ?? {}) as Record<string, unknown>, attempts: Number(r.attempts),
+        })).sort((a, b) => a.plAccountId.localeCompare(b.plAccountId) || a.version - b.version)
+      }, { timeout: 15_000, maxWait: 5_000 })
+    },
+    async markDelivered(id, status, now) {
+      await db.$executeRaw`UPDATE sf_event_outbox SET delivered_at = ${now.toISOString()}::timestamptz AT TIME ZONE 'UTC', last_status = ${status}, last_error = NULL WHERE event_id = ${id}::uuid AND delivered_at IS NULL`
+    },
+    async markRetry(id, status, error, nextAt) {
+      await db.$executeRaw`UPDATE sf_event_outbox SET next_attempt_at = ${nextAt.toISOString()}::timestamptz AT TIME ZONE 'UTC', last_status = ${status}, last_error = ${error} WHERE event_id = ${id}::uuid AND delivered_at IS NULL`
+    },
+    async markDead(id, status, error, now) {
+      await db.$executeRaw`UPDATE sf_event_outbox SET dead_at = ${now.toISOString()}::timestamptz AT TIME ZONE 'UTC', last_status = ${status}, last_error = ${error} WHERE event_id = ${id}::uuid AND delivered_at IS NULL`
+    },
+    async resolveWaId(plAccountId) {
+      const a = await db.liteAccount.findUnique({ where: { id: plAccountId }, select: { ownerPhone: true } })
+      const digits = String(a?.ownerPhone ?? '').replace(/\D/g, '')
+      return /^[1-9][0-9]{6,15}$/.test(digits) ? digits : null
+    },
+  }
+}
+
+/** Production entry (the cron route): real clock, real fetch, config from env / Swarm secret file. Records a heartbeat. */
+export async function runSfOutboxTick(env: NodeJS.ProcessEnv = process.env): Promise<TickResult> {
+  const r = await runSfOutboxTickWith({ store: prismaOutboxStore(), fetchImpl: fetch, config: readSfEventsConfig(env), now: Date.now, random: Math.random }, env)
+  if (r.ran) {
+    const ok = r.dead === 0
+    await prisma.cronHeartbeat.upsert({
+      where: { name: SF_TICK_NAME },
+      create: { name: SF_TICK_NAME, lastRunAt: new Date(), lastRunOk: ok, lastError: ok ? null : `${r.dead} event(s) dead-lettered: ${[...new Set(r.deadErrors)].join(',').slice(0, 200)}`, runCount: 1 },
+      update: { lastRunAt: new Date(), lastRunOk: ok, lastError: ok ? null : `${r.dead} event(s) dead-lettered: ${[...new Set(r.deadErrors)].join(',').slice(0, 200)}`, runCount: { increment: 1 } },
+    }).catch(() => null)
+  }
+  return r
+}
+
+/** Operator repair: dead rows back to pending (optionally one account). Returns how many. */
+export async function requeueDead(db: any = prisma, plAccountId?: string): Promise<number> {
+  return plAccountId
+    ? db.$executeRaw`UPDATE sf_event_outbox SET dead_at = NULL, next_attempt_at = now(), last_error = 'requeued' WHERE dead_at IS NOT NULL AND delivered_at IS NULL AND pl_account_id = ${plAccountId}`
+    : db.$executeRaw`UPDATE sf_event_outbox SET dead_at = NULL, next_attempt_at = now(), last_error = 'requeued' WHERE dead_at IS NOT NULL AND delivered_at IS NULL`
+}
+
+/** Read-only counters for the operator (no payloads, no phones). */
+export async function outboxCounts(db: any = prisma): Promise<{ pending: number; delivered: number; dead: number }> {
+  const r: Array<any> = await db.$queryRaw`SELECT
+    count(*) FILTER (WHERE delivered_at IS NULL AND dead_at IS NULL)::int AS pending,
+    count(*) FILTER (WHERE delivered_at IS NOT NULL)::int AS delivered,
+    count(*) FILTER (WHERE dead_at IS NOT NULL AND delivered_at IS NULL)::int AS dead FROM sf_event_outbox`
+  return { pending: Number(r[0]?.pending ?? 0), delivered: Number(r[0]?.delivered ?? 0), dead: Number(r[0]?.dead ?? 0) }
+}
