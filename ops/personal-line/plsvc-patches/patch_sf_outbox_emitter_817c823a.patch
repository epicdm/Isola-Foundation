+/**
+ * The Personal Line -> SeldonFrame outbox on a REAL Postgres through the REAL Prisma client + @prisma/adapter-pg (the combination
+ * the mocked suites cannot see: transaction atomicity, ON CONFLICT, advisory locks, FOR UPDATE SKIP LOCKED, SAVEPOINT).
+ *
+ * Runs only when LOCK_TEST_PG_URL points at a THROWAWAY local database (127.0.0.1/localhost, db name lockvoid*); anything else is
+ * refused. The schema is built from prisma/schema.prisma; THIS change's table is then (re)created from the REVIEWED migration file
+ * itself, which is also the proof that the migration applies cleanly. Never run against any other database.
+ */
+import { describe, it, expect, vi, beforeAll, afterAll } from 'vitest'
+import { readFileSync } from 'node:fs'
+import path from 'node:path'
+
+const URL_ = vi.hoisted(() => {
+  const u = process.env.LOCK_TEST_PG_URL || ''
+  let ok = false
+  try { const x = new URL(u); ok = /^(127\.0\.0\.1|localhost)$/.test(x.hostname) && /^\/lockvoid/.test(x.pathname) } catch { ok = false }
+  if (u && !ok) throw new Error('LOCK_TEST_PG_URL must be a THROWAWAY local database (127.0.0.1/localhost, db name lockvoid*) — refusing')
+  if (ok) { process.env.DATABASE_URL = u; process.env.POSTGRES_PRISMA_URL = u }
+  return ok ? u : ''
+})
+vi.unmock('@/app/lib/prisma')
+const MAG = vi.hoisted(() => ({ seq: Math.floor(Math.random() * 5000) }))
+// A local AMI-listener stand-in for the registration watch (the module reads AMI_LISTENER_URL once, at import).
+const PEER = vi.hoisted(() => { process.env.AMI_LISTENER_URL = 'http://127.0.0.1:39017'; process.env.REGISTRATION_SOURCE = 'listener'; return { status: 'unregistered' as string, httpCode: 200 } })
+vi.mock('@/app/lib/runtime-flags', () => ({ getRuntimeFlag: () => false, getRuntimeNumber: (_k: string, d: number) => d, getRuntimeList: (_k: string, d: string[]) => d }))
+vi.mock('@/app/lib/magnus', () => ({
+  // provisionLine's two-phase path: the candidate DID, sip username and password are minted first, then the provider call echoes them back.
+  findNextFreeDIDCandidate: async () => { const n = ++MAG.seq; return { success: true as const, did: `1767817${String(n % 10000).padStart(4, '0')}` } },
+  mintFreeSipUsername: async () => `lt_sf_${Date.now().toString(36)}_${++MAG.seq}`,
+  generatePassword: (len = 24) => 'p'.repeat(len),
+  provisionTenantLine: async (_u: string, _e: unknown, did: string, _o: unknown, _p: unknown, resume: { sipUsername: string; sipPassword: string }) => {
+    const n = ++MAG.seq
+    return { success: true, sipUsername: resume.sipUsername, sipPassword: resume.sipPassword, did, magnusUserId: `7${n}`, magnusSipId: '2', magnusDidId: '3', magnusDiddestinationId: '4' }
+  },
+  setDIDForwardToCell: async () => ({ success: true }), setDIDRoutingToSIP: async () => ({ success: true }),
+  getMagnusUserCallsEnriched: async () => [],
+}))
