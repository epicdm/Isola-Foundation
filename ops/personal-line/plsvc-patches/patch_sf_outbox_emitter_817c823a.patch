+  })
+
+  it('IDEMPOTENT: the same logical event twice (two transactions) is ONE row, same event_id; a different key is a second row (control)', async () => {
+    const acct = `idem-${run}`
+    const inp = { type: 'pl.line_created' as const, plAccountId: acct, dedupeKey: `line_created:${acct}`, occurredAt: iso(), facts: {} }
+    const r1: any = await prisma.$transaction((tx: any) => enqueueSfEvent(tx, inp, ON))
+    const r2: any = await prisma.$transaction((tx: any) => enqueueSfEvent(tx, inp, ON))
+    expect(r1).toMatchObject({ enqueued: true, version: 1 }); expect(r2).toMatchObject({ enqueued: false, reason: 'duplicate' })
+    expect(r2.eventId).toBe(r1.eventId); expect(r1.eventId).toBe(eventIdFor(inp.dedupeKey))
+    expect(await rows(acct)).toHaveLength(1)
+    const r3: any = await prisma.$transaction((tx: any) => enqueueSfEvent(tx, { ...inp, type: 'pl.first_call', dedupeKey: `first_call:${acct}`, facts: { first_call_at: iso(5).toISOString() } }, ON))
+    expect(r3).toMatchObject({ enqueued: true, version: 2 }); expect(await rows(acct)).toHaveLength(2)
+  })
+
+  it('VERSIONS are monotonic per account under CONCURRENCY (12 transactions, two clients): 1..12 with no gap or duplicate; another account starts at 1 (control)', async () => {
+    const acct = `ver-${run}`
+    const mk = (i: number) => (i % 2 ? a : b).$transaction((tx: any) => enqueueSfEvent(tx, { type: 'pl.registration_changed', plAccountId: acct, dedupeKey: `reg:${acct}:${i}`, occurredAt: iso(i), facts: { registration_now: i % 2 ? 'registered' : 'not_registered' } }, ON))
