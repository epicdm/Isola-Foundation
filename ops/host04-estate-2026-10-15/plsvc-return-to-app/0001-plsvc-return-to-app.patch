+/**
+ * pay-return.ts — where the card pay page sends the payer after a payment attempt.
+ *
+ * Owner ruling 2026-10-15: the payer started the payment from inside the Cloud Softphone (Acrobits) app, so "Open" after
+ * paying must lead BACK to that app. It used to be https://app.isola.epic.dm/wallet, a PWA that needs a signed-in browser
+ * session; a payer whose pay page opened in the system browser has none and landed on "Open Isola from WhatsApp".
+ *
+ * The pay page only accepts an http(s) returnUrl (payment-link.ts), so this is an https page (app/go/back/route.ts) that
+ * hands off to the app's own URL scheme. It carries NO identity, token or account data - it is the same page for everyone.
+ */
+export const PAY_RETURN_URL = process.env.PL_PAY_RETURN_URL || 'https://bff.epic.dm/go/back'
+
+/** Cloud Softphone's URL scheme (doc.acrobits.net, Call URIs: "Cloud Softphone | cloudsip"); `cloudsip:` alone launches the app. */
+export const SOFTPHONE_APP_URI = 'cloudsip:'
