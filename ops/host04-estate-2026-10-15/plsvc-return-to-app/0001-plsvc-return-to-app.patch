diff --git a/test/pay-return-to-app.test.ts b/test/pay-return-to-app.test.ts
new file mode 100644
index 0000000..2127bfb
--- /dev/null
+++ b/test/pay-return-to-app.test.ts
@@ -0,0 +1,70 @@
+/**
+ * After paying, the payer must be led BACK TO THE CLOUD SOFTPHONE APP (owner 2026-10-15), not to the signed-in PWA.
+ * Measured: the 2026-10-15 first real payment landed on "Open Isola from WhatsApp" because the old returnUrl needed a session.
+ *
+ * Two things are pinned here, each with a positive twin:
+ *   1. GET /go/back launches the app scheme, makes no payment claim (the pay page also sends declined/cancelled payers
+ *      there), says nothing branded "Isola", and reads no identity.
+ *   2. mintPaymentLink stores the app-return URL for a Personal Line payer who supplied no returnUrl, keeps an explicit
+ *      returnUrl untouched, and leaves a NON-Personal-Line payer (A/R reminder) without a forced redirect.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const mockPrisma: any = vi.hoisted(() => ({ paymentLink: { create: async ({ data }: any) => ({ ...data, id: 'pl-1' }) }, liteAccount: { findUnique: async () => ({ id: 'la-1', status: 'active' }) } }))
+vi.mock('@/app/lib/prisma', () => ({ prisma: mockPrisma }))
+vi.mock('@/app/lib/lite-retire', () => ({ isRetiredLiteAccount: () => false }))
+vi.mock('@/app/lib/magnus-sqlinject-guard', () => ({ regenerateUntilMagnusSafe: async (f: any) => f() }))
+
+import { GET, backPageHtml } from '@/app/go/back/route'
+import { mintPaymentLink } from '@/app/lib/payment-link'
+import { PAY_RETURN_URL, SOFTPHONE_APP_URI } from '@/app/lib/pay-return'
+
+const base = { amount: 10, currency: 'XCD', description: 'Top up' } as any
+const storedReturnUrl = () => mockPrisma.paymentLink.create.mock.calls.at(-1)?.[0]?.data?.returnUrl
+
+beforeEach(() => { vi.restoreAllMocks(); vi.spyOn(mockPrisma.paymentLink, 'create') })
+
+describe('GET /go/back', () => {
+  it('launches the Cloud Softphone scheme via a tappable button and an auto-launch, uncached', async () => {
+    const res = await GET()
+    const html = await res.text()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('cache-control')).toBe('no-store')
+    expect(html).toContain(`href="${SOFTPHONE_APP_URI}"`)
+    expect(html).toContain(`location.href=${JSON.stringify(SOFTPHONE_APP_URI)}`)
+    expect(SOFTPHONE_APP_URI).toBe('cloudsip:')
+  })
+  it('makes no payment-outcome claim and carries no Isola brand word', () => {
+    const html = backPageHtml()
+    expect(html).not.toMatch(/your payment (went|was|has)|you're all set|thank/i)
+    expect(html).not.toMatch(/isola/i)
+    // CONTROL: the same patterns do fire on text that makes the claim, so the two assertions above can fail.
+    expect('Your payment went through').toMatch(/your payment (went|was|has)/i)
+    expect('Welcome to Isola').toMatch(/isola/i)
+    // positive twin: the page still tells the payer where the confirmation arrives.
+    expect(html).toMatch(/confirmation with your new balance arrives on WhatsApp once a payment goes through/)
+  })
+})
+
+describe('mintPaymentLink return target', () => {
+  it('Personal Line payer with no returnUrl -> the app-return page', async () => {
+    const r: any = await mintPaymentLink({ ...base, liteAccountId: 'la-1' })
+    expect(r.ok).toBe(true)
+    expect(storedReturnUrl()).toBe(PAY_RETURN_URL)
+    expect(PAY_RETURN_URL).toMatch(/^https:\/\/.+\/go\/back$/)
+  })
+  it('an explicit returnUrl is never overridden (Hermes A/R no-redirect convention survives)', async () => {
+    await mintPaymentLink({ ...base, liteAccountId: 'la-1', returnUrl: 'https://pay.isola.epic.dm/no-redirect' })
+    expect(storedReturnUrl()).toBe('https://pay.isola.epic.dm/no-redirect')
+  })
+  it('a payer with NO Personal Line account is not given a forced redirect (control: distinct from the case above)', async () => {
+    await mintPaymentLink({ ...base, tenantId: 't-1' })
+    expect(storedReturnUrl()).toBeUndefined()
+  })
+  it('the stored default passes the mint validator (http(s) only) - the same input accepted end to end', async () => {
+    const r: any = await mintPaymentLink({ ...base, liteAccountId: 'la-2' })
+    expect(r.ok).toBe(true)
+    const bad: any = await mintPaymentLink({ ...base, liteAccountId: 'la-2', returnUrl: SOFTPHONE_APP_URI })
+    expect(bad.ok).toBe(false) // why a bare cloudsip: cannot be the returnUrl itself and the https hand-off page exists
+  })
+})
