diff --git a/app/go/back/route.ts b/app/go/back/route.ts
new file mode 100644
index 0000000..4a34d5a
--- /dev/null
+++ b/app/go/back/route.ts
@@ -0,0 +1,40 @@
+/**
+ * GET /go/back - public, unauthenticated "back to your line" page.
+ *
+ * The card pay page's returnUrl (app/lib/pay-return.ts). After paying, the payer taps Open and lands here; the page
+ * launches the Cloud Softphone app via its URL scheme. A button is always shown too, because a browser may block a
+ * script-initiated custom-scheme navigation (iOS Safari asks first) - the tap is the reliable path.
+ *
+ * It reads nothing, writes nothing and takes no parameters: no identity, no account, no payment state. Customer wording
+ * is EPIC-branded (no "Isola").
+ */
+import { NextResponse } from 'next/server'
+import { SOFTPHONE_APP_URI } from '@/app/lib/pay-return'
+
+export const dynamic = 'force-dynamic'
+
+const ANDROID_STORE = 'https://play.google.com/store/apps/details?id=cz.acrobits.softphone.cloudphone'
+const IOS_STORE = 'https://apps.apple.com/us/app/cloud-softphone/id567475545'
+
+export function backPageHtml(): string {
+  return `<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Back to your EPIC line</title>
+<style>body{font:16px/1.5 system-ui,sans-serif;margin:0;padding:32px 20px;text-align:center;color:#111}
+a.btn{display:block;max-width:320px;margin:24px auto 12px;padding:16px;border-radius:12px;background:#0a7d4b;color:#fff;font-weight:600;text-decoration:none}
+small{color:#555}</style></head>
+<body>
+<h1>Back to your EPIC line</h1>
+<p>Tap the button to return to your EPIC Personal Line. A confirmation with your new balance arrives on WhatsApp once a payment goes through.</p>
+<a class="btn" href="${SOFTPHONE_APP_URI}">Open Cloud Softphone</a>
+<p><small>Don't have the app on this phone? <a href="${IOS_STORE}">iPhone</a> &middot; <a href="${ANDROID_STORE}">Android</a></small></p>
+<script>setTimeout(function(){location.href=${JSON.stringify(SOFTPHONE_APP_URI)}},400)</script>
+</body></html>`
+}
+
+export async function GET() {
+  return new NextResponse(backPageHtml(), {
+    status: 200,
+    headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' },
+  })
+}
