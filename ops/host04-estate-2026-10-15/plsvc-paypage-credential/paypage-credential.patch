+/**
+ * The hosted pay page's NARROW credential (PL_PAYPAGE_SECRET, lib/internal-auth.ts validatePayPageSecret).
+ *
+ * Measured defect (2026-10-15): after bff.epic.dm moved to host04 the payment-link paths are served by plsvc, whose
+ * validateInternalSecret did not know the credential the pay page sends, so the lookup was answered 401 before any
+ * charge was attempted. The fix must make the page work WITHOUT widening what that credential can reach.
+ *
+ * Every negative assertion below has a positive twin in the same file (law: an absence test without a control
+ * proves nothing): the page secret is accepted by exactly the two routes, and the primary secret is accepted by the
+ * routes that refuse the page secret.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { NextRequest } from 'next/server'
+
+const mockPrisma: any = {
+  paymentLink: { create: vi.fn(), findUnique: vi.fn(), updateMany: vi.fn(), update: vi.fn(), findMany: vi.fn(async () => []) },
+  liteAccount: { findUnique: vi.fn(), findMany: vi.fn(async () => []) },
+  liteMinuteLedger: { findFirst: vi.fn(), create: vi.fn(async () => ({ id: 'led-1' })), update: vi.fn(async () => ({})), findUnique: vi.fn(async () => ({ meta: {} })), updateMany: vi.fn(async () => ({ count: 1 })) },
+}
+vi.mock('@/app/lib/prisma', () => ({ prisma: mockPrisma }))
+vi.mock('@/app/lib/payments/fiserv', () => ({ fiservCharge: vi.fn() }))
+vi.mock('@/app/lib/payments/fiserv-charge-log', () => ({ recordFiservCharge: vi.fn() }))
+vi.mock('@/app/lib/reloadly-client', () => ({ sendTopup: vi.fn(), getBalance: async () => ({ balance: 1000, currencyCode: 'USD' }), autoDetectOperator: vi.fn() }))
+vi.mock('@/app/lib/whatsapp', () => ({ sendWhatsAppMessage: vi.fn(), sendWhatsAppTemplate: vi.fn() }))
+vi.mock('@/app/lib/magnus', () => ({ CREDIT_REFERENCE_RE: /^[\w:.+/=-]{3,120}$/, addMagnusCredit: vi.fn(), getMagnusUserById: vi.fn() }))
+
+const PRIMARY = 'primary-internal-secret-0123456789abcdef0123456789abcdef'
+const PAYPAGE = 'paypage-narrow-secret-fedcba9876543210fedcba9876543210'
+const params = (token = 'tok') => ({ params: Promise.resolve({ token }) })
+const hdr = (secret?: string) => ({ 'Content-Type': 'application/json', ...(secret ? { 'x-internal-secret': secret } : {}) })
+const lookupReq = (secret?: string) => new NextRequest('http://localhost/api/internal/payment-link/tok', { method: 'GET', headers: hdr(secret) })
+const chargeReq = (secret?: string, body: any = {}) => new NextRequest('http://localhost/api/internal/payment-link/tok/charge', { method: 'POST', headers: hdr(secret), body: JSON.stringify(body) })
+const mintReq = (secret?: string) => new NextRequest('http://localhost/api/internal/payment-link', { method: 'POST', headers: hdr(secret), body: JSON.stringify({}) })
+const resolveReq = (secret?: string) => new NextRequest('http://localhost/api/internal/personal-line/resolve-action-target', { method: 'POST', headers: hdr(secret), body: JSON.stringify({ did: '17678180000' }) })
+const RESOLVE_PRIMARY_STATUS = 200
+const link = () => ({ token: 'tok', amount: '10.00', currency: 'XCD', description: 'Top up', status: 'pending', expiresAt: new Date(Date.now() + 60_000), returnUrl: null, attempts: 0 })
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  process.env.INTERNAL_SECRET = PRIMARY
+  process.env.PL_PAYPAGE_SECRET = PAYPAGE
+  delete process.env.ISOLA_INTERNAL_SECRET
+  mockPrisma.paymentLink.findUnique.mockResolvedValue(link())
+})
+
+describe('validatePayPageSecret / validateInternalSecret — separation', () => {
+  it('control: the two test credentials really are different values (so the separation tests below can fail)', () => {
+    expect(PRIMARY).not.toBe(PAYPAGE)
+  })
+  it('accepts exactly the configured pay-page secret and nothing else', async () => {
+    const { validatePayPageSecret } = await import('@/app/lib/internal-auth')
+    const mk = (s?: string) => new Request('http://x/', { headers: s ? { 'x-internal-secret': s } : {} })
+    expect(validatePayPageSecret(mk(PAYPAGE))).toBe(true)                    // positive control
+    expect(validatePayPageSecret(mk(PAYPAGE.slice(0, -1) + 'X'))).toBe(false) // same length, one char off
+    expect(validatePayPageSecret(mk(PAYPAGE + 'x'))).toBe(false)              // longer
+    expect(validatePayPageSecret(mk(PAYPAGE.slice(0, 10)))).toBe(false)       // shorter
+    expect(validatePayPageSecret(mk())).toBe(false)                           // no header
+    expect(validatePayPageSecret(mk(PRIMARY))).toBe(false)                    // the primary is NOT a pay-page credential
+  })
+  it('fails closed when PL_PAYPAGE_SECRET is unset or empty (a header that would otherwise match is refused)', async () => {
+    const { validatePayPageSecret } = await import('@/app/lib/internal-auth')
+    const req = new Request('http://x/', { headers: { 'x-internal-secret': PAYPAGE } })
+    expect(validatePayPageSecret(req)).toBe(true)                             // positive control with the env set
+    delete process.env.PL_PAYPAGE_SECRET
+    expect(validatePayPageSecret(req)).toBe(false)
+    process.env.PL_PAYPAGE_SECRET = ''
+    expect(validatePayPageSecret(new Request('http://x/', { headers: { 'x-internal-secret': '' } }))).toBe(false)
+  })
+  it('the configured value is trimmed: an env value with surrounding whitespace/newline still matches the (already-trimmed) header', async () => {
+    const { validatePayPageSecret } = await import('@/app/lib/internal-auth')
+    process.env.PL_PAYPAGE_SECRET = '  ' + PAYPAGE + '\n'
+    expect(validatePayPageSecret(new Request('http://x/', { headers: { 'x-internal-secret': PAYPAGE } }))).toBe(true)
+    process.env.PL_PAYPAGE_SECRET = '   \n'   // whitespace-only must still fail closed
+    expect(validatePayPageSecret(new Request('http://x/', { headers: { 'x-internal-secret': ' ' } }))).toBe(false)
+  })
+  it('validateInternalSecret does NOT accept the pay-page secret (the narrow credential is not folded into the general chain)', async () => {
+    const { validateInternalSecret } = await import('@/app/lib/internal-auth')
+    const mk = (s: string) => new Request('http://x/', { headers: { 'x-internal-secret': s } })
+    expect(validateInternalSecret(mk(PRIMARY))).toBe(true)                    // positive control
+    expect(validateInternalSecret(mk(PAYPAGE))).toBe(false)
+  })
+})
+
+describe('GET /api/internal/payment-link/[token] — lookup', () => {
+  it('the pay page secret is accepted (this is the production defect)', async () => {
+    const { GET } = await import('@/app/api/internal/payment-link/[token]/route')
+    const res = await GET(lookupReq(PAYPAGE), params())
+    expect(res.status).toBe(200)
+    const j = await res.json()
+    expect(j.ok).toBe(true); expect(j.amount).toBe(10); expect(j.currency).toBe('XCD'); expect(j.status).toBe('pending')
+  })
+  it('the primary internal secret still works (no regression)', async () => {
+    const { GET } = await import('@/app/api/internal/payment-link/[token]/route')
+    expect((await GET(lookupReq(PRIMARY), params())).status).toBe(200)
+  })
+  it('a wrong secret and no secret are refused 401 and never read the link', async () => {
+    const { GET } = await import('@/app/api/internal/payment-link/[token]/route')
+    expect((await GET(lookupReq('nope'), params())).status).toBe(401)
+    expect((await GET(lookupReq(undefined), params())).status).toBe(401)
+    expect(mockPrisma.paymentLink.findUnique).not.toHaveBeenCalled()
+  })
+})
+
+describe('POST /api/internal/payment-link/[token]/charge', () => {
+  it('the pay page secret passes auth (an empty body then fails VALIDATION with 400, not 401) - no charge is attempted', async () => {
+    const { POST } = await import('@/app/api/internal/payment-link/[token]/charge/route')
+    const res = await POST(chargeReq(PAYPAGE, {}), params())
+    expect(res.status).toBe(400)
+    const { fiservCharge } = await import('@/app/lib/payments/fiserv')
+    expect(fiservCharge).not.toHaveBeenCalled()
+  })
+  it('control: the primary secret reaches the same validation (400)', async () => {
+    const { POST } = await import('@/app/api/internal/payment-link/[token]/charge/route')
+    expect((await POST(chargeReq(PRIMARY, {}), params())).status).toBe(400)
+  })
+  it('a wrong secret and no secret are 401 (so the 400 above really means "authorised")', async () => {
+    const { POST } = await import('@/app/api/internal/payment-link/[token]/charge/route')
+    expect((await POST(chargeReq('nope', {}), params())).status).toBe(401)
+    expect((await POST(chargeReq(undefined, {}), params())).status).toBe(401)
+  })
+})
+
+describe('NARROWNESS - the pay page secret reaches ONLY the two routes', () => {
+  it('mint route (POST /api/internal/payment-link): the pay page secret is refused 401; the primary is not (control)', async () => {
+    const { POST } = await import('@/app/api/internal/payment-link/route')
+    expect((await POST(mintReq(PAYPAGE))).status).toBe(401)
+    expect((await POST(mintReq(PRIMARY))).status).toBe(400)   // authenticated, then rejected by body validation ({} has no amount): pinned, a 500 would fail
+  })
+  it('an unrelated internal route (personal-line/resolve-action-target): the pay page secret is refused 401; the primary is not (control)', async () => {
+    const { POST } = await import('@/app/api/internal/personal-line/resolve-action-target/route')
+    expect((await POST(resolveReq(PAYPAGE))).status).toBe(401)
+    expect((await POST(resolveReq(PRIMARY))).status).toBe(RESOLVE_PRIMARY_STATUS)   // authenticated outcome, pinned (a 500 or 401 would fail)
+  })
+})
