+/**
+ * The hosted pay page's own NARROW credential, for exactly two routes:
+ * GET /api/internal/payment-link/:token (lookup) and POST /api/internal/payment-link/:token/charge.
+ *
+ * WHY THIS EXISTS (measured 2026-10-15): the hosted pay page (isola.epic.dm) is the FRONTEND and authenticates
+ * with the frontend credential (deployed bff: ISOLA_INTERNAL_SECRET), not the primary INTERNAL_SECRET. When
+ * bff.epic.dm moved to host04 the payment-link paths are served by plsvc, whose validateInternalSecret did not
+ * know that credential, so the page's lookup was answered 401 ("something went wrong") before any charge was
+ * attempted. Configuring ISOLA_INTERNAL_SECRET on plsvc would have been the quick fix, but it would make the
+ * frontend credential valid for EVERY /api/internal/* route on plsvc (wallet, provisioning, operator routes).
+ * This function is the narrow alternative: a SEPARATE value (env PL_PAYPAGE_SECRET) checked only by the two
+ * routes above, deliberately NOT folded into validateInternalSecret's chain (same least-privilege reasoning as
+ * validateAmiPushSecret and validateEpicnetFreeCallToken below). It reads the same x-internal-secret header
+ * the page already sends; no page change is needed. Constant-time comparison over equal-length buffers.
+ * An unset or empty PL_PAYPAGE_SECRET refuses everything (fail closed).
+ *
+ * EXPLICITLY ACCEPTED SCOPE (independent review, 2026-10-15): on the charge route this credential can submit card
+ * details against ANY pending link whose token the caller knows. That is the pay page's whole job for every
+ * customer - the unguessable token is the capability and the payer supplies their own card - and it is strictly
+ * NARROWER than before the bff.epic.dm move, when the old bff accepted this same credential on every internal
+ * route. It grants no mint, refund, direct wallet-credit or operator access (tests pin that). Per-link attempt caps
+ * and the retired-account refusal in the charge route still apply.
+ *
+ * The configured value is trimmed: Fetch's Headers API strips surrounding whitespace from the header value, so an
+ * env value with a trailing newline or space would otherwise never match what the page sends.
+ */
+export function validatePayPageSecret(req: Request): boolean {
+  const expectedRaw = process.env.PL_PAYPAGE_SECRET?.trim()
+  if (!expectedRaw) return false
+  const presented = req.headers.get('x-internal-secret')
+  if (!presented) return false
+  const expected = Buffer.from(expectedRaw, 'utf8')
+  const given = Buffer.from(presented, 'utf8')
+  if (given.length !== expected.length) return false
+  return timingSafeEqual(given, expected)
+}
