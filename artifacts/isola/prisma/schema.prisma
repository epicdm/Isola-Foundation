generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core tenant/user ─────────────────────────────────────────────────────────

model Tenant {
  id             String  @id @default(cuid())
  business_name  String
  status         String  @default("active") // active | suspended
  plan           String  @default("starter") // starter | growth | pro
  magnus_user_id String? // linked Magnus account id (shared by wallet + voice)

  // Registry classification tag (S1c-2 — additive; nullable, no default).
  // Distinguishes genuine business tenants from test/duplicate/merged rows
  // accumulated during onboarding experiments, so downstream consumers
  // (e.g. the cockpit's tenant list) can filter to tenant_kind = 'real'.
  // Untagged (null) rows are neither included nor excluded by convention —
  // tagging is a one-time backfill (S1c-2 Part B), not enforced at write time.
  tenant_kind String? // real | test | duplicate | merged

  // Owner's own WhatsApp number — delivery target for proactive owner
  // notifications (e.g. the missed-call/voicemail-catch WA alert). Mirrors
  // Isola Lite's LiteAccount.ownerPhone. E.164, e.g. +17671234567.
  // Nullable: not every tenant has set this yet; the voicemail poller skips
  // delivery (but still stores the catch) when unset — see
  // lib/voicemail-poller.ts deliverCatch().
  owner_phone String?

  // ── Voice / PBX provisioning (Magnus) ────────────────────────────────────
  voice_provisioning_state String  @default("none") // none | pending | completed | failed
  voice_provisioning_error String? // last error detail when state=failed
  magnus_sip_id            String? // Magnus `sip` table row id
  magnus_sip_username      String? // SIP registration username
  magnus_sip_password      String? // SIP registration password (plaintext — shown to owner for softphone setup)
  magnus_callerid_id       String? // Magnus `callerid` table row id
  magnus_did_id            String? // Magnus `did` table row id
  magnus_did_number        String? // the DID phone number, e.g. 1767818xxxx
  magnus_diddestination_id String? // Magnus `diddestination` table row id (routes the DID)
  voice_forward_to_cell    Boolean @default(false) // true = DID routes to voice_cell_number instead of the SIP extension
  voice_cell_number        String? // fallback cell number for forward-to-cell

  // ── Canonical tenant registry linkage (S1a — additive; not yet seeded) ────
  // Mirrors BFF's tenant_registry join columns so this Tenant row can become
  // the single canonical registry entry across the constellation. Nullable:
  // populated per-integration as each tenant is linked; seeding is S1b.
  // magnus_sip_id / magnus_did_id / magnus_user_id are NOT repeated here —
  // Tenant already carries them above (Voice/PBX provisioning block).
  clawith_tenant_id    String? @unique // Clawith `tenants.id` — nullable-unique enforces the join
  paperclip_company_id String?
  odoo_instance_type   String? // hosted_saas | local_docker_clone
  odoo_db              String?
  odoo_url             String?
  waba_id              String? // Meta WABA id (tenant-level; distinct from per-number WhatsAppNumber.waba_id)
  wa_phone_number_id   String?
  chatwoot_account_id  String?
  reseller_id          String?
  billing              Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users               User[]
  agents              Agent[]
  whatsapp_numbers    WhatsAppNumber[]
  chatwoot_bindings   ChatwootBinding[]
  odoo_binding        OdooBinding?
  fiserv_binding      FiservBinding?
  bff_binding         BffBinding?
  clawith_bindings    ClawithBinding[]
  conversations       Conversation[]
  wallet              Wallet?
  wallet_txns         WalletTxn[]
  usage_meters        UsageMeter[]
  subscription        Subscription?
  audit_logs          AuditLog[]
  consents            Consent[]
  voicemail_catches   TenantVoicemailCatch[]
  memberships         Membership[]
  voice_lines         VoiceLine[]
  approval_requests   ApprovalRequest[]
  escalation_refs     EscalationRef[]
  notification_outbox NotificationOutbox[]
  staff_bindings      StaffBinding[]
  staff_work_actions  StaffWorkAction[]

  conversation_ownership_transitions ConversationOwnershipTransition[]
  customer_tool_operations           CustomerToolOperation[]
}

// ── Per-tenant voicemail catches (AI missed-call catcher) ────────────────────
//
// Port of Isola Lite's LiteCatch (bff-v2 prisma/schema.prisma model
// LiteCatch, table lite_catches) onto the Foundation multi-tenant Tenant
// model. liteAccountId → tenant_id; field set is otherwise unchanged.
// Populated by lib/voicemail-poller.ts polling voice00's Asterisk
// voicemail spool over read-only SSH, running lib/voicemail-catcher.ts
// (parse/transcribe/summarize), and delivering a WhatsApp template alert
// to Tenant.owner_phone when set.
model TenantVoicemailCatch {
  id             String   @id @default(cuid())
  tenant_id      String
  msgId          String // Asterisk voicemail message id, e.g. "msg0000" — dedup key per tenant
  callerId       String
  calledExten    String
  origtime       Int
  durationSec    Int
  transcript     String   @db.Text
  summary        String   @db.Text
  intent         String
  urgency        String   @default("normal")
  callbackNumber String?
  confident      Boolean  @default(true)
  isSpam         Boolean  @default(false)
  delivered      Boolean  @default(false)
  created_at     DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, msgId])
  @@index([tenant_id, created_at])
  @@map("tenant_voicemail_catches")
}

// ── EMA consumer accounts (slim — NOT a Tenant) ───────────────────────────────
//
// A ConsumerAccount is a single person with a phone/wallet, provisioned via
// provisionConsumerVoice() (lib/voice-provisioning-consumer.ts). It is
// deliberately NOT a Tenant: no business_name, no Agent/WhatsAppNumber/
// ChatwootBinding/Conversation, no Isola SaaS `plan` (starter/growth/pro).
// It shares the Wallet/WalletTxn/AuditLog tables with Tenant via a second,
// optional FK column on each of those models.
model ConsumerAccount {
  id           String  @id @default(cuid())
  phone_number String  @unique // E.164, e.g. +17671234567 — the consumer's own number, not the DID
  display_name String?
  status       String  @default("active") // active | suspended

  // ── Voice / PBX provisioning (Magnus) — mirrors Tenant's voice block ──────
  voice_provisioning_state String  @default("none")
  voice_provisioning_error String?
  magnus_user_id           String?
  magnus_sip_id            String?
  magnus_sip_username      String?
  magnus_sip_password      String?
  magnus_callerid_id       String?
  magnus_did_id            String?
  magnus_did_number        String?
  magnus_diddestination_id String?
  voice_forward_to_cell    Boolean @default(false)
  voice_cell_number        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  wallet      Wallet?
  wallet_txns WalletTxn[]
  audit_logs  AuditLog[]
}

// ── Consumer phone-OTP auth (P2, separate realm from Replit Auth) ─────────────
//
// One row per OTP code sent. NOT keyed to ConsumerAccount — the account may
// not exist yet (first-time signup creates it only after a successful
// verify). Looked up by phone_number at verify time. Deliberately has no
// relation to ConsumerAccount/Tenant/User; it is pre-account-creation state.
model ConsumerOtpRequest {
  id            String    @id @default(cuid())
  phone_number  String // E.164, e.g. +17671234567
  code_hash     String // HMAC-SHA256(phone+code, SESSION_SECRET) — code itself is never stored
  expires_at    DateTime
  consumed_at   DateTime?
  attempt_count Int       @default(0)

  created_at DateTime @default(now())

  @@index([phone_number, created_at])
}

// NOTE: Prisma's "User" table (capital U) is separate from Drizzle's "users"
// table (lowercase) used by the Express auth server. PostgreSQL treats them as
// different identifiers when quoted.
model User {
  id                String  @id @default(cuid())
  tenant_id         String
  replit_id         String? @unique // from Replit Auth (OIDC sub); null until user signs in for pre-created accounts
  role              String  @default("owner") // owner | admin
  email             String?
  name              String?
  profile_image_url String?
  intelligence_tier String  @default("standard") // standard | advanced | expert
  agent_took_over   Boolean @default(false) // owner paused the AI
  act_as_tenant_id  String? // admin: currently acting as this tenant
  identity_id       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id])
  identity Identity? @relation(fields: [identity_id], references: [id])
}

// ── Agent configuration ───────────────────────────────────────────────────────

model Agent {
  id                String  @id @default(cuid())
  tenant_id         String
  name              String  @default("Isola Assistant")
  greeting          String  @default("Hello! How can I help you today?")
  business_info     String  @default("")
  knowledge_text    String  @default("")
  intelligence_tier String  @default("standard")
  after_hours_start String? // "HH:MM" 24-h local time
  after_hours_end   String? // "HH:MM" 24-h local time
  away_message      String  @default("") // sent verbatim during after-hours instead of silence
  timezone          String  @default("America/Dominica")
  is_active         Boolean @default(true)
  brain_provider    String  @default("native") // native | flowise | hermes | clawith — which runtime generates replies
  flowise_flow_id   String? // Flowise chatflow id, required when brain_provider="flowise"
  // hermes has no dedicated column: HERMES_AGENT_URL is a single shared env var
  // (not per-tenant), and routing is additionally gated by a hardcoded
  // phone_number_id allowlist in lib/brain-provider.ts — see HERMES_ALLOWED_PHONE_NUMBER_IDS.
  // clawith has no dedicated column either: the per-tenant identity lives in
  // ClawithBinding (below), resolved by tenant_id — same pattern as OdooBinding.

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenant_id], references: [id])
  chatwoot_bindings ChatwootBinding[] @relation("ChatwootBindingAgent")
  clawith_binding   ClawithBinding?   @relation("ClawithBindingAgent")

  @@index([tenant_id])
}

// ── WhatsApp routing table ────────────────────────────────────────────────────

model WhatsAppNumber {
  id              String  @id @default(cuid())
  tenant_id       String
  phone_number_id String  @unique // Meta phone_number_id — the inbound routing key
  waba_id         String // Meta WABA id
  phone_number    String // human-readable e.g. +17678181234
  display_name    String?
  access_token    String // per-WABA long-lived token (leave "" when token_env is set)
  token_env       String? // if set, process.env[token_env] is used instead of access_token
  coex_mode       Boolean @default(true) // true = coexistence (WA Business app kept)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  conversations Conversation[]
}

// ── Chatwoot per-tenant binding ───────────────────────────────────────────────

model ChatwootBinding {
  id         String  @id @default(cuid())
  tenant_id  String
  agent_id   String? // optional: the specific Agent that handles this inbox; null → use tenant's default agent (tenant.agents[0])
  base_url   String // e.g. https://inbox.epic.dm
  account_id String
  token      String // Chatwoot Application API agent token (set to '' for a2 — bot token used instead)
  inbox_id   String? // WhatsApp inbox id in Chatwoot
  mode       String  @default("mirror") // mirror (Wave A: app posts to Chatwoot) | a2 (Chatwoot owns WA channel, app is AI brain)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  agent         Agent?         @relation("ChatwootBindingAgent", fields: [agent_id], references: [id])
  conversations Conversation[]

  // CW00: one Chatwoot door (account + inbox) may carry at most ONE Foundation
  // registration per mode. A ChatwootBinding row is the governed REGISTRATION
  // pointing at a Clawith agent — two of them on one door is not "two agents",
  // it is an ambiguous front door: agent-bot/route.ts resolves the owning
  // tenant with findMany({ inbox_id, mode: 'a2' }), so a duplicate makes
  // tenant/agent/token resolution ambiguous (same failure class as the
  // 2026-07-01 account-5 incident). lib/chatwoot-binding-resolution.ts is the
  // runtime filter; this is the structural fix.
  //
  // inbox_id is nullable and Postgres unique indexes are NULLS DISTINCT, so
  // rows without an inbox (no door) never collide — no existing row is broken,
  // and a partial `WHERE inbox_id IS NOT NULL` index would be exactly
  // equivalent while being inexpressible in Prisma and therefore permanent
  // drift. `mode` is part of the key rather than a `WHERE mode = 'a2'` filter
  // because mode has other values ('mirror'), making this a strictly safer
  // superset key. See migration
  // 20260725210000_chatwoot_binding_account_inbox_mode_unique.
  @@unique([account_id, inbox_id, mode])
  @@index([tenant_id])
}

// ── Odoo / Fiserv / BFF per-tenant bindings (S2 — additive) ──────────────────
// Mirror the WhatsAppNumber/ChatwootBinding shape: one row per tenant,
// resolveConfig() in lib/connector.ts merges these over the platform-default
// env config when present, falling back to the env config when absent (see
// lib/engine-bindings.ts). Secret fields (suffixed _enc) are AES-256-GCM
// envelope-encrypted with TENANT_MASTER_KEY via lib/tenant-secrets.ts — never
// stored in plaintext. Magnus intentionally has no binding table here: its
// per-tenant identity already lives on Tenant.magnus_* / VoiceLine, and its
// connection (baseUrl/apiKey/apiSecret) is genuine shared platform infra.

model OdooBinding {
  id            String  @id @default(cuid())
  tenant_id     String  @unique
  url           String // Odoo base URL, e.g. https://epic-communications-inc.odoo.com
  db            String // Odoo database name
  login         String? // Odoo cloud login email (the human user whose API key is stored below)
  api_key_enc   String // AES-256-GCM envelope-encrypted Odoo API key — see lib/tenant-secrets.ts
  instance_type String? // hosted_saas | local_docker_clone — mirrors Tenant.odoo_instance_type

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model FiservBinding {
  id          String  @id @default(cuid())
  tenant_id   String  @unique
  api_key_enc String // AES-256-GCM envelope-encrypted Fiserv API key
  base_url    String? // optional override; defaults to platform FISERV_BASE_URL when unset

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model BffBinding {
  id                  String @id @default(cuid())
  tenant_id           String @unique
  base_url            String
  internal_secret_enc String // AES-256-GCM envelope-encrypted BFF internal secret

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

// ── Clawith per-tenant binding (S3 — additive) ───────────────────────────────
// Mirrors ChatwootBinding's shape: one row per tenant, resolved by tenant_id
// in the agent-bot route when Agent.brain_provider = 'clawith'. No secret
// fields here — the single CLAWITH_SHARED_SECRET is a platform-level env var
// (same pattern as HERMES_AGENT_URL), not per-tenant; what IS per-tenant is
// which Clawith/Paperclip identity this tenant's conversations dispatch to.
//
// Per-agent override: set agent_id to pin a binding to a specific Agent (e.g.
// EMA sales agent vs front-line agent on the same tenant). When null this is
// the tenant-level fallback binding (current / legacy behaviour).
model ClawithBinding {
  id                   String  @id @default(cuid())
  tenant_id            String
  agent_id             String? @unique // optional: pin to a specific Agent; null → per-tenant fallback
  clawith_agent_id     String // Clawith's own agent id — the `agent_id` field in the dispatch request body
  paperclip_agent_id   String
  paperclip_company_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  agent  Agent? @relation("ClawithBindingAgent", fields: [agent_id], references: [id])

  @@index([tenant_id])
}

// ── Consent (WhatsApp send gate — fail-closed) ────────────────────────────────

model Consent {
  id           String    @id @default(cuid())
  tenant_id    String
  phone        String // E.164 with leading +
  status       String    @default("opted_in") // opted_in | opted_out
  opted_in_at  DateTime  @default(now())
  opted_out_at DateTime?
  source       String    @default("inbound") // inbound | explicit

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, phone])
}

// ── Conversations + messages (local metadata mirror) ─────────────────────────

model Conversation {
  id                       String    @id @default(cuid())
  tenant_id                String
  whatsapp_number_id       String?
  chatwoot_conversation_id Int? // mirrored from Chatwoot (unique per tenant)
  customer_phone           String
  customer_name            String?
  status                   String    @default("open") // open | resolved
  agent_took_over          Boolean   @default(false)
  // COMPATIBILITY PROJECTION, NO LONGER AUTHORITATIVE (Commit 2).
  // Derived from `ownership_state` by lib/ownership/state.ts
  // projectHumanHandling(); written only by the ownership engine
  // (lib/ownership/transitions.ts). Retained because dashboards, counters
  // and every non-authoritative ("legacy regime") door still read it, and
  // because dropping a live boolean in the same commit that replaces it
  // would make the change irreversible. See lib/ownership/authority.ts for
  // which doors the state governs and which still route on this flag.
  human_handling           Boolean   @default(false)
  last_message_at          DateTime?

  // ── Episode-aware conversation ownership (Commit 2) ──────────────────────
  //
  // The authoritative answer to "who owns the response right now", replacing
  // `human_handling` as the sole authority.
  //
  // A boolean cannot express an EPISODE, and without an episode a late or
  // replayed handback for a conversation that has since been escalated again
  // would silently resume an automated brain into a live human conversation.
  // It also cannot express HANDING_BACK (reconciling, nobody speaks), and it
  // cannot distinguish "a human is here" from "Chatwoot's status changed" —
  // which is why resolution used to hand the microphone straight back to the
  // AI with no reconciliation and no record.
  //
  // Values are the OWNERSHIP_STATES vocabulary already declared in
  // lib/clawith/contract.ts, so the wire contract and the store speak one
  // language. Kept as String rather than a Prisma enum deliberately: the
  // vocabulary is shared with an external contract, and a Postgres enum
  // makes every future value a locking DDL migration on a live table.
  ownership_state                   String    @default("AI_OWNED")
  // Increments once per span of human involvement. Identity for exactly-once
  // is tenant + conversation + episode.
  ownership_episode                 Int       @default(0)
  ownership_changed_at              DateTime?
  ownership_reason                  String?
  // Non-secret reference to the operator/agent that caused the transition.
  ownership_actor_ref               String?
  ownership_correlation_id          String?
  // Identity of the escalation / handback operations that own the current
  // episode — the same values claimed in ConversationOwnershipTransition.
  ownership_escalation_operation_id String?
  ownership_handback_operation_id   String?

  // Authoritative snapshot of the exact Chatwoot inbox/binding this
  // conversation lives in, captured from the live webhook's inbox_id (see
  // agent-bot/route.ts) — never re-derived from tenant_id alone. A tenant can
  // own more than one active a2 ChatwootBinding (S4 per-agent routing, e.g.
  // "EMA sales agent vs front-line agent on the same tenant"), so a
  // tenant-wide binding lookup is ambiguous; /api/customer/escalate resolves
  // the Chatwoot account/inbox from chatwoot_binding_id only, and fails
  // closed when it is null (legacy row) or inconsistent.
  chatwoot_inbox_id   String?
  chatwoot_binding_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  whatsapp_number  WhatsAppNumber?  @relation(fields: [whatsapp_number_id], references: [id])
  chatwoot_binding ChatwootBinding? @relation(fields: [chatwoot_binding_id], references: [id])
  messages         Message[]
  escalation_refs  EscalationRef[]

  ownership_transitions ConversationOwnershipTransition[]

  @@unique([tenant_id, chatwoot_conversation_id])
  @@index([tenant_id, status])
  @@index([tenant_id, ownership_state])
  @@index([tenant_id, last_message_at])
  @@index([chatwoot_binding_id])
}

model Message {
  id                  String  @id @default(cuid())
  conversation_id     String
  role                String // user | assistant
  content             String
  wa_message_id       String? @unique // Meta wamid — dedup key for inbound retries / multi-app delivery
  chatwoot_message_id Int?    @unique // Chatwoot message id — dedup key for webhook retries
  tokens_used         Int?

  created_at DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id, created_at])
}

// ── Cross-path inbound dedup (Meta wamid) ─────────────────────────────────────
//
// Global idempotency gate keyed ONLY on Meta's message id, independent of
// any Tenant/Conversation. Exists because Message.wa_message_id and
// Message.chatwoot_message_id are per-PATH dedup keys (direct WA webhook vs
// Chatwoot agent-bot) — a message that arrives via BOTH paths (e.g. an A2
// tenant that also has a stray WhatsAppNumber routing row, or any future
// dual-delivery scenario) claims two DIFFERENT local ids and both paths
// independently pass their own dedup check, producing two AI replies for
// one physical inbound message. This table closes that gap: both
// lib/agent.ts and app/api/chatwoot/agent-bot/route.ts claim the SAME
// Meta wamid here, at the earliest possible point, before any reply or
// side effect. Pattern reused from deepseek /opt/bff-v2
// app/lib/webhook/ingress.ts checkDedup().
model InboundDedup {
  id         String   @id @default(cuid())
  message_id String   @unique // Meta wamid — the ONLY key; global across all tenants/paths
  created_at DateTime @default(now())
}

// ── Wallet + transactions ─────────────────────────────────────────────────────

model Wallet {
  id                  String  @id @default(cuid())
  tenant_id           String? @unique // exactly one of tenant_id / consumer_account_id is set
  consumer_account_id String? @unique
  magnus_user_id      String? // Magnus prepaid user id for balance reads
  balance_cache       Float   @default(0) // refreshed on view from Magnus
  currency            String  @default("EC$")
  identity_id         String? @unique
  balance_minor       Int? // ledger-phase-a: minor-unit mirror of balance_cache, backfilled; reads still use balance_cache

  updated_at DateTime @updatedAt

  tenant           Tenant?          @relation(fields: [tenant_id], references: [id])
  consumer_account ConsumerAccount? @relation(fields: [consumer_account_id], references: [id])
  identity         Identity?        @relation(fields: [identity_id], references: [id])
  txns             WalletTxn[]
}

model WalletTxn {
  id                  String  @id @default(cuid())
  tenant_id           String? // exactly one of tenant_id / consumer_account_id is set
  consumer_account_id String?
  wallet_id           String
  type                String // topup | debit_minutes | debit_tokens | credit_adjust
  amount_usd          Float // positive = credit, negative = debit
  description         String
  ref                 String? // Fiserv ref or internal ref
  identity_id         String?
  amount_minor        Int? // ledger-phase-a: minor-unit mirror of amount_usd, backfilled; reads still use amount_usd
  currency            String? // ledger-phase-a: currency for amount_minor (e.g. "USD"); null on pre-existing rows until backfilled
  idempotency_key     String? @unique // ledger-phase-a: dedup key for future write paths; null on existing rows

  created_at DateTime @default(now())

  tenant           Tenant?          @relation(fields: [tenant_id], references: [id])
  consumer_account ConsumerAccount? @relation(fields: [consumer_account_id], references: [id])
  wallet           Wallet           @relation(fields: [wallet_id], references: [id])
  identity         Identity?        @relation(fields: [identity_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([consumer_account_id, created_at])
}

// ── Usage metering ────────────────────────────────────────────────────────────

model UsageMeter {
  id           String   @id @default(cuid())
  tenant_id    String
  period_start DateTime
  period_end   DateTime
  minutes_used Float    @default(0)
  tokens_used  Int      @default(0)
  minutes_cost Float    @default(0) // USD
  tokens_cost  Float    @default(0) // USD

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, period_start])
}

// ── Subscription ──────────────────────────────────────────────────────────────

model Subscription {
  id        String @id @default(cuid())
  tenant_id String @unique
  plan      String @default("starter") // starter=$39 | growth=$89 | pro=$179
  status    String @default("active")

  started_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

// ── Audit log ─────────────────────────────────────────────────────────────────

// ── Marketing funnel (P6 — public EMA landing page) ─────────────────────────
// Standalone: no FK to ConsumerAccount (a lead is often anonymous — captured
// before signup). If Odoo CRM is reachable, odoo_lead_id records the mirrored
// crm.lead id; this table is always the local source of truth regardless.
model ConsumerLead {
  id           String  @id @default(cuid())
  phone_number String? // filled in only if later correlated to a signup
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  referrer     String?
  landing_path String?
  cta          String? // which CTA was clicked: "signup" | "whatsapp" | "view"
  odoo_lead_id Int? // set only if a real crm.lead was created in Odoo

  created_at DateTime @default(now())

  @@index([created_at])
  @@index([utm_source, utm_campaign])
}

model AuditLog {
  id                  String  @id @default(cuid())
  tenant_id           String? // exactly one of tenant_id / consumer_account_id is set
  consumer_account_id String?
  actor_id            String // User.id, "system", or "agent:<agent_id>" for agent-tool calls
  action              String // e.g. "agent.update", "wallet.topup", "takeover.enable"
  entity              String?
  entity_id           String?
  request_id          String? // idempotency key for agent-tools.invoke calls (dedup on tenant_id+request_id)
  meta                Json    @default("{}")
  identity_id         String?

  created_at DateTime @default(now())

  tenant           Tenant?          @relation(fields: [tenant_id], references: [id])
  consumer_account ConsumerAccount? @relation(fields: [consumer_account_id], references: [id])
  identity         Identity?        @relation(fields: [identity_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, request_id])
  @@index([consumer_account_id, created_at])
}

// ── S6: governance — approval gate (mint → approve → redeem) ────────────────
//
// First gated action: operator voice-routing changes ("voice.route.set").
// Deny-by-default: an operator write is blocked until a pending
// ApprovalRequest for the exact same params is approved by a tenant
// owner/admin (self-approve allowed in v1), then redeemed with its
// single-use `token` before the underlying mutation is attempted. tenant_id
// is required — v1 gating is always tenant-scoped.
model ApprovalRequest {
  id            String    @id @default(cuid())
  tenant_id     String
  token         String    @unique // 256-bit redemption secret; single-use; only ever returned to the authenticated approver
  action        String // v1: "voice.route.set"
  target_entity String? // "voice_line"
  target_id     String? // VoiceLine.id — binds the approval to one line
  payload       Json      @default("{}") // exact approved params: { did, mode, forwardNumber } — binds the token to these params
  status        String    @default("pending") // pending | approved | denied | consumed | expired  (deny-by-default)
  requested_by  String // User.id (or "agent:<id>" in future)
  decided_by    String? // approver User.id
  decided_at    DateTime?
  consumed_at   DateTime? // single-use marker (set atomically on redeem)
  expires_at    DateTime // TTL
  created_at    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
  @@index([expires_at])
}

// ── Escalation reference (opaque per-turn handle for escalate_to_human) ─────
//
// The public Clawith agent (EMA) is never handed a raw conversation/tenant/
// account/inbox id to call escalate_to_human with. Instead, on each turn we
// route through the Isola bridge, Foundation mints a short-lived opaque
// `token` bound server-side to the exact conversation, and hands ONLY that
// token to the agent (via the bridge's per-turn runtime instruction — the
// same channel already used to hand the agent the caller's verified phone
// number). /api/customer/escalate resolves ownership from this token alone.
// Scoped capability, not an independent agent credential
// (def-clawith-escalation-shared-token-no-agent-principal-2026-07-21): every
// field below is bound at mint time and re-checked fail-closed at resolve
// time in /api/customer/escalate, but possession of a valid token only
// proves the bearer was handed this exact reference for this exact turn —
// it does not independently prove which Clawith execution is presenting it,
// since mcp-isola-customer-tools still authenticates with one shared
// bearer token for every tenant/agent.
model EscalationRef {
  id                  String   @id @default(cuid())
  purpose             String   @default("escalate_to_human") // bound intent — this ref is unusable for any other endpoint/action
  tenant_id           String
  conversation_id     String
  clawith_agent_id    String // ClawithBinding.clawith_agent_id snapshotted at mint time — re-checked against the conversation's CURRENT binding on resolve so a stale/rebound agent fails closed
  chatwoot_binding_id String // Conversation.chatwoot_binding_id snapshotted at mint time — must still match on resolve
  chatwoot_inbox_id   String? // Conversation.chatwoot_inbox_id snapshotted at mint time — must still match on resolve when both are present
  correlation_id      String   @unique // non-secret per-turn trace id forwarded to the bridge/logs; never the capability itself
  token               String   @unique // 256-bit opaque capability; minted fresh per turn
  expires_at          DateTime // short TTL — long enough for one agent turn, not for reuse across a conversation's lifetime
  created_at          DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  conversation Conversation @relation(fields: [conversation_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([expires_at])
}

// ── S6 Phase 2: notification outbox (durable, idempotent, consent-checked outbound sends) ──
//
// v1 = one channel (WhatsApp) + one producer (voicemail-catch owner alert),
// flag-gated. Replaces deliverCatch()'s direct fire-and-forget send in
// lib/voicemail-poller.ts with an enqueue (lib/notify.ts) + drain
// (lib/notify-drain.ts) pair so a failed send retries with backoff instead
// of being lost, and a duplicate enqueue is a no-op instead of a double-send.
model NotificationOutbox {
  id              String    @id @default(cuid())
  tenant_id       String
  contact         String // destination (E.164 / handle)
  channel         String // v1: "whatsapp"
  consent_basis   String // "owner_self_notification" (v1) | future: customer_* bases that require a Consent opt-in
  template        String
  payload         Json      @default("{}")
  dedupe_key      String // idempotency; unique per tenant
  state           String    @default("pending") // pending | sending | sent | failed | dead_letter
  attempt_count   Int       @default(0)
  max_attempts    Int       @default(5)
  next_attempt_at DateTime? // retry backoff; drain picks up when <= now
  external_ref    String? // provider message id once sent — the Meta wamid; the ONLY join key back from a wa-status callback
  failure_reason  String?
  sent_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // ── Wave 1 (spine/wave1-internal-operations): delivery truth + work correlation ──
  //
  // All additive and nullable, and deliberately NOT back-filled. Rows written
  // before these columns existed have an unknown provider outcome and an
  // unknown work correlation; inventing either would fabricate history — the
  // same constraint that keeps OPS-000015/53/54/55 untouched in BFF.
  //
  // WHY provider_status IS SEPARATE FROM `state`: `state` is the OUTBOX's own
  // lifecycle (did we manage to hand this to Meta). provider_status is what
  // Meta later said actually happened. Collapsing them is exactly the mistake
  // that let `sent` be read as "the staff member has it" for three weeks —
  // see FINDINGS-wa-status-join-key-and-guard-blindspot-2026-07-27.
  // `accepted` = Graph 200 + a wamid, nothing more. Only `delivered` and
  // `failed` are outcomes.
  provider_status       String? // accepted | sent | delivered | read | failed
  provider_error_code   String? // Meta error code, e.g. "131047" (Re-engagement message)
  provider_error_detail String?
  delivered_at          DateTime?
  failed_at             DateTime? // when the failure was ESTABLISHED — not created_at; a
  // callback can fail a send minutes after the row was written.

  // Odoo-only WorkRef correlation (dec-wave1-workref-odoo-only-2026-07-28).
  // These are an Odoo model/id and Foundation's own correlation id. There is
  // deliberately no EpicWorkItem id, no OPS- reference and no BFF linkage here.
  work_ref_model String? // project.task | mail.activity | helpdesk.ticket
  work_ref_id    Int?
  correlation_id String?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, dedupe_key])
  @@index([state, next_attempt_at])
  @@index([tenant_id, created_at])
  @@index([external_ref])
  @@index([correlation_id])
}

// ── Drizzle-managed auth tables (DO NOT DROP) ────────────────────────────────
//
// These two tables are owned by the Express API server (Replit OIDC /
// connect-pg-simple). They are declared here with @@ignore so that
// `prisma db push` and `prisma migrate` are aware of them and will never
// treat them as "unknown" tables to remove.
//
// IMPORTANT: never run `prisma db push --force-reset` or accept a
// "reset the database" prompt — doing so drops ALL tables including these.
// Use `prisma migrate dev` for schema changes in development, and
// `prisma migrate deploy` in production.
//
// If the tables are ever accidentally dropped, recreate them with:
//   CREATE TABLE "users" (id varchar PK DEFAULT gen_random_uuid(), email varchar UNIQUE,
//     first_name varchar, last_name varchar, profile_image_url varchar,
//     created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now());
//   CREATE TABLE "sessions" (sid varchar PK, sess jsonb NOT NULL, expire timestamp NOT NULL);
//   CREATE INDEX "IDX_session_expire" ON "sessions" ("expire");

/// Drizzle-managed Replit Auth user table. Prisma will not modify or drop it.
model DrizzleUser {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  email             String?  @unique
  first_name        String?
  last_name         String?
  profile_image_url String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@map("users")
  @@ignore
}

/// Drizzle-managed connect-pg-simple session store. Prisma will not modify or drop it.
model DrizzleSession {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("sessions")
  @@ignore
}

// ── Unify Identity — Phase A (additive; nothing reads these yet) ─────────────

model Identity {
  id           String  @id @default(cuid())
  phone        String? @unique // E.164 — the resolve-by-phone anchor. Nullable:
  // some Identities (e.g. B2B owners with no phone on file) can only be
  // anchored by replit_id — see resolveUserIdentity() in
  // scripts/backfill-identity-phase-b.ts. Unique index still enforced;
  // Postgres allows multiple NULLs under a unique index.
  display_name String?
  replit_id    String? @unique // OIDC link, nullable

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships    Membership[]
  voice_lines    VoiceLine[]
  wallets        Wallet[]
  wallet_txns    WalletTxn[]
  audit_logs     AuditLog[]
  users          User[]
  staff_bindings StaffBinding[]
}

model Membership {
  id          String @id @default(cuid())
  identity_id String
  tenant_id   String
  role        String @default("owner") // owner | admin | staff

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  identity Identity @relation(fields: [identity_id], references: [id])
  tenant   Tenant   @relation(fields: [tenant_id], references: [id])

  @@unique([identity_id, tenant_id])
  @@index([tenant_id])
}

model VoiceLine {
  id                       String  @id @default(cuid())
  owner_kind               String // 'consumer' | 'business'
  identity_id              String?
  tenant_id                String?
  magnus_user_id           String?
  magnus_sip_id            String?
  magnus_sip_username      String?
  magnus_sip_password      String?
  magnus_callerid_id       String?
  magnus_did_id            String?
  magnus_did_number        String?
  magnus_diddestination_id String?
  voice_forward_to_cell    Boolean @default(false)
  voice_cell_number        String?
  provisioning_state       String  @default("none") // none | pending | completed | failed | retired (soft-decommissioned — sub-resource ids nulled, magnus_user_id/magnus_did_number kept for the record; see Voice Health's RETIRED status)
  provisioning_error       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  identity Identity? @relation(fields: [identity_id], references: [id])
  tenant   Tenant?   @relation(fields: [tenant_id], references: [id])

  @@index([identity_id])
  @@index([tenant_id])
}

// ═══════════════════════════════════════════════════════════════════════════
// Wave 1 — internal staff operations (spine/wave1-internal-operations)
//
// AUTHORITY: dec-bff-freeze-spine-consolidation-execution-2026-07-28 and
// dec-wave1-workref-odoo-only-2026-07-28.
//
// READ THIS BEFORE ADDING A COLUMN HERE. Neither model below is a task. Odoo
// is the task system of record. StaffBinding answers "who is this person and
// may they act", StaffWorkAction answers "did we already apply this exact
// request" — that is all. The moment either grows a title, a due date, a
// state machine or an assignee-of-record, Foundation has quietly acquired a
// second task authority, which is the precise thing the consolidation
// programme exists to remove. There is deliberately no EpicWorkItem id, no
// `OPS-` reference, no mirror table and no BFF database dependency anywhere
// in this section.
// ═══════════════════════════════════════════════════════════════════════════

/// Who a staff member is, across Foundation, Odoo and their approved channel.
///
/// NAMING, DELIBERATELY: `odoo_res_user_id` — NOT `odooUserOrEmployeeId`. The
/// legacy column's ambiguous name caused three live rows to be seeded with
/// hr.employee ids in a field consumed as a res.users id, so Phillip's ACK
/// would have read back against Eric's user and Kimberly's against an inactive
/// system account (ev-staff-inbound-ack-routing-2026-07-27 §4). The two ids are
/// separate columns here and the res.users one says so in its name.
model StaffBinding {
  id        String @id @default(cuid())
  tenant_id String

  /// Foundation identity, when the person has one. Nullable: a staff member is
  /// bound and can be dispatched to before they have ever signed in.
  identity_id String?

  /// THE join key. project.task.user_ids holds res.users ids, so this is what
  /// every task read and every assignment check uses.
  odoo_res_user_id Int

  /// hr.employee id, for roster/HR reads only. Never used as an assignment key.
  odoo_employee_id Int?

  display_name String
  work_email   String?

  /// Manager, as a res.users id in the same Odoo. Nullable — not everyone has
  /// one, and inventing one would be worse than leaving it unset.
  manager_odoo_res_user_id Int?

  /// Approved communication identities. `wa_id` is Meta's form: E.164 digits,
  /// no leading '+'. Unique per tenant so one number cannot be two people.
  wa_id       String?
  telegram_id String?

  role   String  @default("staff") // staff | manager | owner
  active Boolean @default(true)

  /// Set when the person has explicitly acknowledged onboarding on their own
  /// channel. No ACK means not activated — an unverified binding may be read
  /// but must not be treated as a proven delivery target.
  verified_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id])
  identity Identity? @relation(fields: [identity_id], references: [id])

  work_actions StaffWorkAction[]

  @@unique([tenant_id, odoo_res_user_id])
  @@unique([tenant_id, wa_id])
  @@index([tenant_id])
  @@index([wa_id])
}

/// A staff action that was requested against an authoritative Odoo record, and
/// whether it was applied. This is an idempotency and audit ledger, not work
/// state: it records the REQUEST and the Odoo RESULT, and stores nothing that
/// could be mistaken for the task itself.
model StaffWorkAction {
  id               String @id @default(cuid())
  tenant_id        String
  staff_binding_id String

  /// Odoo-only WorkRef. `work_ref_model` is constrained by application code to
  /// project.task | mail.activity | helpdesk.ticket.
  work_ref_model String
  work_ref_id    Int
  correlation_id String

  action      String // ack | update | blocked | done | help | correct
  note        String?
  source      String  @default("whatsapp")
  actor_wa_id String?

  /// Idempotency. Primary discriminator is the provider message id, so a Meta
  /// webhook retry collapses to one action while two genuinely different
  /// UPDATEs on the same task both land.
  idempotency_key String

  /// Null until Odoo has actually accepted the write. A row with applied_at
  /// null is a request we did NOT complete — it must never be read as done.
  applied_at     DateTime?
  odoo_result    Json?
  failure_reason String?

  created_at DateTime @default(now())

  tenant        Tenant       @relation(fields: [tenant_id], references: [id])
  staff_binding StaffBinding @relation(fields: [staff_binding_id], references: [id])

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, work_ref_model, work_ref_id])
  @@index([correlation_id])
  @@index([staff_binding_id])
}

/// The conversation-ownership transition ledger — and the exactly-once claim
/// substrate for every change of response authority.
///
/// Two jobs in one table, deliberately:
///
///   1. CLAIM. `@@unique([tenant_id, conversation_id, operation_id])` is what
///      makes escalation, assignment, handoff and handback exactly-once. A
///      replayed Chatwoot webhook, a retried MCP tool call and a
///      double-clicked dashboard button all present the same operation id, so
///      the second attempt loses the insert and performs no side effect. Same
///      shape as StaffWorkAction's idempotency key — a proven pattern here,
///      not a new one.
///
///   2. AUDIT. Every transition records where the conversation came from,
///      where it went, which episode it belonged to, why, who caused it and
///      under which correlation id. Ownership questions after the fact
///      ("could the AI have replied here?") are answerable from rows rather
///      than from logs.
///
/// This is NOT a second conversation-state platform: the CURRENT state lives
/// on Conversation and is read from there on every hot path. This table is
/// the append-only history of how it got there.
model ConversationOwnershipTransition {
  id              String @id @default(cuid())
  tenant_id       String
  conversation_id String

  /// The episode this transition belongs to. Stale-handback rejection compares
  /// against Conversation.ownership_episode.
  episode    Int
  from_state String
  to_state   String
  reason     String

  /// Caller-supplied operation identity. THE claim key. For the governed
  /// escalate_to_human endpoint this is the scoped ref's own correlation id;
  /// for a human dashboard reply it is Chatwoot's message id; for a handback
  /// it is the operation id the authorized caller supplied.
  operation_id   String
  operation_kind String

  /// Non-secret reference to the authoritative operator/agent, e.g. `user:<id>`.
  actor_ref      String?
  correlation_id String?

  created_at DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  conversation Conversation @relation(fields: [conversation_id], references: [id])

  // Explicit map: Prisma's default name for this compound unique exceeds
  // Postgres's 63-character identifier limit and would be truncated, drifting
  // from the hand-written migration.
  @@unique([tenant_id, conversation_id, operation_id], map: "ConversationOwnershipTransition_tenant_conv_op_key")
  @@index([conversation_id, episode])
  @@index([tenant_id, created_at])
  @@index([correlation_id])
}

// ── Governed customer-tool operations — the exactly-once ledger ──────────────
//
// One row per AUTHORISED tool execution. Every governed customer tool (lead
// create, lead update, follow-up, business note) claims here BEFORE it touches
// Odoo, and records its verified readback here after.
//
// WHY IT IS FOUNDATION-SIDE AND NOT AN ODOO LOOKUP
//   The obvious cheaper design is "before creating, search Odoo for one that
//   looks the same". That is a heuristic, and it breaks in exactly the case
//   that matters: two near-simultaneous retries of the same turn both search,
//   both find nothing, and both create. It also cannot survive the record
//   being completed, archived or unlinked afterwards — an Odoo activity that
//   has been marked done is gone from the searchable set, so a retry would
//   cheerfully create a second one. This ledger is durable and independent of
//   the Odoo records later lifecycle, which is the whole point.
//
// WHY THE REQUEST HASH IS NOT DECORATION
//   `operation_id` alone cannot be trusted for reuse: Clawith supplies an
//   idempotency HINT, and a model that reuses a hint for genuinely different
//   arguments must be REFUSED, not silently served the earlier result. Storing
//   the hash of the authorised arguments is what makes that refusal possible.
//   Foundation derives the final operation_id itself; the hint is an input to
//   that derivation, never the identity.
model CustomerToolOperation {
  id        String @id @default(cuid())
  tenant_id String

  /// Foundation-derived, stable across retries of the same authorised turn.
  /// NEVER the raw hint Clawith supplied.
  operation_id String

  /// Governed tool name, e.g. `crm.lead.create`.
  tool_name String

  /// Hash of the AUTHORISED arguments. A second claim on the same
  /// operation_id with a different hash is a conflict, not a retry.
  request_hash String

  conversation_id  String
  correlation_id   String
  agent_session_id String?

  /// claimed | succeeded | failed
  state String @default("claimed")

  /// The authoritative Odoo record this operation produced or affected.
  /// Recorded ONLY after a successful readback — never from a create response
  /// alone, because an id echoed back is not proof of what was stored.
  result_model String?
  result_id    Int?

  /// The verified readback, returned verbatim on a retry so a repeat never
  /// re-executes and never invents a fresh answer.
  result Json?

  failure_code   String?
  failure_detail String?

  claimed_at   DateTime  @default(now())
  completed_at DateTime?
  updated_at   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, operation_id])
  @@index([tenant_id, tool_name])
  @@index([conversation_id])
  @@index([correlation_id])
}
