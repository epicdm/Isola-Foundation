# Foundation voice-routing (S5) configuration.
# See lib/voice-routing.ts / lib/voice-routing-connector.ts for the full
# routing-mutation flow this feeds into.

# LAW: DATABASE_URL in a working checkout must point at a local/dev database,
# never at Neon prod. Neon is written ONLY by `prisma migrate deploy` at
# republish (see the start:prod script). `db:push` and `migrate:dev` are
# guarded (../../scripts/src/guard-not-prod-db.ts) and refuse to run against the Neon
# prod host, but the underlying law is: never point this checkout's default
# DATABASE_URL at prod. Prod is reachable only via the separate,
# never-auto-sourced DATABASE_URL_PROD, used solely for `migrate deploy`.
#
# For a local dev DB (outside Replit, where the internal `helium` host isn't
# reachable): run a local Postgres, e.g. via Docker —
#   docker run -d --name isola-dev-postgres -e POSTGRES_USER=isola \
#     -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=isola_dev -p 5432:5432 postgres:16
# then `prisma migrate deploy` against it to baseline all migrations.
# DATABASE_URL="postgresql://isola:devpassword@localhost:5432/isola_dev?sslmode=disable"
# DATABASE_URL_PROD="postgresql://user:password@prod-host.example/neondb?sslmode=require"

# Deployment-wide fallback ring timeout, in whole seconds, for the `app` and
# `app_then_cell` voice routing modes.
#
# - Accepted range: an integer greater than 1 and no more than 300.
# - When a DID already has a valid, non-sentinel dial_timeout configured in
#   Magnus, that existing value is preserved as-is and this setting is not
#   consulted for that DID.
# - This setting is only required when a DID is being moved off the `cell`
#   sentinel dial_timeout (the literal value `1`) into `app`/`app_then_cell`
#   and does not already have a valid existing timeout. Demo Diner must have
#   either a valid existing timeout or this variable configured before an
#   app/app_then_cell route change will be accepted for it.
# - If this is required and unset (or set to an out-of-range value), the
#   routing service fails closed — it refuses the mutation before making any
#   write against Magnus, rather than guessing a timeout.
#
# Do not set this to a real production value in this example file.
# VOICE_ROUTING_RING_TIMEOUT_SECONDS=20
