{
  "$schema": "isola-foh-analytics-1.0",
  "note": "27-event conversion funnel contract. Every event preserves: session, identity(where known), offer, service, assistant, source, campaign, cta, funnelStage, timestamp, humanOwner, correlationId.",
  "identityBehavior": "anonymousId until account_created; then merge to customerId keeping anonymousId alias.",
  "consentBehavior": "no PII in properties until consent=true; pre-consent events keep anonymousId + non-PII context only.",
  "correlation": "correlationId flows from createIntent through go_live; idempotencyKey de-dupes cta_click/intent_created.",
  "commonProperties": ["session","identity","offer","service","assistant","source","campaign","cta","funnelStage","timestamp","humanOwner","correlationId"],
  "events": [
    {"name":"page_view","stage":"Acquire","trigger":"route render","required":["route"],"optional":["referrer"],"producer":"web","destination":"analytics-sink","test":"fires once per route with route path"},
    {"name":"offer_view","stage":"Acquire","trigger":"product/offer page render","required":["offer"],"optional":["readiness","price"],"producer":"web","destination":"analytics-sink","test":"offer present + matches catalogue id"},
    {"name":"pricing_view","stage":"Acquire","trigger":"/pricing render","required":[],"optional":["category"],"producer":"web","destination":"analytics-sink","test":"fires on pricing route"},
    {"name":"compare_view","stage":"Acquire","trigger":"/compare render","required":[],"optional":[],"producer":"web","destination":"analytics-sink","test":"fires on compare route"},
    {"name":"cta_click","stage":"Acquire","trigger":"any CTA click","required":["cta"],"optional":["offer","service","assistant"],"producer":"web","destination":"analytics-sink","test":"cta matches CTA_REGISTRY id"},
    {"name":"intent_created","stage":"Convert","trigger":"createIntent success","required":["cta","customerType"],"optional":["service","assistant"],"producer":"adapter","destination":"crm+analytics","test":"intentId present; duplicate suppressed"},
    {"name":"qualification_started","stage":"Convert","trigger":"qualify called","required":["intentId"],"optional":[],"producer":"adapter","destination":"analytics-sink","test":"intentId present"},
    {"name":"qualification_completed","stage":"Convert","trigger":"qualify success","required":["intentId","recommendedOffer"],"optional":["needs"],"producer":"adapter","destination":"crm+analytics","test":"recommendedOffer in catalogue"},
    {"name":"recommendation_shown","stage":"Convert","trigger":"recommend success","required":["offer"],"optional":["addons","alternatives"],"producer":"adapter","destination":"analytics-sink","test":"offer present"},
    {"name":"demo_requested","stage":"Convert","trigger":"demo CTA / requestProposal(demo)","required":["intentId"],"optional":["slot"],"producer":"web","destination":"crm","test":"intentId present"},
    {"name":"proposal_requested","stage":"Convert","trigger":"requestProposal","required":["intentId"],"optional":["offer"],"producer":"adapter","destination":"crm","test":"assisted status"},
    {"name":"proposal_sent","stage":"Convert","trigger":"human sends proposal","required":["proposalId"],"optional":["value"],"producer":"sales","destination":"crm","test":"proposalId present"},
    {"name":"commitment_started","stage":"Convert","trigger":"commitmentStatus started","required":["proposalId"],"optional":[],"producer":"adapter","destination":"crm","test":"state=awaiting_customer"},
    {"name":"commitment_confirmed","stage":"Convert","trigger":"commitmentStatus confirmed","required":["proposalId"],"optional":[],"producer":"adapter","destination":"crm","test":"state=confirmed"},
    {"name":"payment_pending","stage":"Convert","trigger":"paymentStatus pending","required":["commitmentId"],"optional":[],"producer":"adapter","destination":"finance","test":"status=pending; no money-taken copy shown"},
    {"name":"payment_confirmed","stage":"Convert","trigger":"paymentStatus success","required":["commitmentId"],"optional":["method","authority"],"producer":"adapter","destination":"finance","test":"authority = EPIC · Isola/Odoo; method placeholder"},
    {"name":"onboarding_started","stage":"Onboard","trigger":"onboarding entered/resumed","required":["customerId"],"optional":["resume"],"producer":"web","destination":"analytics-sink","test":"customerId present"},
    {"name":"provisioning_started","stage":"Onboard","trigger":"activateService pending","required":["workspaceId","service"],"optional":["authority"],"producer":"adapter","destination":"ops","test":"authority mentions Magnus"},
    {"name":"provisioning_completed","stage":"Onboard","trigger":"provisioningStatus complete","required":["workspaceId"],"optional":["partial","remaining"],"producer":"adapter","destination":"ops","test":"complete=true OR partial=true+remaining[]"},
    {"name":"first_use","stage":"Operate","trigger":"firstUseStatus","required":["workspaceId"],"optional":[],"producer":"adapter","destination":"analytics-sink","test":"firstUse=true"},
    {"name":"acceptance_started","stage":"Operate","trigger":"acceptance begun","required":["workspaceId"],"optional":[],"producer":"web","destination":"ops","test":"stage=acceptance_started"},
    {"name":"acceptance_passed","stage":"Operate","trigger":"acceptance success","required":["workspaceId"],"optional":[],"producer":"adapter","destination":"ops","test":"stage=acceptance_passed"},
    {"name":"go_live","stage":"Operate","trigger":"service live","required":["customerId","service"],"optional":[],"producer":"ops","destination":"crm+analytics","test":"service in catalogue"},
    {"name":"support_requested","stage":"Support","trigger":"supportRequest","required":["customerId"],"optional":["ticket"],"producer":"adapter","destination":"chatwoot","test":"channel=chatwoot"},
    {"name":"stabilization_completed","stage":"Support","trigger":"7-day window closed","required":["customerId"],"optional":[],"producer":"ops","destination":"crm","test":"customerId present"},
    {"name":"lead_lost","stage":"Any","trigger":"lead marked lost","required":["intentId","reason"],"optional":[],"producer":"sales","destination":"crm","test":"reason present"},
    {"name":"lead_reactivated","stage":"Any","trigger":"reactivation success","required":["intentId"],"optional":["campaign"],"producer":"sales","destination":"crm","test":"intentId present"}
  ]
}
