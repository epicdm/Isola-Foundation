modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
ignoreDatabaseMigrations = true

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

# Run / Preview. `runButton` previously named a workflow that was never defined,
# and no port was mapped, so Run produced nothing routable. This defines it.
# Launch configuration only — no application behaviour is changed here.
[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "isola"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/isola/scripts/run-replit-preview.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ADMIN_REPLIT_IDS = "48094983"
NEXT_PUBLIC_META_APP_ID = "1293246411364782"
CHATWOOT_ACCOUNT_ID = "5"
CHATWOOT_URL = "https://inbox.epic.dm"
FISERV_CHARGE_ENABLED = "false"
LITE_DOMINICA_RATE_EC_PER_MIN = "0.27"
LITE_ID_PLAN = "52"
LITE_NBD_ACCOUNT = "115004377"
LITE_QR_BASE_URL = "https://bff.epic.dm"
MAGNUS_URL = "https://voice00.epic.dm/mbilling"
META_APP_ID = "1293246411364782"
META_PHONE_ID = "1003873729481088"
META_WABA_ID = "281225988404808"
ODOO_DB = "epic-communications-inc"
