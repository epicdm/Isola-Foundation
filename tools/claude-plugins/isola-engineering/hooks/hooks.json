{
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/isola-guard.js"],
          "timeout": 20
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/isola-post-edit.js"],
          "timeout": 180
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/isola-stop-gate.js"],
          "timeout": 20
        }
      ]
    }
  ]
}
