auto-install-peers=false
strict-peer-dependencies=false

# pnpm <11 does not read `pmOnFail`/`managePackageManagerVersions` from
# pnpm-workspace.yaml when the *invoking* (bootstrap) pnpm predates ~10.15 --
# confirmed empirically down to pnpm 10.0.0, which ignores the workspace-yaml
# form of this setting but does honor the .npmrc form below. This closes the
# gap left by pnpm-workspace.yaml's `pmOnFail: ignore` (which pnpm 11+ reads,
# but early pnpm 10.x does not) for an unknown Replit bootstrap pnpm version.
# See pnpm-workspace.yaml for the full rationale; does not touch the pin.
manage-package-manager-versions=false
